<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.effect.DropShadow?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.SystemHealthController">

    <top>
        <VBox>
            <fx:include source="MenuBarComponent.fxml"/>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true" style="-fx-background-color: #F8F9FA;">
            <VBox spacing="20" style="-fx-padding: 20; -fx-background-color: #F8F9FA;">

                <Label text="System Health Dashboard" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <Label text="Real-time system monitoring and health metrics (Admin Only)" style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;"/>

                <Separator style="-fx-background-color: #dddddd;"/>

                <ProgressIndicator fx:id="loadProgress" visible="false" maxWidth="40" style="-fx-padding: 5;"/>

                <!-- Stats Cards Row - Single horizontal row with all 6 cards -->
                <HBox spacing="15" alignment="CENTER" style="-fx-padding: 5 0 15 0;">
                    <!-- Card 1: Total Users - Primary Color (Dark Green) -->
                    <VBox spacing="8" style="-fx-background-color: rgba(255,255,255,0.97); -fx-padding: 20 15; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-color: #006400; -fx-border-width: 0 0 0 5; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, 0, 2);" HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308">
                        <Label text="Total Users" style="-fx-text-fill: #006400; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                        <Label fx:id="totalUsersLabel" style="-fx-text-fill: #2c3e50; -fx-font-size: 32px; -fx-font-weight: bold;"/>
                        <Label text="Registered Users" style="-fx-text-fill: #7f8c8d; -fx-font-size: 11px;"/>
                    </VBox>

                    <!-- Card 2: Active Users - Success Color (Emerald Green) -->
                    <VBox spacing="8" style="-fx-background-color: rgba(255,255,255,0.97); -fx-padding: 20 15; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-color: #27ae60; -fx-border-width: 0 0 0 5; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, 0, 2);" HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308">
                        <Label text="Active Users" style="-fx-text-fill: #27ae60; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                        <Label fx:id="activeUsersLabel" style="-fx-text-fill: #2c3e50; -fx-font-size: 32px; -fx-font-weight: bold;"/>
                        <Label text="Currently Active" style="-fx-text-fill: #7f8c8d; -fx-font-size: 11px;"/>
                    </VBox>

                    <!-- Card 3: Inactive Users - Secondary Color (Dark Slate Blue) -->
                    <VBox spacing="8" style="-fx-background-color: rgba(255,255,255,0.97); -fx-padding: 20 15; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-color: #2c3e50; -fx-border-width: 0 0 0 5; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, 0, 2);" HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308">
                        <Label text="Inactive Users" style="-fx-text-fill: #2c3e50; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                        <Label fx:id="inactiveUsersLabel" style="-fx-text-fill: #2c3e50; -fx-font-size: 32px; -fx-font-weight: bold;"/>
                        <Label text="Inactive Accounts" style="-fx-text-fill: #7f8c8d; -fx-font-size: 11px;"/>
                    </VBox>
                </HBox>

                <HBox spacing="15" alignment="CENTER" style="-fx-padding: 0 0 15 0;">
                    <!-- Card 4: Total Vehicles - Primary Dark (Deep Green) -->
                    <VBox spacing="8" style="-fx-background-color: rgba(255,255,255,0.97); -fx-padding: 20 15; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-color: #004d00; -fx-border-width: 0 0 0 5; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, 0, 2);" HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308">
                        <Label text="Total Vehicles" style="-fx-text-fill: #004d00; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                        <Label fx:id="totalVehiclesLabel" style="-fx-text-fill: #2c3e50; -fx-font-size: 32px; -fx-font-weight: bold;"/>
                        <Label text="Registered Vehicles" style="-fx-text-fill: #7f8c8d; -fx-font-size: 11px;"/>
                    </VBox>

                    <!-- Card 5: Stolen Vehicles - Accent/Police Red -->
                    <VBox spacing="8" style="-fx-background-color: rgba(255,255,255,0.97); -fx-padding: 20 15; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-color: #E31E2C; -fx-border-width: 0 0 0 5; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, 0, 2);" HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308">
                        <Label text="Stolen Vehicles" style="-fx-text-fill: #E31E2C; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                        <Label fx:id="stolenVehiclesLabel" style="-fx-text-fill: #2c3e50; -fx-font-size: 32px; -fx-font-weight: bold;"/>
                        <Label text="Reported Stolen" style="-fx-text-fill: #7f8c8d; -fx-font-size: 11px;"/>
                    </VBox>

                    <!-- Card 6: Unpaid Fines - Warning Color (Amber) -->
                    <VBox spacing="8" style="-fx-background-color: rgba(255,255,255,0.97); -fx-padding: 20 15; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-color: #f1c40f; -fx-border-width: 0 0 0 5; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, 0, 2);" HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308">
                        <Label text="Unpaid Fines" style="-fx-text-fill: #f1c40f; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                        <Label fx:id="unpaidFinesLabel" style="-fx-text-fill: #2c3e50; -fx-font-size: 32px; -fx-font-weight: bold;"/>
                        <Label text="Total Outstanding" style="-fx-text-fill: #7f8c8d; -fx-font-size: 11px;"/>
                    </VBox>
                </HBox>

                <Separator style="-fx-background-color: #dddddd;"/>

                <!-- Monthly Vehicle Registrations Section -->
                <Label text="Monthly Vehicle Registrations" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <VBox style="-fx-background-color: rgba(255,255,255,0.97); -fx-padding: 15; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-color: #dddddd; -fx-border-width: 1; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 5, 0, 0, 2);">
                    <BarChart fx:id="monthlyRegistrationsChart" prefHeight="350" prefWidth="700" legendVisible="true" alternativeRowFillVisible="false" horizontalGridLinesVisible="true" verticalGridLinesVisible="false">
                        <xAxis><CategoryAxis label="Month" style="-fx-tick-label-fill: #2c3e50;"/></xAxis>
                        <yAxis><NumberAxis label="Count" style="-fx-tick-label-fill: #2c3e50;"/></yAxis>
                    </BarChart>
                </VBox>

                <Separator style="-fx-background-color: #dddddd;"/>

                <!-- Vehicle Status Distribution Section -->
                <Label text="Vehicle Status Distribution" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <VBox style="-fx-background-color: rgba(255,255,255,0.97); -fx-padding: 15; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-color: #dddddd; -fx-border-width: 1; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 5, 0, 0, 2);">
                    <PieChart fx:id="vehicleStatusPieChart" prefHeight="300" prefWidth="500" labelsVisible="true" legendVisible="true"/>
                </VBox>

                <Separator style="-fx-background-color: #dddddd;"/>

                <!-- Real-time Metrics Section -->
                <Label text="Real-time Metrics" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

                <VBox spacing="5" style="-fx-background-color: rgba(255,255,255,0.97); -fx-padding: 15; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-color: #dddddd; -fx-border-width: 1;">
                    <Label text="System Load" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                    <ProgressBar fx:id="systemLoadProgress" prefWidth="Infinity" progress="0" style="-fx-padding: 5; -fx-accent: #006400; -fx-background-color: #F8F9FA; -fx-border-color: #dddddd; -fx-border-radius: 5;"/>
                </VBox>

                <GridPane hgap="20" vgap="10" style="-fx-background-color: rgba(255,255,255,0.97); -fx-padding: 15; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-color: #dddddd; -fx-border-width: 1; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 5, 0, 0, 2);">
                    <Label text="Database Status:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                    <Label fx:id="databaseStatusLabel" GridPane.rowIndex="0" GridPane.columnIndex="1" style="-fx-text-fill: #27ae60; -fx-font-weight: bold;"/>

                    <Label text="Pending Queries:" GridPane.rowIndex="0" GridPane.columnIndex="2" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                    <Label fx:id="pendingQueriesLabel" GridPane.rowIndex="0" GridPane.columnIndex="3" style="-fx-text-fill: #2c3e50;"/>

                    <Label text="Pending Workshops:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                    <Label fx:id="pendingWorkshopsLabel" GridPane.rowIndex="1" GridPane.columnIndex="1" style="-fx-text-fill: #2c3e50;"/>

                    <Label text="Pending Claims:" GridPane.rowIndex="1" GridPane.columnIndex="2" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                    <Label fx:id="pendingClaimsLabel" GridPane.rowIndex="1" GridPane.columnIndex="3" style="-fx-text-fill: #2c3e50;"/>

                    <Label text="Last Updated:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                    <Label fx:id="lastUpdatedLabel" GridPane.rowIndex="2" GridPane.columnIndex="1" style="-fx-text-fill: #7f8c8d;"/>
                </GridPane>

                <HBox spacing="15" alignment="CENTER">
                    <Button fx:id="refreshButton" text="Refresh Data" style="-fx-background-color: #006400; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-pref-width: 120; -fx-padding: 8 15; -fx-border-radius: 5; -fx-background-radius: 5;">
                        <effect>
                            <DropShadow radius="3" color="rgba(0,0,0,0.2)"/>
                        </effect>
                    </Button>
                    <Button fx:id="fadeButton" text="Animate" style="-fx-background-color: #f1c40f; -fx-text-fill: #2c3e50; -fx-font-weight: bold; -fx-cursor: hand; -fx-pref-width: 100; -fx-padding: 8 15; -fx-border-radius: 5; -fx-background-radius: 5;"/>
                    <Button fx:id="backButton" text="Back to Dashboard" style="-fx-background-color: #2c3e50; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-pref-width: 150; -fx-padding: 8 15; -fx-border-radius: 5; -fx-background-radius: 5;"/>
                </HBox>

                <Label fx:id="statusLabel" style="-fx-text-fill: #7f8c8d; -fx-font-style: italic; -fx-padding: 5 0 10 0;"/>

            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <fx:include source="FooterComponent.fxml"/>
    </bottom>

</BorderPane>