<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ExpiredDocumentController"
            stylesheets="@../css/application.css" styleClass="border-pane">

    <top>
        <fx:include source="MenuBarComponent.fxml"/>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="false" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
            <VBox spacing="20" alignment="TOP_CENTER" styleClass="dashboard-container">
                <padding>
                    <Insets top="25" right="40" bottom="30" left="40"/>
                </padding>

                <Label text="Expired Document Detection" styleClass="label-title" alignment="CENTER" maxWidth="Infinity"/>
                <Label text="Detect and manage expired vehicle documents" styleClass="label-subtitle" alignment="CENTER" maxWidth="Infinity"/>

                <Separator/>

                <ProgressIndicator fx:id="loadProgress" visible="false" maxWidth="40"/>

                <!-- Search Section -->
                <HBox alignment="CENTER">
                    <VBox maxWidth="900" minWidth="600" styleClass="profile-edit-card" alignment="CENTER">
                        <Label text="Search Vehicle" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>

                        <HBox spacing="15" alignment="CENTER">
                            <TextField fx:id="searchRegistrationField" promptText="Enter Registration Number" HBox.hgrow="ALWAYS" prefWidth="400"/>
                            <Button fx:id="searchButton" text="Check Documents" styleClass="button-primary" prefWidth="150"/>
                            <Button fx:id="fadeButton" text="Animate" styleClass="button-warning" prefWidth="100"/>
                        </HBox>
                    </VBox>
                </HBox>

                <ProgressBar fx:id="operationProgress" prefWidth="Infinity" progress="0" visible="false"/>

                <!-- Summary Statistics Cards - Using FlowPane for proper wrapping -->
                <FlowPane hgap="20" vgap="15" alignment="CENTER">
                    <VBox spacing="8" styleClass="dashboard-card" alignment="CENTER" minWidth="160" prefWidth="180">
                        <Label text="Expired Documents" styleClass="card-title"/>
                        <Label fx:id="expiredCountLabel" text="0" styleClass="card-value" style="-fx-text-fill: #e74c3c;"/>
                    </VBox>

                    <VBox spacing="8" styleClass="dashboard-card" alignment="CENTER" minWidth="160" prefWidth="180">
                        <Label text="Critical (7 days)" styleClass="card-title"/>
                        <Label fx:id="criticalCountLabel" text="0" styleClass="card-value" style="-fx-text-fill: #f39c12;"/>
                    </VBox>

                    <VBox spacing="8" styleClass="dashboard-card" alignment="CENTER" minWidth="160" prefWidth="180">
                        <Label text="Warning (30 days)" styleClass="card-title"/>
                        <Label fx:id="warningCountLabel" text="0" styleClass="card-value" style="-fx-text-fill: #f1c40f;"/>
                    </VBox>

                    <VBox spacing="8" styleClass="dashboard-card" alignment="CENTER" minWidth="160" prefWidth="180">
                        <Label text="Overall Status" styleClass="card-title"/>
                        <Label fx:id="overallStatusLabel" text="CLEAN" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
                    </VBox>
                </FlowPane>

                <Separator/>

                <!-- Vehicle Documents Table - FIXED: Removed restrictive maxWidth, added prefWidth -->
                <TitledPane text="Vehicle Documents" expanded="true" animated="true">
                    <VBox spacing="12" style="-fx-padding: 12;">
                        <TableView fx:id="documentsTable" prefHeight="350" minHeight="250" maxWidth="Infinity">
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                            <columns>
                                <TableColumn fx:id="documentTypeColumn" text="Document Type" prefWidth="180"/>
                                <TableColumn fx:id="documentNumberColumn" text="Document Number" prefWidth="160"/>
                                <TableColumn fx:id="issueDateColumn" text="Issue Date" prefWidth="110"/>
                                <TableColumn fx:id="expiryDateColumn" text="Expiry Date" prefWidth="110"/>
                                <TableColumn fx:id="expiryStatusColumn" text="Status" prefWidth="100"/>
                            </columns>
                            <placeholder>
                                <Label text="No documents found" styleClass="status-text"/>
                            </placeholder>
                        </TableView>
                        <HBox alignment="CENTER">
                            <Pagination fx:id="documentsPagination" pageCount="1" maxPageIndicatorCount="5"/>
                        </HBox>
                    </VBox>
                </TitledPane>

                <!-- Action Buttons -->
                <HBox spacing="20" alignment="CENTER">
                    <Button fx:id="refreshButton" text="Refresh All" styleClass="button-info" prefWidth="130"/>
                    <Button fx:id="generateViolationsButton" text="Generate Violations" styleClass="button-danger" prefWidth="180"/>
                </HBox>

                <Label fx:id="statusLabel" styleClass="status-text" alignment="CENTER" maxWidth="Infinity"/>

                <HBox alignment="CENTER">
                    <Button fx:id="backButton" text="Back to Dashboard" styleClass="button-secondary" prefWidth="150"/>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <fx:include source="FooterComponent.fxml"/>
    </bottom>
</BorderPane>