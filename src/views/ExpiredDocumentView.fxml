<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ExpiredDocumentController">

    <top>
        <VBox>
            <fx:include source="MenuBarComponent.fxml"/>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true">
            <VBox spacing="20" style="-fx-padding: 20;">

                <Label text="Expired Document Detection" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <Label text="Detect and manage expired vehicle documents" style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;"/>

                <Separator/>

                <ProgressIndicator fx:id="loadProgress" visible="false" maxWidth="40"/>

                <TitledPane text="Search Vehicle" expanded="true" style="-fx-font-weight: bold;">
                    <HBox spacing="10" alignment="CENTER" style="-fx-padding: 10;">
                        <TextField fx:id="searchRegistrationField" promptText="Enter Registration Number" HBox.hgrow="ALWAYS"/>
                        <Button fx:id="searchButton" text="Check Documents" style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;">
                            <effect>
                                <DropShadow radius="3" color="rgba(0,0,0,0.2)"/>
                            </effect>
                        </Button>
                        <Button fx:id="fadeButton" text="Animate" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;">
                            <effect>
                                <DropShadow radius="3" color="rgba(0,0,0,0.2)"/>
                            </effect>
                        </Button>
                    </HBox>
                </TitledPane>

                <ProgressBar fx:id="operationProgress" prefWidth="Infinity" progress="0" visible="false"/>

                <TitledPane text="Summary Statistics" expanded="true" style="-fx-font-weight: bold;">
                    <GridPane hgap="20" vgap="10" style="-fx-background-color: #f8f9fa; -fx-padding: 15; -fx-border-radius: 8;">
                        <Label text="Expired Documents:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-text-fill: #e74c3c; -fx-font-weight: bold;"/>
                        <Label fx:id="expiredCountLabel" GridPane.rowIndex="0" GridPane.columnIndex="1" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #e74c3c;"/>

                        <Label text="Critical (7 days):" GridPane.rowIndex="0" GridPane.columnIndex="2" style="-fx-text-fill: #f39c12; -fx-font-weight: bold;"/>
                        <Label fx:id="criticalCountLabel" GridPane.rowIndex="0" GridPane.columnIndex="3" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #f39c12;"/>

                        <Label text="Warning (30 days):" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-text-fill: #f1c40f; -fx-font-weight: bold;"/>
                        <Label fx:id="warningCountLabel" GridPane.rowIndex="1" GridPane.columnIndex="1" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #f1c40f;"/>

                        <Label text="Overall Status:" GridPane.rowIndex="1" GridPane.columnIndex="2" style="-fx-text-fill: #2c3e50; -fx-font-weight: bold;"/>
                        <Label fx:id="overallStatusLabel" GridPane.rowIndex="1" GridPane.columnIndex="3" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                    </GridPane>
                </TitledPane>

                <TitledPane text="Vehicle Documents" expanded="true" style="-fx-font-weight: bold;">
                    <VBox spacing="10" style="-fx-padding: 10;">
                        <TableView fx:id="documentsTable" prefHeight="300">
                            <columns>
                                <TableColumn fx:id="documentTypeColumn" text="Document Type" prefWidth="200"/>
                                <TableColumn fx:id="documentNumberColumn" text="Document Number" prefWidth="150"/>
                                <TableColumn fx:id="issueDateColumn" text="Issue Date" prefWidth="100"/>
                                <TableColumn fx:id="expiryDateColumn" text="Expiry Date" prefWidth="100"/>
                                <TableColumn fx:id="expiryStatusColumn" text="Status" prefWidth="100"/>
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                            <placeholder>
                                <Label text="No documents found" style="-fx-text-fill: #7f8c8d;"/>
                            </placeholder>
                        </TableView>
                        <Pagination fx:id="documentsPagination" pageCount="1" maxPageIndicatorCount="5"/>
                    </VBox>
                </TitledPane>

                <HBox spacing="10">
                    <Button fx:id="refreshButton" text="Refresh All" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
                    <Button fx:id="generateViolationsButton" text="Generate Violations" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
                </HBox>

                <Label fx:id="statusLabel" style="-fx-text-fill: #7f8c8d; -fx-font-style: italic;"/>
            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <HBox spacing="10" style="-fx-padding: 10;" alignment="CENTER_RIGHT">
            <Button fx:id="backButton" text="Back to Dashboard" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
        </HBox>
        <fx:include source="FooterComponent.fxml"/>
    </bottom>

</BorderPane>