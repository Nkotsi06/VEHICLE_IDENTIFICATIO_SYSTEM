<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.InsuranceClaimController">

    <top>
        <VBox>
            <fx:include source="MenuBarComponent.fxml"/>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true">
            <SplitPane dividerPositions="0.5">
                <VBox spacing="10" style="-fx-padding: 10;">
                    <Label text="Insurance Claims" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

                    <ProgressIndicator fx:id="loadProgress" visible="false" maxWidth="30"/>

                    <TableView fx:id="claimsTable" prefHeight="400">
                        <columns>
                            <TableColumn fx:id="claimIdColumn" text="Claim ID" prefWidth="80"/>
                            <TableColumn fx:id="policyColumn" text="Policy Number" prefWidth="130"/>
                            <TableColumn fx:id="claimDateColumn" text="Claim Date" prefWidth="100"/>
                            <TableColumn fx:id="amountColumn" text="Amount (M)" prefWidth="100"/>
                            <TableColumn fx:id="claimStatusColumn" text="Status" prefWidth="100"/>
                            <TableColumn fx:id="approvedAmountColumn" text="Approved (M)" prefWidth="100"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                        <placeholder>
                            <Label text="No insurance claims found" style="-fx-text-fill: #7f8c8d;"/>
                        </placeholder>
                    </TableView>

                    <Pagination fx:id="claimsPagination" pageCount="1" maxPageIndicatorCount="5"/>

                    <HBox spacing="10">
                        <Button fx:id="refreshButton" text="Refresh" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
                        <Button fx:id="fadeButton" text="Animate" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;">
                            <effect>
                                <DropShadow radius="3" color="rgba(0,0,0,0.2)"/>
                            </effect>
                        </Button>
                    </HBox>
                </VBox>

                <VBox spacing="15" style="-fx-padding: 10;">
                    <Label text="Claim Details" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

                    <ProgressBar fx:id="operationProgress" prefWidth="Infinity" progress="0" visible="false"/>

                    <GridPane hgap="10" vgap="10">
                        <Label text="Policy:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                        <ComboBox fx:id="policyComboBox" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="250"/>

                        <Label text="Claim Amount (M):" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                        <TextField fx:id="claimAmountField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                    </GridPane>

                    <Label text="Description:" style="-fx-font-weight: bold;"/>
                    <TextArea fx:id="descriptionArea" prefHeight="80" promptText="Enter claim description..."/>

                    <HBox spacing="10">
                        <Button fx:id="submitButton" text="Submit Claim" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;">
                            <effect>
                                <DropShadow radius="3" color="rgba(0,0,0,0.2)"/>
                            </effect>
                        </Button>
                        <Button fx:id="approveButton" text="Approve" style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" visible="false"/>
                        <Button fx:id="rejectButton" text="Reject" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" visible="false"/>
                    </HBox>

                    <Separator/>

                    <Label text="Status Information" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                    <Label fx:id="statusLabel" style="-fx-text-fill: #7f8c8d;"/>
                    <Label text="Approved Amount:" style="-fx-font-weight: bold;"/>
                    <Label fx:id="approvedAmountLabel" style="-fx-text-fill: #27ae60; -fx-font-weight: bold;"/>
                    <Label text="Rejection Reason:" style="-fx-font-weight: bold;"/>
                    <TextArea fx:id="rejectionReasonArea" prefHeight="60" visible="false" promptText="Enter rejection reason..."/>
                </VBox>
            </SplitPane>
        </ScrollPane>
    </center>

    <bottom>
        <HBox spacing="10" style="-fx-padding: 10;" alignment="CENTER_RIGHT">
            <Button fx:id="backButton" text="Back to Dashboard" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-pref-width: 150;"/>
        </HBox>
        <fx:include source="FooterComponent.fxml"/>
    </bottom>
</BorderPane>