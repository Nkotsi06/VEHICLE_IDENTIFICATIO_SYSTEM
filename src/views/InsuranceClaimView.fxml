<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.InsuranceClaimController"
            stylesheets="@../css/application.css" styleClass="border-pane">

    <top>
        <fx:include source="MenuBarComponent.fxml"/>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="false" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
            <VBox spacing="20" alignment="TOP_CENTER" styleClass="dashboard-container">
                <padding>
                    <Insets top="25" right="40" bottom="30" left="40"/>
                </padding>

                <Label text="Insurance Claims" styleClass="label-title" alignment="CENTER" maxWidth="Infinity"/>
                <Label text="Submit and track your insurance claims" styleClass="label-subtitle" alignment="CENTER" maxWidth="Infinity"/>

                <Separator/>

                <HBox spacing="25" alignment="CENTER" fillHeight="true">
                    <!-- Left Panel - Insurance Claims -->
                    <VBox spacing="15" alignment="CENTER" HBox.hgrow="ALWAYS" prefWidth="550">
                        <VBox styleClass="profile-edit-card" alignment="CENTER" prefWidth="550">
                            <Label text="My Claims" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>

                            <ProgressIndicator fx:id="loadProgress" visible="false" maxWidth="30"/>

                            <TableView fx:id="claimsTable" prefHeight="450" maxWidth="Infinity">
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                </columnResizePolicy>
                                <columns>
                                    <TableColumn fx:id="claimIdColumn" text="Claim ID" prefWidth="80"/>
                                    <TableColumn fx:id="policyColumn" text="Policy Number" prefWidth="130"/>
                                    <TableColumn fx:id="claimDateColumn" text="Claim Date" prefWidth="100"/>
                                    <TableColumn fx:id="amountColumn" text="Amount (M)" prefWidth="100"/>
                                    <TableColumn fx:id="claimStatusColumn" text="Status" prefWidth="100"/>
                                    <TableColumn fx:id="approvedAmountColumn" text="Approved (M)" prefWidth="100"/>
                                </columns>
                                <placeholder>
                                    <Label text="No insurance claims found" styleClass="status-text"/>
                                </placeholder>
                            </TableView>

                            <HBox alignment="CENTER">
                                <Pagination fx:id="claimsPagination" pageCount="1" maxPageIndicatorCount="5"/>
                            </HBox>

                            <HBox alignment="CENTER" spacing="15">
                                <Button fx:id="refreshButton" text="Refresh" styleClass="button-info" prefWidth="100"/>
                                <Button fx:id="fadeButton" text="Animate" styleClass="button-warning" prefWidth="100"/>
                            </HBox>
                        </VBox>
                    </VBox>

                    <!-- Right Panel - Claim Details -->
                    <VBox spacing="15" alignment="CENTER" HBox.hgrow="ALWAYS" prefWidth="450">
                        <VBox styleClass="profile-edit-card" alignment="CENTER" prefWidth="450">
                            <Label text="Claim Details" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>

                            <ProgressBar fx:id="operationProgress" prefWidth="Infinity" progress="0" visible="false"/>

                            <GridPane hgap="15" vgap="12" alignment="CENTER">
                                <columnConstraints>
                                    <ColumnConstraints halignment="RIGHT" minWidth="100" prefWidth="100"/>
                                    <ColumnConstraints minWidth="250" hgrow="ALWAYS"/>
                                </columnConstraints>
                                <Label text="Policy:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <ComboBox fx:id="policyComboBox" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="280"/>

                                <Label text="Claim Amount (M):" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <TextField fx:id="claimAmountField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                            </GridPane>

                            <Label text="Description:" style="-fx-font-weight: bold;" alignment="CENTER" maxWidth="Infinity"/>
                            <TextArea fx:id="descriptionArea" prefHeight="80" promptText="Enter claim description..."/>

                            <HBox alignment="CENTER" spacing="15">
                                <Button fx:id="submitButton" text="Submit Claim" styleClass="button-success" prefWidth="120"/>
                                <Button fx:id="approveButton" text="Approve" styleClass="button-info" prefWidth="100" visible="false"/>
                                <Button fx:id="rejectButton" text="Reject" styleClass="button-danger" prefWidth="100" visible="false"/>
                            </HBox>

                            <Separator/>

                            <Label text="Status Information" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" alignment="CENTER" maxWidth="Infinity"/>
                            <Label fx:id="statusLabel" styleClass="status-text" alignment="CENTER" maxWidth="Infinity"/>
                            <Label text="Approved Amount:" style="-fx-font-weight: bold;" alignment="CENTER" maxWidth="Infinity"/>
                            <Label fx:id="approvedAmountLabel" style="-fx-text-fill: #27ae60; -fx-font-weight: bold;" alignment="CENTER" maxWidth="Infinity"/>
                            <Label text="Rejection Reason:" style="-fx-font-weight: bold;" alignment="CENTER" maxWidth="Infinity"/>
                            <TextArea fx:id="rejectionReasonArea" prefHeight="60" visible="false" promptText="Enter rejection reason..."/>
                        </VBox>
                    </VBox>
                </HBox>

                <HBox alignment="CENTER">
                    <Button fx:id="backButton" text="Back to Dashboard" styleClass="button-secondary" prefWidth="150"/>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <fx:include source="FooterComponent.fxml"/>
    </bottom>
</BorderPane>