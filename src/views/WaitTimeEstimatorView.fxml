<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.WaitTimeEstimatorController"
            stylesheets="@../css/application.css" styleClass="border-pane">

    <top>
        <fx:include source="MenuBarComponent.fxml"/>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="false" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
            <VBox spacing="20" alignment="TOP_CENTER" styleClass="dashboard-container">
                <padding>
                    <Insets top="25" right="40" bottom="30" left="40"/>
                </padding>

                <Label text="Wait Time Estimator" styleClass="label-title" alignment="CENTER" maxWidth="Infinity"/>
                <Label text="Estimate service wait times for workshops" styleClass="label-subtitle" alignment="CENTER" maxWidth="Infinity"/>

                <Separator/>

                <ProgressIndicator fx:id="loadProgress" visible="false" maxWidth="40"/>

                <!-- Select Workshop Section -->
                <HBox alignment="CENTER">
                    <VBox maxWidth="900" minWidth="600" styleClass="profile-edit-card" alignment="CENTER">
                        <Label text="Select Workshop" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>

                        <GridPane hgap="15" vgap="12" alignment="CENTER">
                            <columnConstraints>
                                <ColumnConstraints halignment="RIGHT" minWidth="100" prefWidth="100"/>
                                <ColumnConstraints minWidth="350" hgrow="ALWAYS"/>
                            </columnConstraints>

                            <Label text="Select Workshop:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <ComboBox fx:id="workshopComboBox" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="400"/>
                        </GridPane>

                        <HBox alignment="CENTER" spacing="15">
                            <Button fx:id="estimateButton" text="Estimate Wait Time" styleClass="button-primary" prefWidth="160"/>
                            <Button fx:id="fadeButton" text="Animate" styleClass="button-warning" prefWidth="100"/>
                        </HBox>
                    </VBox>
                </HBox>

                <ProgressBar fx:id="operationProgress" prefWidth="Infinity" progress="0" visible="false"/>

                <!-- Wait Time Display Card -->
                <HBox alignment="CENTER">
                    <VBox spacing="15" styleClass="profile-card" alignment="CENTER" minWidth="400">
                        <Label text="Current Wait Time" styleClass="card-title" alignment="CENTER" maxWidth="Infinity"/>
                        <HBox spacing="10" alignment="CENTER">
                            <Label fx:id="waitTimeLabel" style="-fx-font-size: 48px; -fx-font-weight: bold; -fx-text-fill: #f1c40f;"/>
                            <Label text="hours" style="-fx-font-size: 20px; -fx-text-fill: #2c3e50;"/>
                        </HBox>
                        <ProgressBar fx:id="waitTimeProgress" prefWidth="300" progress="0"/>
                    </VBox>
                </HBox>

                <Separator/>

                <!-- Statistics Grid -->
                <HBox alignment="CENTER">
                    <VBox maxWidth="1000" styleClass="profile-edit-card" alignment="CENTER">
                        <Label text="Workshop Statistics" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>

                        <GridPane hgap="25" vgap="12" alignment="CENTER">
                            <columnConstraints>
                                <ColumnConstraints halignment="RIGHT" minWidth="130" prefWidth="130"/>
                                <ColumnConstraints minWidth="150" hgrow="ALWAYS"/>
                                <ColumnConstraints halignment="RIGHT" minWidth="130" prefWidth="130"/>
                                <ColumnConstraints minWidth="150" hgrow="ALWAYS"/>
                            </columnConstraints>

                            <Label text="Active Services:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <Label fx:id="activeServicesLabel" GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="status-text"/>

                            <Label text="Average Service Time:" GridPane.rowIndex="0" GridPane.columnIndex="2" style="-fx-font-weight: bold;"/>
                            <Label fx:id="avgServiceTimeLabel" GridPane.rowIndex="0" GridPane.columnIndex="3" styleClass="status-text"/>

                            <Label text="Mechanics Available:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <Label fx:id="mechanicsAvailableLabel" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="status-text"/>

                            <Label text="Queue Length:" GridPane.rowIndex="1" GridPane.columnIndex="2" style="-fx-font-weight: bold;"/>
                            <Label fx:id="queueLengthLabel" GridPane.rowIndex="1" GridPane.columnIndex="3" styleClass="status-text"/>

                            <Label text="Busy Level:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <Label fx:id="busyLevelLabel" GridPane.rowIndex="2" GridPane.columnIndex="1" style="-fx-font-weight: bold;"/>
                            <ProgressBar fx:id="busyProgressBar" prefWidth="150" progress="0" GridPane.rowIndex="2" GridPane.columnIndex="2" GridPane.columnSpan="2"/>
                        </GridPane>
                    </VBox>
                </HBox>

                <Separator/>

                <!-- Recommendation Section -->
                <HBox alignment="CENTER">
                    <VBox maxWidth="900" minWidth="500" styleClass="profile-edit-card" alignment="CENTER">
                        <Label text="Recommendation" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>
                        <Label fx:id="recommendationLabel" styleClass="status-text" wrapText="true" alignment="CENTER" maxWidth="Infinity"/>
                    </VBox>
                </HBox>

                <!-- Action Buttons -->
                <HBox alignment="CENTER" spacing="15">
                    <Button fx:id="bookButton" text="Book Appointment" styleClass="button-success" prefWidth="160" disable="true"/>
                    <Button fx:id="refreshButton" text="Refresh" styleClass="button-info" prefWidth="100"/>
                </HBox>

                <Label fx:id="statusLabel" styleClass="status-text" alignment="CENTER" maxWidth="Infinity"/>

                <HBox alignment="CENTER">
                    <Button fx:id="backButton" text="Back to Dashboard" styleClass="button-secondary" prefWidth="150"/>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <fx:include source="FooterComponent.fxml"/>
    </bottom>
</BorderPane>