<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ServiceAnalyticsController">

    <top>
        <VBox>
            <fx:include source="MenuBarComponent.fxml"/>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true">
            <VBox spacing="20" style="-fx-padding: 20;">
                <Label text="Service Analytics" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <Label text="Analyze service performance and trends" style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;"/>

                <Separator/>

                <ProgressIndicator fx:id="loadProgress" visible="false" maxWidth="40"/>

                <GridPane hgap="20" vgap="15" style="-fx-background-color: #f8f9fa; -fx-padding: 20; -fx-border-radius: 10; -fx-background-radius: 10;">
                    <Label text="Total Services:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                    <Label fx:id="totalServicesLabel" GridPane.rowIndex="0" GridPane.columnIndex="1" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

                    <Label text="Most Common Service:" GridPane.rowIndex="0" GridPane.columnIndex="2" style="-fx-font-weight: bold;"/>
                    <Label fx:id="mostCommonServiceLabel" GridPane.rowIndex="0" GridPane.columnIndex="3" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2980b9;"/>

                    <Label text="Average Cost:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                    <Label fx:id="averageCostLabel" GridPane.rowIndex="1" GridPane.columnIndex="1" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>

                    <Label text="Busiest Month:" GridPane.rowIndex="1" GridPane.columnIndex="2" style="-fx-font-weight: bold;"/>
                    <Label fx:id="busiestMonthLabel" GridPane.rowIndex="1" GridPane.columnIndex="3" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #e67e22;"/>

                    <Label text="Customer Satisfaction:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                    <ProgressBar fx:id="satisfactionProgress" prefWidth="200" progress="0"/>
                    <Label fx:id="satisfactionLabel" GridPane.rowIndex="2" GridPane.columnIndex="1" style="-fx-text-fill: #f39c12;"/>
                </GridPane>

                <Separator/>

                <Label text="Service Type Distribution" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <PieChart fx:id="serviceTypeChart" prefHeight="300" prefWidth="500"/>

                <Separator/>

                <Label text="Monthly Service Trend" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <BarChart fx:id="monthlyTrendChart" prefHeight="350">
                    <xAxis>
                        <CategoryAxis label="Month"/>
                    </xAxis>
                    <yAxis>
                        <NumberAxis label="Number of Services"/>
                    </yAxis>
                </BarChart>

                <Separator/>

                <Label text="Service Type Statistics" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <TableView fx:id="serviceTypeTable" prefHeight="250">
                    <columns>
                        <TableColumn fx:id="typeColumn" text="Service Type" prefWidth="200"/>
                        <TableColumn fx:id="countColumn" text="Count" prefWidth="100"/>
                        <TableColumn fx:id="avgCostColumn" text="Average Cost (M)" prefWidth="150"/>
                        <TableColumn fx:id="minCostColumn" text="Min (M)" prefWidth="100"/>
                        <TableColumn fx:id="maxCostColumn" text="Max (M)" prefWidth="100"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                    <placeholder>
                        <Label text="No data available" style="-fx-text-fill: #7f8c8d;"/>
                    </placeholder>
                </TableView>

                <Pagination fx:id="analyticsPagination" pageCount="1" maxPageIndicatorCount="5"/>

                <ProgressBar fx:id="operationProgress" prefWidth="Infinity" progress="0" visible="false"/>

                <HBox spacing="10">
                    <Button fx:id="refreshButton" text="Refresh" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;">
                        <effect>
                            <DropShadow radius="3" color="rgba(0,0,0,0.2)"/>
                        </effect>
                    </Button>
                    <Button fx:id="exportButton" text="Export Analytics" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
                    <Button fx:id="backButton" text="Back" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
                </HBox>

                <Label fx:id="statusLabel" style="-fx-text-fill: #7f8c8d; -fx-font-style: italic;"/>
            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <fx:include source="FooterComponent.fxml"/>
    </bottom>
</BorderPane>