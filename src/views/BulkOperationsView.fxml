<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.BulkOperationsController">

    <top>
        <VBox>
            <fx:include source="MenuBarComponent.fxml"/>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true" style="-fx-background-color: #f0f2f5; -fx-background: #f0f2f5;"
                    hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
            <VBox spacing="20" style="-fx-padding: 20; -fx-background-color: #f0f2f5;"
                  maxHeight="Infinity" maxWidth="Infinity" minHeight="-Infinity" minWidth="-Infinity">

                <Label text="Bulk Operations" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <Label text="Import, export, update, or delete records in bulk" style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;"/>

                <Separator/>

                <ProgressIndicator fx:id="loadProgress" visible="false" maxWidth="40" style="-fx-padding: 5;" VBox.vgrow="NEVER"/>

                <!-- Operation Configuration Section -->
                <TitledPane text="Operation Configuration" expanded="true" style="-fx-font-weight: bold;" VBox.vgrow="NEVER">
                    <GridPane hgap="15" vgap="15" style="-fx-padding: 15;" maxWidth="Infinity">
                        <columnConstraints>
                            <ColumnConstraints minWidth="100" maxWidth="150"/>
                            <ColumnConstraints minWidth="200" maxWidth="400"/>
                            <ColumnConstraints minWidth="100" maxWidth="150"/>
                        </columnConstraints>

                        <Label text="Operation Type:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                        <ComboBox fx:id="operationTypeComboBox" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="200" promptText="Select operation" maxWidth="300"/>

                        <Label text="Entity Type:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                        <ComboBox fx:id="entityTypeComboBox" GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="200" promptText="Select entity type" maxWidth="300"/>

                        <Button fx:id="fadeButton" text="Animate" GridPane.rowIndex="0" GridPane.columnIndex="2"
                                style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-pref-width: 100; -fx-padding: 8 15;">
                            <effect>
                                <DropShadow radius="3" color="rgba(0,0,0,0.2)"/>
                            </effect>
                        </Button>
                    </GridPane>
                </TitledPane>

                <ProgressBar fx:id="operationProgress" prefWidth="Infinity" progress="0" visible="false" style="-fx-padding: 5;" VBox.vgrow="NEVER"/>

                <!-- File Selection Section -->
                <TitledPane text="File Selection" expanded="true" style="-fx-font-weight: bold;" VBox.vgrow="NEVER">
                    <VBox spacing="10" style="-fx-padding: 15;">
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Button fx:id="loadFileButton" text="Load File"
                                    style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 15;">
                                <effect>
                                    <DropShadow radius="3" color="rgba(0,0,0,0.2)"/>
                                </effect>
                            </Button>
                            <Label fx:id="filePathLabel" text="No file selected" style="-fx-text-fill: #7f8c8d; -fx-font-style: italic;"/>
                        </HBox>
                    </VBox>
                </TitledPane>

                <!-- Data (JSON Format) Section - Fixed height text area -->
                <TitledPane text="Data (JSON Format)" expanded="true" style="-fx-font-weight: bold;" VBox.vgrow="NEVER">
                    <VBox spacing="10" style="-fx-padding: 15;">
                        <TextArea fx:id="jsonDataArea" prefHeight="200" minHeight="150" maxHeight="300"
                                  promptText='[
  {
    "username": "john_doe",
    "password": "pass123",
    "full_name": "John Doe",
    "email": "john@example.com",
    "address": "123 Main St",
    "phone": "+266 1234 5678"
  }
]'/>
                    </VBox>
                </TitledPane>

                <!-- Preview Table for Data - THIS SHOULD EXPAND -->
                <TitledPane text="Data Preview" expanded="false" style="-fx-font-weight: bold;"
                            VBox.vgrow="ALWAYS" maxHeight="1.7976931348623157E308">
                    <VBox spacing="10" style="-fx-padding: 10; -fx-background-color: white;"
                          VBox.vgrow="ALWAYS" maxHeight="Infinity">
                        <TableView fx:id="previewTable" VBox.vgrow="ALWAYS"
                                   prefHeight="300" minHeight="200" maxHeight="1.7976931348623157E308">
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                            <placeholder>
                                <Label text="Load data to preview" style="-fx-text-fill: #7f8c8d; -fx-font-size: 14px;"/>
                            </placeholder>
                        </TableView>
                    </VBox>
                </TitledPane>

                <!-- Actions Section -->
                <TitledPane text="Actions" expanded="true" style="-fx-font-weight: bold;" VBox.vgrow="NEVER">
                    <VBox spacing="15" style="-fx-padding: 15;">
                        <HBox spacing="15">
                            <Button fx:id="validateButton" text="Validate Data"
                                    style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-pref-width: 130; -fx-padding: 8 15;">
                                <effect>
                                    <DropShadow radius="3" color="rgba(0,0,0,0.2)"/>
                                </effect>
                            </Button>
                            <Button fx:id="executeButton" text="Execute"
                                    style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-pref-width: 130; -fx-padding: 8 15;"/>
                            <Button fx:id="refreshButton" text="Clear Form"
                                    style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-pref-width: 130; -fx-padding: 8 15;"/>
                        </HBox>

                        <Separator/>

                        <Label fx:id="statusLabel" style="-fx-text-fill: #7f8c8d; -fx-font-style: italic;"/>
                    </VBox>
                </TitledPane>

                <!-- Back Button -->
                <HBox spacing="10" alignment="CENTER_RIGHT" VBox.vgrow="NEVER">
                    <Button fx:id="backButton" text="Back to Dashboard"
                            style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-pref-width: 150; -fx-padding: 8 15;">
                        <effect>
                            <DropShadow radius="3" color="rgba(0,0,0,0.2)"/>
                        </effect>
                    </Button>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <fx:include source="FooterComponent.fxml"/>
    </bottom>

</BorderPane>