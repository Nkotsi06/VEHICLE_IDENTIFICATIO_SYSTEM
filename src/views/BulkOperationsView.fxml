<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.BulkOperationsController"
            stylesheets="@../css/application.css" styleClass="border-pane">

    <top>
        <fx:include source="MenuBarComponent.fxml"/>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="false" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    style="-fx-background-color: #f0f2f5; -fx-background: #f0f2f5;">
            <VBox spacing="20" alignment="TOP_CENTER"
                  style="-fx-background-color: #f0f2f5; -fx-padding: 25 40 30 40;">

                <Label text="Bulk Operations" styleClass="label-title" alignment="CENTER" maxWidth="Infinity"/>
                <Label text="Import, export, update, or delete records in bulk" styleClass="label-subtitle" alignment="CENTER" maxWidth="Infinity"/>

                <Separator/>

                <ProgressIndicator fx:id="loadProgress" visible="false" maxWidth="40"/>

                <!-- Operation Configuration Section -->
                <HBox alignment="CENTER">
                    <VBox maxWidth="900" styleClass="profile-edit-card" alignment="CENTER">
                        <Label text="Operation Configuration" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>

                        <GridPane hgap="15" vgap="15" alignment="CENTER">
                            <rowConstraints>
                                <RowConstraints/>
                                <RowConstraints/>
                            </rowConstraints>
                            <columnConstraints>
                                <ColumnConstraints minWidth="100" maxWidth="150" halignment="RIGHT"/>
                                <ColumnConstraints minWidth="200" maxWidth="300"/>
                                <ColumnConstraints minWidth="100" maxWidth="150"/>
                            </columnConstraints>

                            <Label text="Operation Type:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <ComboBox fx:id="operationTypeComboBox" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="200" promptText="Select operation"/>

                            <Label text="Entity Type:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <ComboBox fx:id="entityTypeComboBox" GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="200" promptText="Select entity type"/>

                            <Button fx:id="fadeButton" text="Animate" GridPane.rowIndex="0" GridPane.columnIndex="2"
                                    styleClass="button-warning" prefWidth="100"/>
                        </GridPane>
                    </VBox>
                </HBox>

                <ProgressBar fx:id="operationProgress" prefWidth="Infinity" progress="0" visible="false"/>

                <!-- File Selection Section -->
                <HBox alignment="CENTER">
                    <VBox maxWidth="900" styleClass="profile-edit-card" alignment="CENTER">
                        <Label text="File Selection" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>

                        <HBox spacing="10" alignment="CENTER">
                            <Button fx:id="loadFileButton" text="Load File" styleClass="button-info"/>
                            <Label fx:id="filePathLabel" text="No file selected" styleClass="status-text"/>
                        </HBox>
                    </VBox>
                </HBox>

                <!-- Data (JSON Format) Section -->
                <HBox alignment="CENTER">
                    <VBox maxWidth="900" styleClass="profile-edit-card" alignment="CENTER">
                        <Label text="Data (JSON Format)" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>
                        <TextArea fx:id="jsonDataArea" prefHeight="200" minHeight="150" maxHeight="300"
                                  promptText='[
  {
    "username": "nkone",
    "password": "pass123",
    "full_name": "Nkone Nkone",
    "email": "nkone@example.com",
    "address": "123 Ha Leponesa , Mafeteng",
    "phone": "+266 5432 5678"
  }
]' maxWidth="Infinity"/>
                    </VBox>
                </HBox>

                <!-- Preview Table for Data -->
                <HBox alignment="CENTER">
                    <VBox maxWidth="900" styleClass="profile-edit-card" alignment="CENTER">
                        <Label text="Data Preview" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>
                        <TableView fx:id="previewTable" prefHeight="300" minHeight="200"
                                   maxWidth="Infinity" columnResizePolicy="CONSTRAINED_RESIZE_POLICY">
                            <placeholder>
                                <Label text="Load data to preview" styleClass="status-text"/>
                            </placeholder>
                        </TableView>
                    </VBox>
                </HBox>

                <!-- Actions Section -->
                <HBox alignment="CENTER">
                    <VBox maxWidth="900" styleClass="profile-edit-card" alignment="CENTER">
                        <Label text="Actions" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>

                        <HBox spacing="15" alignment="CENTER">
                            <Button fx:id="validateButton" text="Validate Data" styleClass="button-warning" prefWidth="130"/>
                            <Button fx:id="executeButton" text="Execute" styleClass="button-success" prefWidth="130"/>
                            <Button fx:id="refreshButton" text="Clear Form" styleClass="button-secondary" prefWidth="130"/>
                        </HBox>

                        <Separator/>

                        <Label fx:id="statusLabel" styleClass="status-text" alignment="CENTER" maxWidth="Infinity"/>
                    </VBox>
                </HBox>

                <!-- Back Button -->
                <HBox spacing="10" alignment="CENTER">
                    <Button fx:id="backButton" text="Back to Dashboard" styleClass="button-secondary" prefWidth="150"/>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <fx:include source="FooterComponent.fxml"/>
    </bottom>
</BorderPane>