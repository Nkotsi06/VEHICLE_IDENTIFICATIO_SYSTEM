<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.InsuranceVerificationController">

    <top>
        <VBox>
            <fx:include source="MenuBarComponent.fxml"/>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true">
            <SplitPane dividerPositions="0.55">
                <VBox spacing="10" style="-fx-padding: 10;">
                    <Label text="Verification Records" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

                    <ProgressIndicator fx:id="loadProgress" visible="false" maxWidth="30"/>

                    <TableView fx:id="verificationsTable" prefHeight="400">
                        <columns>
                            <TableColumn fx:id="policyColumn" text="Policy Number" prefWidth="150"/>
                            <TableColumn fx:id="vehicleColumn" text="Vehicle" prefWidth="150"/>
                            <TableColumn fx:id="verificationDateColumn" text="Verification Date" prefWidth="120"/>
                            <TableColumn fx:id="verificationStatusColumn" text="Status" prefWidth="100"/>
                            <TableColumn fx:id="verifiedByColumn" text="Verified By" prefWidth="150"/>
                            <TableColumn fx:id="expiryDateColumn" text="Expiry Date" prefWidth="100"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                        <placeholder>
                            <Label text="No verification records" style="-fx-text-fill: #7f8c8d;"/>
                        </placeholder>
                    </TableView>

                    <Pagination fx:id="verificationsPagination" pageCount="1" maxPageIndicatorCount="5"/>

                    <HBox spacing="10">
                        <Button fx:id="refreshButton" text="Refresh" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
                        <Button fx:id="fadeButton" text="Animate" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;">
                            <effect>
                                <DropShadow radius="3" color="rgba(0,0,0,0.2)"/>
                            </effect>
                        </Button>
                    </HBox>
                </VBox>

                <VBox spacing="15" style="-fx-padding: 10;">
                    <Label text="Verify Insurance Policy" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

                    <ProgressBar fx:id="operationProgress" prefWidth="Infinity" progress="0" visible="false"/>

                    <GridPane hgap="10" vgap="10">
                        <Label text="Policy Number:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                        <ComboBox fx:id="policyComboBox" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="250" promptText="Select or enter policy number" editable="true"/>
                    </GridPane>

                    <TitledPane text="Policy Details" expanded="true" style="-fx-font-weight: bold;">
                        <GridPane hgap="15" vgap="8" style="-fx-padding: 10;">
                            <Label text="Provider:" style="-fx-font-weight: bold;"/>
                            <Label fx:id="providerDetailsLabel"/>
                            <Label text="Vehicle:" style="-fx-font-weight: bold;"/>
                            <Label fx:id="vehicleDetailsLabel"/>
                            <Label text="Owner:" style="-fx-font-weight: bold;"/>
                            <Label fx:id="ownerDetailsLabel"/>
                            <Label text="Start Date:" style="-fx-font-weight: bold;"/>
                            <Label fx:id="startDateDetailsLabel"/>
                            <Label text="Expiry Date:" style="-fx-font-weight: bold;"/>
                            <Label fx:id="expiryDateDetailsLabel"/>
                            <Label text="Coverage Type:" style="-fx-font-weight: bold;"/>
                            <Label fx:id="coverageDetailsLabel"/>
                        </GridPane>
                    </TitledPane>

                    <Label text="Verification Status:" style="-fx-font-weight: bold;"/>
                    <ComboBox fx:id="verificationStatusComboBox" prefWidth="200">
                        <items>
                            <FXCollections fx:factory="observableArrayList">
                                <String fx:value="VERIFIED"/>
                                <String fx:value="PENDING"/>
                                <String fx:value="REJECTED"/>
                                <String fx:value="EXPIRED"/>
                            </FXCollections>
                        </items>
                    </ComboBox>

                    <Label text="Notes:" style="-fx-font-weight: bold;"/>
                    <TextArea fx:id="notesArea" prefHeight="80" promptText="Enter verification notes..."/>

                    <HBox spacing="10">
                        <Button fx:id="verifyButton" text="Verify Policy" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;">
                            <effect>
                                <DropShadow radius="3" color="rgba(0,0,0,0.2)"/>
                            </effect>
                        </Button>
                        <Button fx:id="rejectButton" text="Reject" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
                        <Button fx:id="clearButton" text="Clear" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
                    </HBox>

                    <Label fx:id="statusLabel" style="-fx-text-fill: #7f8c8d; -fx-font-style: italic;"/>
                </VBox>
            </SplitPane>
        </ScrollPane>
    </center>

    <bottom>
        <HBox spacing="10" style="-fx-padding: 10;" alignment="CENTER_RIGHT">
            <Button fx:id="backButton" text="Back to Dashboard" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-pref-width: 150;"/>
        </HBox>
        <fx:include source="FooterComponent.fxml"/>
    </bottom>
</BorderPane>