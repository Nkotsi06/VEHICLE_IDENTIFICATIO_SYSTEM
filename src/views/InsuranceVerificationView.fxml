<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.InsuranceVerificationController"
            stylesheets="@../css/application.css" styleClass="border-pane">

    <top>
        <fx:include source="MenuBarComponent.fxml"/>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="false" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
            <VBox spacing="20" alignment="TOP_CENTER" styleClass="dashboard-container">
                <padding>
                    <Insets top="25" right="40" bottom="30" left="40"/>
                </padding>

                <Label text="Insurance Verification" styleClass="label-title" alignment="CENTER" maxWidth="Infinity"/>
                <Label text="Verify insurance policy status and details" styleClass="label-subtitle" alignment="CENTER" maxWidth="Infinity"/>

                <Separator/>

                <HBox spacing="25" alignment="CENTER" fillHeight="true">
                    <!-- Left Panel - Verification Records -->
                    <VBox spacing="15" alignment="CENTER" HBox.hgrow="ALWAYS" prefWidth="550">
                        <VBox styleClass="profile-edit-card" alignment="CENTER" prefWidth="550">
                            <Label text="Verification Records" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>

                            <ProgressIndicator fx:id="loadProgress" visible="false" maxWidth="30"/>

                            <TableView fx:id="verificationsTable" prefHeight="450" maxWidth="Infinity">
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                </columnResizePolicy>
                                <columns>
                                    <TableColumn fx:id="policyColumn" text="Policy Number" prefWidth="140"/>
                                    <TableColumn fx:id="vehicleColumn" text="Vehicle" prefWidth="140"/>
                                    <TableColumn fx:id="verificationDateColumn" text="Verification Date" prefWidth="120"/>
                                    <TableColumn fx:id="verificationStatusColumn" text="Status" prefWidth="100"/>
                                    <TableColumn fx:id="verifiedByColumn" text="Verified By" prefWidth="140"/>
                                    <TableColumn fx:id="expiryDateColumn" text="Expiry Date" prefWidth="110"/>
                                </columns>
                                <placeholder>
                                    <Label text="No verification records" styleClass="status-text"/>
                                </placeholder>
                            </TableView>

                            <HBox alignment="CENTER">
                                <Pagination fx:id="verificationsPagination" pageCount="1" maxPageIndicatorCount="5"/>
                            </HBox>

                            <HBox alignment="CENTER" spacing="15">
                                <Button fx:id="refreshButton" text="Refresh" styleClass="button-info" prefWidth="100"/>
                                <Button fx:id="fadeButton" text="Animate" styleClass="button-warning" prefWidth="100"/>
                            </HBox>
                        </VBox>
                    </VBox>

                    <!-- Right Panel - Verify Insurance Policy -->
                    <VBox spacing="15" alignment="CENTER" HBox.hgrow="ALWAYS" prefWidth="450">
                        <VBox styleClass="profile-edit-card" alignment="CENTER" prefWidth="450">
                            <Label text="Verify Insurance Policy" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>

                            <ProgressBar fx:id="operationProgress" prefWidth="Infinity" progress="0" visible="false"/>

                            <GridPane hgap="15" vgap="12" alignment="CENTER">
                                <columnConstraints>
                                    <ColumnConstraints halignment="RIGHT" minWidth="100" prefWidth="100"/>
                                    <ColumnConstraints minWidth="250" hgrow="ALWAYS"/>
                                </columnConstraints>
                                <Label text="Policy Number:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <ComboBox fx:id="policyComboBox" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="280" promptText="Select or enter policy number" editable="true"/>
                            </GridPane>

                            <TitledPane text="Policy Details" expanded="true">
                                <GridPane hgap="15" vgap="10" alignment="CENTER">
                                    <columnConstraints>
                                        <ColumnConstraints halignment="RIGHT" minWidth="100" prefWidth="100"/>
                                        <ColumnConstraints minWidth="200" hgrow="ALWAYS"/>
                                    </columnConstraints>
                                    <Label text="Provider:" style="-fx-font-weight: bold;" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                    <Label fx:id="providerDetailsLabel" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                                    <Label text="Vehicle:" style="-fx-font-weight: bold;" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                    <Label fx:id="vehicleDetailsLabel" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                                    <Label text="Owner:" style="-fx-font-weight: bold;" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                                    <Label fx:id="ownerDetailsLabel" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                                    <Label text="Start Date:" style="-fx-font-weight: bold;" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                                    <Label fx:id="startDateDetailsLabel" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                                    <Label text="Expiry Date:" style="-fx-font-weight: bold;" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                                    <Label fx:id="expiryDateDetailsLabel" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                                    <Label text="Coverage Type:" style="-fx-font-weight: bold;" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                                    <Label fx:id="coverageDetailsLabel" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
                                </GridPane>
                            </TitledPane>

                            <Label text="Verification Status:" style="-fx-font-weight: bold;" alignment="CENTER" maxWidth="Infinity"/>
                            <ComboBox fx:id="verificationStatusComboBox" prefWidth="200"/>

                            <Label text="Notes:" style="-fx-font-weight: bold;" alignment="CENTER" maxWidth="Infinity"/>
                            <TextArea fx:id="notesArea" prefHeight="80" promptText="Enter verification notes..."/>

                            <HBox alignment="CENTER" spacing="15">
                                <Button fx:id="verifyButton" text="Verify Policy" styleClass="button-success" prefWidth="120"/>
                                <Button fx:id="rejectButton" text="Reject" styleClass="button-danger" prefWidth="100"/>
                                <Button fx:id="clearButton" text="Clear" styleClass="button-secondary" prefWidth="100"/>
                            </HBox>

                            <Label fx:id="statusLabel" styleClass="status-text" alignment="CENTER" maxWidth="Infinity"/>
                        </VBox>
                    </VBox>
                </HBox>

                <HBox alignment="CENTER">
                    <Button fx:id="backButton" text="Back to Dashboard" styleClass="button-secondary" prefWidth="150"/>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <fx:include source="FooterComponent.fxml"/>
    </bottom>
</BorderPane>