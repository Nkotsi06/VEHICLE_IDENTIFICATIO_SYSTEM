<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.CustomerReviewController"
            stylesheets="@../css/application.css" styleClass="border-pane">

    <top>
        <fx:include source="MenuBarComponent.fxml"/>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="false" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
            <VBox spacing="20" alignment="TOP_CENTER" styleClass="dashboard-container">
                <padding>
                    <Insets top="25" right="40" bottom="30" left="40"/>
                </padding>

                <Label text="Workshop Reviews" styleClass="label-title" alignment="CENTER" maxWidth="Infinity"/>
                <Label text="Share your experience with workshops" styleClass="label-subtitle" alignment="CENTER" maxWidth="Infinity"/>

                <Separator/>

                <HBox spacing="25" alignment="CENTER" fillHeight="true">
                    <!-- Left Panel - My Reviews -->
                    <VBox spacing="15" alignment="CENTER" HBox.hgrow="ALWAYS" prefWidth="550">
                        <VBox styleClass="profile-edit-card" alignment="CENTER" prefWidth="550">
                            <Label text="My Reviews" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>

                            <ProgressIndicator fx:id="loadProgress" visible="false" maxWidth="30"/>

                            <TableView fx:id="reviewsTable" prefHeight="450" maxWidth="Infinity">
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                </columnResizePolicy>
                                <columns>
                                    <TableColumn fx:id="workshopColumn" text="Workshop" prefWidth="170"/>
                                    <TableColumn fx:id="ratingColumn" text="Rating" prefWidth="80"/>
                                    <TableColumn fx:id="reviewDateColumn" text="Date" prefWidth="110"/>
                                    <TableColumn fx:id="reviewTextColumn" text="Review" prefWidth="250"/>
                                </columns>
                                <placeholder>
                                    <Label text="No reviews found" styleClass="status-text"/>
                                </placeholder>
                            </TableView>

                            <HBox spacing="10" alignment="CENTER">
                                <Pagination fx:id="reviewsPagination" pageCount="1" maxPageIndicatorCount="5"/>
                            </HBox>

                            <HBox spacing="15" alignment="CENTER">
                                <Button fx:id="refreshButton" text="Refresh" styleClass="button-info" prefWidth="100"/>
                                <Button fx:id="writeReviewButton" text="Write Review" styleClass="button-success" prefWidth="120"/>
                                <Button fx:id="fadeButton" text="Animate" styleClass="button-warning" prefWidth="100"/>
                            </HBox>
                        </VBox>
                    </VBox>

                    <!-- Right Panel - Write a Review -->
                    <VBox spacing="15" alignment="CENTER" HBox.hgrow="ALWAYS" prefWidth="450">
                        <VBox styleClass="profile-edit-card" alignment="CENTER" prefWidth="450">
                            <Label text="Write a Review" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>

                            <ProgressBar fx:id="operationProgress" prefWidth="Infinity" progress="0" visible="false"/>

                            <GridPane hgap="15" vgap="12" alignment="CENTER">
                                <columnConstraints>
                                    <ColumnConstraints halignment="RIGHT" minWidth="80" prefWidth="80"/>
                                    <ColumnConstraints minWidth="250" hgrow="ALWAYS"/>
                                </columnConstraints>

                                <Label text="Workshop:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <ComboBox fx:id="workshopComboBox" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="280"/>
                            </GridPane>

                            <Label text="Rating:" style="-fx-font-weight: bold;" alignment="CENTER" maxWidth="Infinity"/>
                            <HBox spacing="15" alignment="CENTER">
                                <RadioButton fx:id="rating1Radio" text="⭐ 1 Star">
                                    <toggleGroup><ToggleGroup fx:id="ratingGroup"/></toggleGroup>
                                </RadioButton>
                                <RadioButton fx:id="rating2Radio" text="⭐⭐ 2 Stars" toggleGroup="$ratingGroup"/>
                                <RadioButton fx:id="rating3Radio" text="⭐⭐⭐ 3 Stars" toggleGroup="$ratingGroup"/>
                                <RadioButton fx:id="rating4Radio" text="⭐⭐⭐⭐ 4 Stars" toggleGroup="$ratingGroup"/>
                                <RadioButton fx:id="rating5Radio" text="⭐⭐⭐⭐⭐ 5 Stars" toggleGroup="$ratingGroup" selected="true"/>
                            </HBox>

                            <Label text="Review:" style="-fx-font-weight: bold;" alignment="CENTER" maxWidth="Infinity"/>
                            <TextArea fx:id="reviewTextArea" prefHeight="120" promptText="Share your experience with this workshop..."/>

                            <HBox spacing="15" alignment="CENTER">
                                <Button fx:id="submitButton" text="Submit Review" styleClass="button-success" prefWidth="120"/>
                                <Button fx:id="editButton" text="Edit Review" styleClass="button-info" prefWidth="110" visible="false"/>
                                <Button fx:id="deleteButton" text="Delete Review" styleClass="button-danger" prefWidth="110" visible="false"/>
                                <Button fx:id="clearButton" text="Clear" styleClass="button-secondary" prefWidth="80"/>
                            </HBox>

                            <Label fx:id="statusLabel" styleClass="status-text" alignment="CENTER" maxWidth="Infinity"/>
                        </VBox>
                    </VBox>
                </HBox>

                <HBox spacing="10" alignment="CENTER">
                    <Button fx:id="backButton" text="Back to Dashboard" styleClass="button-secondary" prefWidth="150"/>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <fx:include source="FooterComponent.fxml"/>
    </bottom>
</BorderPane>