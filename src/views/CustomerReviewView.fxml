<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.CustomerReviewController">

    <top>
        <VBox>
            <fx:include source="MenuBarComponent.fxml"/>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true">
            <SplitPane dividerPositions="0.55">
                <VBox spacing="10" style="-fx-padding: 10;">
                    <Label text="My Reviews" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

                    <ProgressIndicator fx:id="loadProgress" visible="false" maxWidth="30"/>

                    <TableView fx:id="reviewsTable" prefHeight="400">
                        <columns>
                            <TableColumn fx:id="workshopColumn" text="Workshop" prefWidth="180"/>
                            <TableColumn fx:id="ratingColumn" text="Rating" prefWidth="80"/>
                            <TableColumn fx:id="reviewDateColumn" text="Date" prefWidth="120"/>
                            <TableColumn fx:id="reviewTextColumn" text="Review" prefWidth="280"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                        <placeholder>
                            <Label text="No reviews found" style="-fx-text-fill: #7f8c8d;"/>
                        </placeholder>
                    </TableView>

                    <Pagination fx:id="reviewsPagination" pageCount="1" maxPageIndicatorCount="5"/>

                    <HBox spacing="10">
                        <Button fx:id="refreshButton" text="Refresh" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
                        <Button fx:id="writeReviewButton" text="Write Review" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;">
                            <effect>
                                <DropShadow radius="3" color="rgba(0,0,0,0.2)"/>
                            </effect>
                        </Button>
                        <Button fx:id="fadeButton" text="Animate" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
                    </HBox>
                </VBox>

                <VBox spacing="15" style="-fx-padding: 10;">
                    <Label text="Write a Review" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

                    <ProgressBar fx:id="operationProgress" prefWidth="Infinity" progress="0" visible="false"/>

                    <GridPane hgap="10" vgap="10">
                        <Label text="Workshop:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                        <ComboBox fx:id="workshopComboBox" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="250"/>
                    </GridPane>

                    <Label text="Rating:" style="-fx-font-weight: bold;"/>
                    <HBox spacing="15">
                        <RadioButton fx:id="rating1Radio" text="⭐ 1 Star">
                            <toggleGroup><ToggleGroup fx:id="ratingGroup"/></toggleGroup>
                        </RadioButton>
                        <RadioButton fx:id="rating2Radio" text="⭐⭐ 2 Stars" toggleGroup="$ratingGroup"/>
                        <RadioButton fx:id="rating3Radio" text="⭐⭐⭐ 3 Stars" toggleGroup="$ratingGroup"/>
                        <RadioButton fx:id="rating4Radio" text="⭐⭐⭐⭐ 4 Stars" toggleGroup="$ratingGroup"/>
                        <RadioButton fx:id="rating5Radio" text="⭐⭐⭐⭐⭐ 5 Stars" toggleGroup="$ratingGroup" selected="true"/>
                    </HBox>

                    <Label text="Review:" style="-fx-font-weight: bold;"/>
                    <TextArea fx:id="reviewTextArea" prefHeight="120" promptText="Share your experience with this workshop..."/>

                    <HBox spacing="10">
                        <Button fx:id="submitButton" text="Submit Review" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-pref-width: 120;">
                            <effect>
                                <DropShadow radius="3" color="rgba(0,0,0,0.2)"/>
                            </effect>
                        </Button>
                        <Button fx:id="editButton" text="Edit Review" style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-pref-width: 100;" visible="false"/>
                        <Button fx:id="deleteButton" text="Delete Review" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-pref-width: 100;" visible="false"/>
                        <Button fx:id="clearButton" text="Clear" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-pref-width: 80;"/>
                    </HBox>

                    <Label fx:id="statusLabel" style="-fx-text-fill: #7f8c8d; -fx-font-style: italic;"/>
                </VBox>
            </SplitPane>
        </ScrollPane>
    </center>

    <bottom>
        <HBox spacing="10" style="-fx-padding: 10;" alignment="CENTER_RIGHT">
            <Button fx:id="backButton" text="Back to Dashboard" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-pref-width: 150;"/>
        </HBox>
        <fx:include source="FooterComponent.fxml"/>
    </bottom>
</BorderPane>