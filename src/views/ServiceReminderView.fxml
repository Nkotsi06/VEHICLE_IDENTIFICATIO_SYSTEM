<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ServiceReminderController">

    <top>
        <VBox>
            <fx:include source="MenuBarComponent.fxml"/>
        </VBox>
    </top>

    <center>
        <SplitPane dividerPositions="0.55">
            <VBox spacing="10" style="-fx-padding: 10;">
                <Label text="Service Reminders" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                <TableView fx:id="remindersTable">
                    <columns>
                        <TableColumn fx:id="vehicleColumn" text="Vehicle"/>
                        <TableColumn fx:id="serviceTypeColumn" text="Service Type"/>
                        <TableColumn fx:id="dueDateColumn" text="Due Date"/>
                        <TableColumn fx:id="statusColumn" text="Status"/>
                    </columns>
                </TableView>
                <HBox spacing="10">
                    <Button fx:id="refreshButton" text="Refresh"/>
                    <Button fx:id="sendRemindersButton" text="Send Reminders" style="-fx-background-color: #27ae60; -fx-text-fill: white;"/>
                </HBox>
            </VBox>

            <VBox spacing="15" style="-fx-padding: 10;">
                <Label text="Add Reminder" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

                <GridPane hgap="10" vgap="10">
                    <Label text="Vehicle:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="vehicleComboBox" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="Service Type:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <TextField fx:id="serviceTypeField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <Label text="Due Date:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <DatePicker fx:id="dueDatePicker" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                    <Label text="Due Odometer (km):" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <TextField fx:id="dueOdometerField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                </GridPane>

                <Button fx:id="addButton" text="Add Reminder" style="-fx-background-color: #27ae60; -fx-text-fill: white;"/>
            </VBox>
        </SplitPane>
    </center>

    <bottom>
        <HBox spacing="10" style="-fx-padding: 10;" alignment="CENTER_RIGHT">
            <Button fx:id="backButton" text="Back"/>
        </HBox>
        <fx:include source="FooterComponent.fxml"/>
    </bottom>
</BorderPane>