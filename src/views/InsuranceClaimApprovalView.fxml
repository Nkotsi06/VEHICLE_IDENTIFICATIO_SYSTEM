<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.InsuranceClaimApprovalController"
            stylesheets="@../css/application.css" styleClass="border-pane">

    <top>
        <fx:include source="MenuBarComponent.fxml"/>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="false" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
            <VBox spacing="20" alignment="TOP_CENTER" styleClass="dashboard-container">
                <padding>
                    <Insets top="25" right="40" bottom="30" left="40"/>
                </padding>

                <Label text="Claim Approval" styleClass="label-title" alignment="CENTER" maxWidth="Infinity"/>
                <Label text="Review and process insurance claims" styleClass="label-subtitle" alignment="CENTER" maxWidth="Infinity"/>

                <Separator/>

                <HBox spacing="25" alignment="CENTER" fillHeight="true">
                    <!-- Left Panel - Pending Claims -->
                    <VBox spacing="15" alignment="CENTER" HBox.hgrow="ALWAYS" prefWidth="550">
                        <VBox styleClass="profile-edit-card" alignment="CENTER" prefWidth="550">
                            <Label text="Pending Claims" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>

                            <ProgressIndicator fx:id="loadProgress" visible="false" maxWidth="30"/>

                            <TableView fx:id="pendingClaimsTable" prefHeight="450" maxWidth="Infinity">
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                </columnResizePolicy>
                                <columns>
                                    <TableColumn fx:id="claimIdColumn" text="Claim ID" prefWidth="80"/>
                                    <TableColumn fx:id="policyNumberColumn" text="Policy #" prefWidth="110"/>
                                    <TableColumn fx:id="vehicleColumn" text="Vehicle" prefWidth="140"/>
                                    <TableColumn fx:id="claimAmountColumn" text="Amount (M)" prefWidth="110"/>
                                    <TableColumn fx:id="claimDateColumn" text="Claim Date" prefWidth="100"/>
                                    <TableColumn fx:id="priorityColumn" text="Priority" prefWidth="80"/>
                                </columns>
                                <placeholder>
                                    <Label text="No pending claims" styleClass="status-text"/>
                                </placeholder>
                            </TableView>

                            <HBox alignment="CENTER">
                                <Pagination fx:id="claimsPagination" pageCount="1" maxPageIndicatorCount="5"/>
                            </HBox>

                            <HBox alignment="CENTER" spacing="15">
                                <Button fx:id="refreshButton" text="Refresh" styleClass="button-info" prefWidth="100"/>
                                <Button fx:id="fadeButton" text="Animate" styleClass="button-warning" prefWidth="100"/>
                            </HBox>
                        </VBox>
                    </VBox>

                    <!-- Right Panel - Claim Review -->
                    <VBox spacing="15" alignment="CENTER" HBox.hgrow="ALWAYS" prefWidth="450">
                        <VBox styleClass="profile-edit-card" alignment="CENTER" prefWidth="450">
                            <Label text="Claim Review" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>

                            <ProgressBar fx:id="operationProgress" prefWidth="Infinity" progress="0" visible="false"/>

                            <TitledPane text="Claim Details" expanded="true">
                                <GridPane hgap="15" vgap="8" alignment="CENTER">
                                    <columnConstraints>
                                        <ColumnConstraints halignment="RIGHT" minWidth="100" prefWidth="100"/>
                                        <ColumnConstraints minWidth="200" hgrow="ALWAYS"/>
                                    </columnConstraints>
                                    <Label text="Claim ID:" style="-fx-font-weight: bold;" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                    <Label fx:id="claimIdLabel" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                                    <Label text="Policy Holder:" style="-fx-font-weight: bold;" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                    <Label fx:id="policyHolderLabel" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                                    <Label text="Incident Date:" style="-fx-font-weight: bold;" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                                    <Label fx:id="incidentDateLabel" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                                    <Label text="Incident Location:" style="-fx-font-weight: bold;" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                                    <Label fx:id="incidentLocationLabel" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                                </GridPane>
                            </TitledPane>

                            <Label text="Claim Description:" style="-fx-font-weight: bold;" alignment="CENTER" maxWidth="Infinity"/>
                            <TextArea fx:id="descriptionArea" prefHeight="80" editable="false"/>

                            <Label text="Supporting Documents:" style="-fx-font-weight: bold;" alignment="CENTER" maxWidth="Infinity"/>
                            <ListView fx:id="documentsList" prefHeight="80" maxWidth="Infinity"/>

                            <Separator/>

                            <GridPane hgap="15" vgap="12" alignment="CENTER">
                                <columnConstraints>
                                    <ColumnConstraints halignment="RIGHT" minWidth="120" prefWidth="120"/>
                                    <ColumnConstraints minWidth="200" hgrow="ALWAYS"/>
                                </columnConstraints>
                                <Label text="Approved Amount (M):" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <TextField fx:id="approvedAmountField" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="150"/>

                                <Label text="Rejection Reason:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <TextArea fx:id="rejectionReasonArea" GridPane.rowIndex="1" GridPane.columnIndex="1" prefHeight="60"/>
                            </GridPane>

                            <HBox alignment="CENTER" spacing="15">
                                <Button fx:id="approveButton" text="Approve Claim" styleClass="button-success" prefWidth="120"/>
                                <Button fx:id="rejectButton" text="Reject Claim" styleClass="button-danger" prefWidth="120"/>
                                <Button fx:id="requestInfoButton" text="Request Info" styleClass="button-warning" prefWidth="110"/>
                            </HBox>

                            <Label fx:id="statusLabel" styleClass="status-text" alignment="CENTER" maxWidth="Infinity"/>
                        </VBox>
                    </VBox>
                </HBox>

                <HBox alignment="CENTER">
                    <Button fx:id="backButton" text="Back to Dashboard" styleClass="button-secondary" prefWidth="150"/>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <fx:include source="FooterComponent.fxml"/>
    </bottom>
</BorderPane>