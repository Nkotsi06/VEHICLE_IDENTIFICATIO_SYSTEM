<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<StackPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.WorkshopRegistrationController" style="-fx-background-color: #2c3e50;">
    <VBox spacing="20" maxWidth="500" style="-fx-background-color: #ffffff; -fx-background-radius: 10;">
        <padding>
            <Insets top="30" right="30" bottom="30" left="30"/>
        </padding>

        <Label text="Workshop Registration" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
        <Label text="Register your workshop to start servicing vehicles" style="-fx-font-size: 13px; -fx-text-fill: #7f8c8d;"/>

        <Separator/>

        <Label text="Account Information" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
        <TextField fx:id="usernameField" promptText="Username"/>
        <PasswordField fx:id="passwordField" promptText="Password"/>
        <PasswordField fx:id="confirmPasswordField" promptText="Confirm Password"/>
        <TextField fx:id="emailField" promptText="Email Address"/>
        <TextField fx:id="fullNameField" promptText="Contact Person Name"/>

        <Label text="Workshop Information" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
        <TextField fx:id="workshopNameField" promptText="Workshop Name"/>
        <TextField fx:id="addressField" promptText="Address"/>
        <TextField fx:id="phoneField" promptText="Phone Number"/>
        <TextField fx:id="licenseNumberField" promptText="License Number"/>

        <Label fx:id="statusLabel" style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;"/>

        <HBox spacing="10" alignment="CENTER">
            <Button fx:id="registerButton" text="Register" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-pref-width: 120;"/>
            <Button fx:id="cancelButton" text="Cancel" style="-fx-background-color: #7f8c8d; -fx-text-fill: white; -fx-pref-width: 120;"/>
        </HBox>

        <Label text="Note: Your account will need admin approval before you can access the system." style="-fx-text-fill: #e74c3c; -fx-font-size: 11px; -fx-wrap-text: true;"/>
    </VBox>
</StackPane>