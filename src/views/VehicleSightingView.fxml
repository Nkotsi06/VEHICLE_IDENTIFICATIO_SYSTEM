<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.VehicleSightingController"
            stylesheets="@../css/application.css" styleClass="border-pane">

    <top>
        <fx:include source="MenuBarComponent.fxml"/>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="false" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
            <VBox spacing="20" alignment="TOP_CENTER" styleClass="dashboard-container">
                <padding>
                    <Insets top="25" right="40" bottom="30" left="40"/>
                </padding>

                <Label text="Vehicle Sightings" styleClass="label-title" alignment="CENTER" maxWidth="Infinity"/>
                <Label text="Track and record vehicle sightings from various sources" styleClass="label-subtitle" alignment="CENTER" maxWidth="Infinity"/>

                <Separator/>

                <HBox spacing="25" alignment="CENTER" fillHeight="true">
                    <!-- Left Panel - Sightings List -->
                    <VBox spacing="15" alignment="CENTER" HBox.hgrow="ALWAYS" prefWidth="550">
                        <VBox styleClass="profile-edit-card" alignment="CENTER" prefWidth="550">
                            <Label text="Vehicle Sightings" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>

                            <ProgressIndicator fx:id="loadProgress" visible="false" maxWidth="30"/>

                            <TableView fx:id="sightingsTable" prefHeight="450" minHeight="400" maxWidth="Infinity">
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                </columnResizePolicy>
                                <columns>
                                    <TableColumn fx:id="timestampColumn" text="Timestamp" minWidth="120" maxWidth="160"/>
                                    <TableColumn fx:id="vehicleColumn" text="Vehicle" minWidth="100" maxWidth="130"/>
                                    <TableColumn fx:id="sourceColumn" text="Source" minWidth="100" maxWidth="130"/>
                                    <TableColumn fx:id="confidenceColumn" text="Confidence" minWidth="70" maxWidth="90"/>
                                    <TableColumn fx:id="locationColumn" text="Location" minWidth="140" maxWidth="200"/>
                                </columns>
                                <placeholder>
                                    <Label text="No sightings recorded" styleClass="status-text"/>
                                </placeholder>
                            </TableView>

                            <HBox alignment="CENTER" spacing="15">
                                <Button fx:id="refreshButton" text="Refresh" styleClass="button-info" prefWidth="100"/>
                                <Button fx:id="mapViewButton" text="View on Map" styleClass="button-primary" prefWidth="110"/>
                                <Button fx:id="fadeButton" text="Animate" styleClass="button-warning" prefWidth="100"/>
                            </HBox>
                        </VBox>
                    </VBox>

                    <!-- Right Panel - Add Sighting -->
                    <VBox spacing="15" alignment="CENTER" HBox.hgrow="ALWAYS" prefWidth="450">
                        <VBox styleClass="profile-edit-card" alignment="CENTER" prefWidth="450">
                            <Label text="Add Sighting" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>

                            <GridPane hgap="15" vgap="12" alignment="CENTER">
                                <columnConstraints>
                                    <ColumnConstraints halignment="RIGHT" minWidth="100" prefWidth="100"/>
                                    <ColumnConstraints minWidth="250" hgrow="ALWAYS"/>
                                </columnConstraints>

                                <Label text="License Plate:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <TextField fx:id="licensePlateField" GridPane.rowIndex="0" GridPane.columnIndex="1" promptText="Enter license plate"/>

                                <Label text="Source Type:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <ComboBox fx:id="sourceTypeComboBox" GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="250"/>

                                <Label text="Device ID:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <TextField fx:id="cameraIdField" GridPane.rowIndex="2" GridPane.columnIndex="1" promptText="Camera or device ID"/>

                                <Label text="Latitude:" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <TextField fx:id="latitudeField" GridPane.rowIndex="3" GridPane.columnIndex="1" promptText="Latitude"/>

                                <Label text="Longitude:" GridPane.rowIndex="4" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <TextField fx:id="longitudeField" GridPane.rowIndex="4" GridPane.columnIndex="1" promptText="Longitude"/>

                                <Label text="Date:" GridPane.rowIndex="5" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <DatePicker fx:id="sightingDatePicker" GridPane.rowIndex="5" GridPane.columnIndex="1" prefWidth="200"/>
                            </GridPane>

                            <Button fx:id="addButton" text="Add Sighting" styleClass="button-success" prefWidth="130"/>

                            <Separator/>

                            <Label text="Search by Plate" style="-fx-font-size: 14px; -fx-font-weight: bold;" alignment="CENTER" maxWidth="Infinity"/>
                            <HBox alignment="CENTER" spacing="15">
                                <TextField fx:id="searchPlateField" promptText="License plate" HBox.hgrow="ALWAYS"/>
                                <Button fx:id="searchButton" text="Search" styleClass="button-primary" prefWidth="100"/>
                            </HBox>

                            <Label fx:id="statusLabel" styleClass="status-text" alignment="CENTER" maxWidth="Infinity"/>
                        </VBox>
                    </VBox>
                </HBox>

                <HBox alignment="CENTER">
                    <Button fx:id="backButton" text="Back to Dashboard" styleClass="button-secondary" prefWidth="150"/>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <fx:include source="FooterComponent.fxml"/>
    </bottom>
</BorderPane>