<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.WorkshopProfileController"
            stylesheets="@../css/application.css" styleClass="border-pane">

    <top>
        <fx:include source="MenuBarComponent.fxml"/>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="false" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
            <VBox spacing="20" alignment="TOP_CENTER" styleClass="dashboard-container">
                <padding>
                    <Insets top="25" right="40" bottom="30" left="40"/>
                </padding>

                <TabPane maxWidth="Infinity" styleClass="centered-tab-pane" tabClosingPolicy="UNAVAILABLE">

                    <!-- Profile Tab -->
                    <Tab text="Profile" closable="false">
                        <VBox spacing="20" alignment="TOP_CENTER" style="-fx-padding: 20;">

                            <Label text="Workshop Profile" styleClass="label-title" alignment="CENTER" maxWidth="Infinity"/>
                            <Label text="View and update your workshop information" styleClass="label-subtitle" alignment="CENTER" maxWidth="Infinity"/>

                            <Separator/>

                            <ProgressIndicator fx:id="loadProgress" visible="false" maxWidth="40"/>

                            <HBox spacing="30" alignment="CENTER">
                                <!-- Logo Column -->
                                <VBox spacing="10" alignment="CENTER">
                                    <ImageView fx:id="logoImageView" fitHeight="120" fitWidth="120" styleClass="profile-image-circle"/>
                                    <Button fx:id="uploadLogoButton" text="Change Logo" styleClass="button-info" prefWidth="120"/>
                                </VBox>

                                <!-- Profile Information Column -->
                                <VBox spacing="15" HBox.hgrow="ALWAYS">
                                    <GridPane hgap="15" vgap="12" alignment="CENTER">
                                        <columnConstraints>
                                            <ColumnConstraints halignment="RIGHT" minWidth="120" prefWidth="120"/>
                                            <ColumnConstraints minWidth="250" hgrow="ALWAYS"/>
                                        </columnConstraints>

                                        <Label text="Workshop Name:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                        <TextField fx:id="workshopNameField" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="300"/>

                                        <Label text="Address:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                        <TextField fx:id="addressField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                                        <Label text="Phone:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                        <TextField fx:id="phoneField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                                        <Label text="Email:" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                        <TextField fx:id="emailField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                                        <Label text="License Number:" GridPane.rowIndex="4" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                        <TextField fx:id="licenseNumberField" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                                        <Label text="Operating Hours:" GridPane.rowIndex="5" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                        <TextField fx:id="hoursField" GridPane.rowIndex="5" GridPane.columnIndex="1" promptText="Mon-Fri: 8am-5pm"/>
                                    </GridPane>
                                </VBox>
                            </HBox>

                            <HBox alignment="CENTER">
                                <Label text="Approval Status:" style="-fx-font-weight: bold;"/>
                                <Label fx:id="approvalStatusLabel" style="-fx-text-fill: #f39c12; -fx-font-weight: bold;"/>
                            </HBox>

                            <ProgressBar fx:id="operationProgress" prefWidth="Infinity" progress="0" visible="false"/>

                            <Separator/>

                            <Label text="Statistics" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>

                            <GridPane hgap="25" vgap="10" alignment="CENTER">
                                <columnConstraints>
                                    <ColumnConstraints halignment="RIGHT" minWidth="120" prefWidth="120"/>
                                    <ColumnConstraints minWidth="150" hgrow="ALWAYS"/>
                                    <ColumnConstraints halignment="RIGHT" minWidth="120" prefWidth="120"/>
                                    <ColumnConstraints minWidth="150" hgrow="ALWAYS"/>
                                </columnConstraints>

                                <Label text="Total Services:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <Label fx:id="totalServicesStatLabel" GridPane.rowIndex="0" GridPane.columnIndex="1" style="-fx-text-fill: #27ae60; -fx-font-size: 18px; -fx-font-weight: bold;"/>

                                <Label text="Total Revenue:" GridPane.rowIndex="0" GridPane.columnIndex="2" style="-fx-font-weight: bold;"/>
                                <Label fx:id="totalRevenueStatLabel" GridPane.rowIndex="0" GridPane.columnIndex="3" style="-fx-text-fill: #2980b9; -fx-font-size: 18px; -fx-font-weight: bold;"/>

                                <Label text="Active Mechanics:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <Label fx:id="activeMechanicsStatLabel" GridPane.rowIndex="1" GridPane.columnIndex="1" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

                                <Label text="Customer Rating:" GridPane.rowIndex="1" GridPane.columnIndex="2" style="-fx-font-weight: bold;"/>
                                <ProgressBar fx:id="ratingProgress" prefWidth="150" progress="0"/>
                                <Label fx:id="ratingLabel" GridPane.rowIndex="1" GridPane.columnIndex="3" style="-fx-text-fill: #f39c12;"/>
                            </GridPane>

                            <Separator/>

                            <HBox alignment="CENTER_RIGHT" spacing="15">
                                <Button fx:id="updateProfileButton" text="Update Profile" styleClass="button-success" prefWidth="130"/>
                                <Button fx:id="cancelButton" text="Cancel" styleClass="button-secondary" prefWidth="100"/>
                                <Button fx:id="backButton" text="Back to Dashboard" styleClass="button-primary" prefWidth="160"/>
                            </HBox>

                            <Label fx:id="statusLabel" styleClass="status-text" alignment="CENTER" maxWidth="Infinity"/>
                        </VBox>
                    </Tab>

                    <!-- Change Password Tab -->
                    <Tab text="Change Password" closable="false">
                        <VBox spacing="20" alignment="TOP_CENTER" style="-fx-padding: 25;">
                            <Label text="Change Password" styleClass="label-title" alignment="CENTER" maxWidth="Infinity"/>

                            <Separator/>

                            <GridPane hgap="15" vgap="12" alignment="CENTER">
                                <columnConstraints>
                                    <ColumnConstraints halignment="RIGHT" minWidth="120" prefWidth="120"/>
                                    <ColumnConstraints minWidth="250" hgrow="ALWAYS"/>
                                </columnConstraints>

                                <Label text="Current Password:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <PasswordField fx:id="currentPasswordField" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="250"/>

                                <Label text="New Password:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <PasswordField fx:id="newPasswordField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                                <Label text="Confirm Password:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <PasswordField fx:id="confirmPasswordField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                            </GridPane>

                            <HBox alignment="CENTER">
                                <Button fx:id="changePasswordButton" text="Change Password" styleClass="button-warning" prefWidth="160"/>
                            </HBox>

                            <Label fx:id="passwordStatusLabel" styleClass="status-text" alignment="CENTER" maxWidth="Infinity"/>
                        </VBox>
                    </Tab>
                </TabPane>

            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <fx:include source="FooterComponent.fxml"/>
    </bottom>
</BorderPane>