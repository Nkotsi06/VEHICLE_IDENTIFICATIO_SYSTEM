<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ClaimStatusTrackerController">

    <top>
        <VBox>
            <fx:include source="MenuBarComponent.fxml"/>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true">
            <VBox spacing="20" style="-fx-padding: 20;">
                <Label text="Claim Status Tracker" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <Label text="Track and monitor insurance claim progress" style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;"/>

                <Separator/>

                <ProgressIndicator fx:id="loadProgress" visible="false" maxWidth="40"/>

                <TitledPane text="Search & Filter" expanded="true" style="-fx-font-weight: bold;">
                    <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-padding: 10;">
                        <Label text="Filter by Status:" style="-fx-font-weight: bold;"/>
                        <ComboBox fx:id="statusFilterComboBox" prefWidth="150">
                            <items>
                                <FXCollections fx:factory="observableArrayList">
                                    <String fx:value="All"/>
                                    <String fx:value="PENDING"/>
                                    <String fx:value="UNDER REVIEW"/>
                                    <String fx:value="APPROVED"/>
                                    <String fx:value="REJECTED"/>
                                    <String fx:value="PAID"/>
                                </FXCollections>
                            </items>
                        </ComboBox>
                        <Label text="Claim ID:" style="-fx-font-weight: bold;"/>
                        <TextField fx:id="claimIdField" promptText="Enter Claim ID" prefWidth="150"/>
                        <Button fx:id="searchButton" text="Search" style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;">
                            <effect>
                                <DropShadow radius="3" color="rgba(0,0,0,0.2)"/>
                            </effect>
                        </Button>
                        <Button fx:id="refreshButton" text="Refresh" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
                        <Button fx:id="fadeButton" text="Animate" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
                    </HBox>
                </TitledPane>

                <ProgressBar fx:id="operationProgress" prefWidth="Infinity" progress="0" visible="false"/>

                <TableView fx:id="claimsTable" prefHeight="300">
                    <columns>
                        <TableColumn fx:id="claimIdColumn" text="Claim ID" prefWidth="80"/>
                        <TableColumn fx:id="policyNumberColumn" text="Policy #" prefWidth="120"/>
                        <TableColumn fx:id="vehicleColumn" text="Vehicle" prefWidth="150"/>
                        <TableColumn fx:id="amountColumn" text="Amount (M)" prefWidth="120"/>
                        <TableColumn fx:id="claimStatusColumn" text="Status" prefWidth="100"/>
                        <TableColumn fx:id="dateColumn" text="Date" prefWidth="120"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                    <placeholder>
                        <Label text="No claims found" style="-fx-text-fill: #7f8c8d;"/>
                    </placeholder>
                </TableView>

                <Pagination fx:id="claimsPagination" pageCount="1" maxPageIndicatorCount="10"/>

                <Separator/>

                <TitledPane text="Claim Details & Timeline" expanded="true" style="-fx-font-weight: bold;">
                    <VBox spacing="15" style="-fx-padding: 15;">
                        <GridPane hgap="20" vgap="10" style="-fx-background-color: #f8f9fa; -fx-padding: 15; -fx-border-radius: 8;">
                            <Label text="Claim ID:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <Label fx:id="selectedClaimIdLabel" GridPane.rowIndex="0" GridPane.columnIndex="1" style="-fx-text-fill: #2c3e50;"/>

                            <Label text="Status:" GridPane.rowIndex="0" GridPane.columnIndex="2" style="-fx-font-weight: bold;"/>
                            <Label fx:id="selectedClaimStatusLabel" GridPane.rowIndex="0" GridPane.columnIndex="3" style="-fx-font-weight: bold;"/>

                            <Label text="Amount Claimed:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <Label fx:id="selectedClaimAmountLabel" GridPane.rowIndex="1" GridPane.columnIndex="1" style="-fx-text-fill: #27ae60; -fx-font-weight: bold;"/>

                            <Label text="Amount Approved:" GridPane.rowIndex="1" GridPane.columnIndex="2" style="-fx-font-weight: bold;"/>
                            <Label fx:id="approvedAmountLabel" GridPane.rowIndex="1" GridPane.columnIndex="3" style="-fx-text-fill: #2980b9; -fx-font-weight: bold;"/>

                            <Label text="Claim Date:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <Label fx:id="selectedClaimDateLabel" GridPane.rowIndex="2" GridPane.columnIndex="1" style="-fx-text-fill: #7f8c8d;"/>

                            <Label text="Last Updated:" GridPane.rowIndex="2" GridPane.columnIndex="2" style="-fx-font-weight: bold;"/>
                            <Label fx:id="lastUpdatedLabel" GridPane.rowIndex="2" GridPane.columnIndex="3" style="-fx-text-fill: #7f8c8d;"/>
                        </GridPane>

                        <Label text="Progress Timeline" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                        <ProgressBar fx:id="statusProgressBar" prefWidth="Infinity" progress="0"/>
                        <Label fx:id="progressLabel" style="-fx-text-fill: #7f8c8d;"/>

                        <Label text="Status History" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                        <ListView fx:id="statusHistoryList" prefHeight="120"/>
                    </VBox>
                </TitledPane>

                <HBox spacing="15" alignment="CENTER">
                    <Button fx:id="trackButton" text="Track Selected" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-pref-width: 150;">
                        <effect>
                            <DropShadow radius="3" color="rgba(0,0,0,0.2)"/>
                        </effect>
                    </Button>
                </HBox>

                <Label fx:id="statusLabel" style="-fx-text-fill: #7f8c8d; -fx-font-style: italic;"/>
            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <HBox spacing="10" style="-fx-padding: 10;" alignment="CENTER_RIGHT">
            <Button fx:id="backButton" text="Back to Dashboard" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-pref-width: 150;"/>
        </HBox>
        <fx:include source="FooterComponent.fxml"/>
    </bottom>
</BorderPane>