<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.InsuranceProvidersController"
            stylesheets="@../css/application.css" styleClass="border-pane">

    <top>
        <fx:include source="MenuBarComponent.fxml"/>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="false" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
            <VBox spacing="20" alignment="TOP_CENTER" styleClass="dashboard-container">
                <padding>
                    <Insets top="25" right="40" bottom="30" left="40"/>
                </padding>

                <Label text="Insurance Providers" styleClass="label-title" alignment="CENTER" maxWidth="Infinity"/>
                <Label text="Manage insurance provider companies" styleClass="label-subtitle" alignment="CENTER" maxWidth="Infinity"/>

                <Separator/>

                <HBox spacing="25" alignment="CENTER" fillHeight="true">
                    <!-- Left Panel - Providers List -->
                    <VBox spacing="15" alignment="CENTER" HBox.hgrow="ALWAYS" prefWidth="500">
                        <VBox styleClass="profile-edit-card" alignment="CENTER" prefWidth="500">
                            <Label text="Insurance Providers" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>

                            <ProgressIndicator fx:id="loadProgress" visible="false" maxWidth="30"/>

                            <TableView fx:id="providersTable" prefHeight="450" maxWidth="Infinity">
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                </columnResizePolicy>
                                <columns>
                                    <TableColumn fx:id="nameColumn" text="Provider Name" prefWidth="170"/>
                                    <TableColumn fx:id="ratingColumn" text="Rating" prefWidth="70"/>
                                    <TableColumn fx:id="phoneColumn" text="Phone" prefWidth="120"/>
                                    <TableColumn fx:id="emailColumn" text="Email" prefWidth="180"/>
                                    <TableColumn fx:id="providerStatusColumn" text="Status" prefWidth="90"/>
                                </columns>
                                <placeholder>
                                    <Label text="No insurance providers found" styleClass="status-text"/>
                                </placeholder>
                            </TableView>

                            <HBox alignment="CENTER">
                                <Pagination fx:id="providersPagination" pageCount="1" maxPageIndicatorCount="5"/>
                            </HBox>

                            <ProgressBar fx:id="operationProgress" prefWidth="Infinity" progress="0" visible="false"/>

                            <HBox alignment="CENTER" spacing="15">
                                <Button fx:id="addButton" text="Add Provider" styleClass="button-success" prefWidth="110"/>
                                <Button fx:id="editButton" text="Edit Provider" styleClass="button-info" prefWidth="110"/>
                                <Button fx:id="deleteButton" text="Delete Provider" styleClass="button-danger" prefWidth="120"/>
                                <Button fx:id="refreshButton" text="Refresh" styleClass="button-info" prefWidth="100"/>
                                <Button fx:id="fadeButton" text="Animate" styleClass="button-warning" prefWidth="100"/>
                            </HBox>
                        </VBox>
                    </VBox>

                    <!-- Right Panel - Provider Details -->
                    <VBox spacing="15" alignment="CENTER" HBox.hgrow="ALWAYS" prefWidth="500">
                        <VBox styleClass="profile-edit-card" alignment="CENTER" prefWidth="500">
                            <Label text="Provider Details" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>

                            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" maxWidth="Infinity">
                                <VBox spacing="15" alignment="CENTER">
                                    <GridPane hgap="15" vgap="12" alignment="CENTER">
                                        <columnConstraints>
                                            <ColumnConstraints halignment="RIGHT" minWidth="120" prefWidth="120"/>
                                            <ColumnConstraints minWidth="250" hgrow="ALWAYS"/>
                                        </columnConstraints>

                                        <Label text="Provider Name:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                        <TextField fx:id="nameField" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="300" promptText="Enter provider name"/>

                                        <Label text="Registration #:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                        <TextField fx:id="registrationNumberField" GridPane.rowIndex="1" GridPane.columnIndex="1" promptText="Enter registration number"/>

                                        <Label text="License #:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                        <TextField fx:id="licenseNumberField" GridPane.rowIndex="2" GridPane.columnIndex="1" promptText="Enter license number"/>

                                        <Label text="Phone Number:" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                        <TextField fx:id="phoneField" GridPane.rowIndex="3" GridPane.columnIndex="1" promptText="Enter phone number"/>

                                        <Label text="Email:" GridPane.rowIndex="4" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                        <TextField fx:id="emailField" GridPane.rowIndex="4" GridPane.columnIndex="1" promptText="Enter email address"/>

                                        <Label text="Address:" GridPane.rowIndex="5" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                        <TextArea fx:id="addressField" GridPane.rowIndex="5" GridPane.columnIndex="1" prefHeight="60" wrapText="true" promptText="Enter physical address"/>

                                        <Label text="Rating:" GridPane.rowIndex="6" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                        <ComboBox fx:id="ratingComboBox" GridPane.rowIndex="6" GridPane.columnIndex="1" prefWidth="150" promptText="Select rating"/>

                                        <Label text="Status:" GridPane.rowIndex="7" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                        <ComboBox fx:id="statusComboBox" GridPane.rowIndex="7" GridPane.columnIndex="1" prefWidth="150" promptText="Select status"/>

                                        <Label text="Coverage Details:" GridPane.rowIndex="8" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                        <TextArea fx:id="coverageDetailsField" GridPane.rowIndex="8" GridPane.columnIndex="1" prefHeight="80" wrapText="true" promptText="Describe coverage details"/>
                                    </GridPane>

                                    <Separator/>

                                    <Label text="Provider Statistics" style="-fx-font-size: 14px; -fx-font-weight: bold;" alignment="CENTER" maxWidth="Infinity"/>

                                    <GridPane hgap="15" vgap="10" alignment="CENTER">
                                        <columnConstraints>
                                            <ColumnConstraints halignment="RIGHT" minWidth="120" prefWidth="120"/>
                                            <ColumnConstraints minWidth="200" hgrow="ALWAYS"/>
                                        </columnConstraints>
                                        <Label text="Total Policies:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                        <Label fx:id="totalPoliciesLabel" GridPane.rowIndex="0" GridPane.columnIndex="1" style="-fx-text-fill: #27ae60; -fx-font-weight: bold;"/>

                                        <Label text="Active Policies:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                        <Label fx:id="activePoliciesLabel" GridPane.rowIndex="1" GridPane.columnIndex="1" style="-fx-text-fill: #27ae60; -fx-font-weight: bold;"/>

                                        <Label text="Total Claims:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                        <Label fx:id="totalClaimsLabel" GridPane.rowIndex="2" GridPane.columnIndex="1" style="-fx-text-fill: #e67e22; -fx-font-weight: bold;"/>

                                        <Label text="Pending Claims:" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                        <Label fx:id="pendingClaimsLabel" GridPane.rowIndex="3" GridPane.columnIndex="1" style="-fx-text-fill: #e74c3c; -fx-font-weight: bold;"/>
                                    </GridPane>

                                    <HBox alignment="CENTER" spacing="15">
                                        <Button fx:id="saveButton" text="Add Provider" styleClass="button-success" prefWidth="130"/>
                                        <Button fx:id="clearButton" text="Clear Form" styleClass="button-secondary" prefWidth="100"/>
                                    </HBox>
                                </VBox>
                            </ScrollPane>

                            <Label fx:id="statusLabel" styleClass="status-text" alignment="CENTER" maxWidth="Infinity"/>
                        </VBox>
                    </VBox>
                </HBox>

                <HBox alignment="CENTER">
                    <Button fx:id="backButton" text="Back to Dashboard" styleClass="button-secondary" prefWidth="150"/>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <fx:include source="FooterComponent.fxml"/>
    </bottom>
</BorderPane>