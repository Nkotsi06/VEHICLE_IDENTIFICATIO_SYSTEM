<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.InsuranceProvidersController">

    <top>
        <VBox>
            <fx:include source="MenuBarComponent.fxml"/>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true">
            <SplitPane dividerPositions="0.6" style="-fx-background-color: #f4f6f9;">

                <VBox spacing="15" style="-fx-padding: 15;">
                    <Label text="Insurance Providers" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

                    <ProgressIndicator fx:id="loadProgress" visible="false" maxWidth="30"/>

                    <TableView fx:id="providersTable" prefHeight="400">
                        <columns>
                            <TableColumn fx:id="nameColumn" text="Provider Name" prefWidth="180"/>
                            <TableColumn fx:id="ratingColumn" text="Rating" prefWidth="80"/>
                            <TableColumn fx:id="phoneColumn" text="Phone" prefWidth="120"/>
                            <TableColumn fx:id="emailColumn" text="Email" prefWidth="180"/>
                            <TableColumn fx:id="providerStatusColumn" text="Status" prefWidth="80"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                        <placeholder>
                            <Label text="No insurance providers found" style="-fx-text-fill: #7f8c8d;"/>
                        </placeholder>
                    </TableView>

                    <Pagination fx:id="providersPagination" pageCount="1" maxPageIndicatorCount="5"/>

                    <ProgressBar fx:id="operationProgress" prefWidth="Infinity" progress="0" visible="false"/>

                    <HBox spacing="10">
                        <Button fx:id="addButton" text="Add Provider" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;">
                            <effect>
                                <DropShadow radius="3" color="rgba(0,0,0,0.2)"/>
                            </effect>
                        </Button>
                        <Button fx:id="editButton" text="Edit Provider" style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
                        <Button fx:id="deleteButton" text="Delete Provider" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
                        <Button fx:id="refreshButton" text="Refresh" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
                        <Button fx:id="fadeButton" text="Animate" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
                    </HBox>
                </VBox>

                <VBox spacing="15" style="-fx-padding: 15;">
                    <Label text="Provider Details" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

                    <Label fx:id="statusLabel" style="-fx-text-fill: #7f8c8d; -fx-font-style: italic;"/>

                    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
                        <VBox spacing="15">
                            <GridPane hgap="15" vgap="12">
                                <Label text="COMPANY INFORMATION" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #7f8c8d;" GridPane.rowIndex="0" GridPane.columnIndex="0" GridPane.columnSpan="3"/>

                                <Label text="Provider Name:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <TextField fx:id="nameField" GridPane.rowIndex="1" GridPane.columnIndex="1" GridPane.columnSpan="2" prefWidth="300" promptText="Enter provider name"/>

                                <Label text="Registration #:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <TextField fx:id="registrationNumberField" GridPane.rowIndex="2" GridPane.columnIndex="1" GridPane.columnSpan="2" promptText="Enter registration number"/>

                                <Label text="License #:" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <TextField fx:id="licenseNumberField" GridPane.rowIndex="3" GridPane.columnIndex="1" GridPane.columnSpan="2" promptText="Enter license number"/>

                                <Label text="CONTACT INFORMATION" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #7f8c8d;" GridPane.rowIndex="4" GridPane.columnIndex="0" GridPane.columnSpan="3"/>

                                <Label text="Phone Number:" GridPane.rowIndex="5" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <TextField fx:id="phoneField" GridPane.rowIndex="5" GridPane.columnIndex="1" GridPane.columnSpan="2" promptText="Enter phone number"/>

                                <Label text="Email:" GridPane.rowIndex="6" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <TextField fx:id="emailField" GridPane.rowIndex="6" GridPane.columnIndex="1" GridPane.columnSpan="2" promptText="Enter email address"/>

                                <Label text="Address:" GridPane.rowIndex="7" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <TextArea fx:id="addressField" GridPane.rowIndex="7" GridPane.columnIndex="1" GridPane.columnSpan="2" prefHeight="60" wrapText="true" promptText="Enter physical address"/>

                                <Label text="BUSINESS INFORMATION" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #7f8c8d;" GridPane.rowIndex="8" GridPane.columnIndex="0" GridPane.columnSpan="3"/>

                                <Label text="Rating:" GridPane.rowIndex="9" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <ComboBox fx:id="ratingComboBox" GridPane.rowIndex="9" GridPane.columnIndex="1" prefWidth="150" promptText="Select rating"/>

                                <Label text="Status:" GridPane.rowIndex="10" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <ComboBox fx:id="statusComboBox" GridPane.rowIndex="10" GridPane.columnIndex="1" prefWidth="150" promptText="Select status"/>

                                <Label text="Coverage Details:" GridPane.rowIndex="11" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <TextArea fx:id="coverageDetailsField" GridPane.rowIndex="11" GridPane.columnIndex="1" GridPane.columnSpan="2" prefHeight="80" wrapText="true" promptText="Describe coverage details"/>
                            </GridPane>

                            <Separator/>

                            <Label text="Provider Statistics" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

                            <GridPane hgap="15" vgap="10">
                                <Label text="Total Policies:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <Label fx:id="totalPoliciesLabel" GridPane.rowIndex="0" GridPane.columnIndex="1" style="-fx-text-fill: #27ae60; -fx-font-weight: bold;"/>

                                <Label text="Active Policies:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <Label fx:id="activePoliciesLabel" GridPane.rowIndex="1" GridPane.columnIndex="1" style="-fx-text-fill: #27ae60; -fx-font-weight: bold;"/>

                                <Label text="Total Claims:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <Label fx:id="totalClaimsLabel" GridPane.rowIndex="2" GridPane.columnIndex="1" style="-fx-text-fill: #e67e22; -fx-font-weight: bold;"/>

                                <Label text="Pending Claims:" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <Label fx:id="pendingClaimsLabel" GridPane.rowIndex="3" GridPane.columnIndex="1" style="-fx-text-fill: #e74c3c; -fx-font-weight: bold;"/>
                            </GridPane>

                            <HBox spacing="10" alignment="CENTER">
                                <Button fx:id="saveButton" text="Add Provider" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-pref-width: 120;">
                                    <effect>
                                        <DropShadow radius="3" color="rgba(0,0,0,0.2)"/>
                                    </effect>
                                </Button>
                                <Button fx:id="clearButton" text="Clear Form" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-pref-width: 100;"/>
                            </HBox>
                        </VBox>
                    </ScrollPane>
                </VBox>
            </SplitPane>
        </ScrollPane>
    </center>

    <bottom>
        <HBox spacing="10" style="-fx-padding: 10;" alignment="CENTER_RIGHT">
            <Button fx:id="backButton" text="Back to Dashboard" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-pref-width: 150;"/>
        </HBox>
        <fx:include source="FooterComponent.fxml"/>
    </bottom>
</BorderPane>