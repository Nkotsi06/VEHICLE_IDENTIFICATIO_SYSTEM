<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.*?>
<?import javafx.collections.FXCollections?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.PolicyRenewalController"
            stylesheets="@../css/application.css" styleClass="border-pane">

    <top>
        <fx:include source="MenuBarComponent.fxml"/>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="false" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    style="-fx-background-color: #f0f2f5; -fx-background: #f0f2f5;">
            <VBox spacing="20" alignment="TOP_CENTER"
                  style="-fx-background-color: #f0f2f5; -fx-padding: 25 40 30 40;">

                <Label text="Policy Renewals" styleClass="label-title" alignment="CENTER" maxWidth="Infinity"/>
                <Label text="Manage insurance policy renewals" styleClass="label-subtitle" alignment="CENTER" maxWidth="Infinity"/>

                <Separator/>

                <HBox spacing="20" alignment="CENTER">
                    <!-- Left Panel - Renewals List -->
                    <VBox spacing="10" alignment="CENTER" HBox.hgrow="ALWAYS">
                        <VBox styleClass="profile-edit-card" alignment="CENTER">
                            <Label text="Policy Renewals" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>

                            <ProgressIndicator fx:id="loadProgress" visible="false" maxWidth="30"/>

                            <TableView fx:id="renewalsTable" prefHeight="400" maxWidth="Infinity" columnResizePolicy="CONSTRAINED_RESIZE_POLICY">
                                <columns>
                                    <TableColumn fx:id="policyColumn" text="Policy Number" minWidth="120" maxWidth="160"/>
                                    <TableColumn fx:id="vehicleColumn" text="Vehicle" minWidth="120" maxWidth="160"/>
                                    <TableColumn fx:id="renewalDateColumn" text="Renewal Date" minWidth="100" maxWidth="130"/>
                                    <TableColumn fx:id="premiumColumn" text="Premium (M)" minWidth="90" maxWidth="110"/>
                                    <TableColumn fx:id="paymentStatusColumn" text="Payment Status" minWidth="90" maxWidth="110"/>
                                    <TableColumn fx:id="renewalStatusColumn" text="Status" minWidth="80" maxWidth="110"/>
                                </columns>
                                <placeholder>
                                    <Label text="No renewals found" styleClass="status-text"/>
                                </placeholder>
                            </TableView>

                            <HBox alignment="CENTER">
                                <Pagination fx:id="renewalsPagination" pageCount="1" maxPageIndicatorCount="5"/>
                            </HBox>

                            <HBox alignment="CENTER">
                                <Button fx:id="refreshButton" text="Refresh" styleClass="button-info"/>
                                <Button fx:id="fadeButton" text="Animate" styleClass="button-warning">
                                    <effect><DropShadow radius="3" color="rgba(0,0,0,0.2)"/></effect>
                                </Button>
                            </HBox>
                        </VBox>
                    </VBox>

                    <!-- Right Panel - Create Renewal -->
                    <VBox spacing="15" alignment="CENTER" HBox.hgrow="ALWAYS">
                        <VBox styleClass="profile-edit-card" alignment="CENTER">
                            <Label text="Create Renewal" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>

                            <ProgressBar fx:id="operationProgress" prefWidth="Infinity" progress="0" visible="false"/>

                            <GridPane hgap="10" vgap="10" alignment="CENTER">
                                <Label text="Policy:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <ComboBox fx:id="policyComboBox" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="250"/>

                                <Label text="Renewal Date:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <DatePicker fx:id="renewalDatePicker" GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="200"/>

                                <Label text="Premium Amount (M):" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <TextField fx:id="premiumField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                                <Label text="No Claim Bonus Applied:" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <Label fx:id="ncbLabel" GridPane.rowIndex="3" GridPane.columnIndex="1" style="-fx-text-fill: #27ae60; -fx-font-weight: bold;"/>

                                <Label text="Discounted Premium:" GridPane.rowIndex="4" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <Label fx:id="discountedPremiumLabel" GridPane.rowIndex="4" GridPane.columnIndex="1" style="-fx-text-fill: #2980b9; -fx-font-weight: bold;"/>
                            </GridPane>

                            <Label text="Payment Method:" style="-fx-font-weight: bold;" alignment="CENTER" maxWidth="Infinity"/>
                            <ComboBox fx:id="paymentMethodComboBox" prefWidth="200">
                                <items>
                                    <FXCollections fx:factory="observableArrayList">
                                        <String fx:value="Credit Card"/>
                                        <String fx:value="Debit Card"/>
                                        <String fx:value="Bank Transfer"/>
                                        <String fx:value="Digital Wallet"/>
                                        <String fx:value="Cash"/>
                                    </FXCollections>
                                </items>
                            </ComboBox>

                            <HBox alignment="CENTER">
                                <Button fx:id="createButton" text="Create Renewal" styleClass="button-success">
                                    <effect><DropShadow radius="3" color="rgba(0,0,0,0.2)"/></effect>
                                </Button>
                                <Button fx:id="processPaymentButton" text="Process Payment" styleClass="button-primary"/>
                                <Button fx:id="clearButton" text="Clear" styleClass="button-secondary"/>
                            </HBox>

                            <Separator/>

                            <Label text="Renewal Summary" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" alignment="CENTER" maxWidth="Infinity"/>
                            <TextArea fx:id="summaryArea" prefHeight="100" editable="false" promptText="Renewal summary will appear here..."/>

                            <Label fx:id="statusLabel" styleClass="status-text" alignment="CENTER" maxWidth="Infinity"/>
                        </VBox>
                    </VBox>
                </HBox>

                <HBox alignment="CENTER">
                    <Button fx:id="backButton" text="Back to Dashboard" styleClass="button-secondary" prefWidth="150"/>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <fx:include source="FooterComponent.fxml"/>
    </bottom>
</BorderPane>