<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.PolicyRenewalController">

    <top>
        <VBox>
            <fx:include source="MenuBarComponent.fxml"/>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true">
            <SplitPane dividerPositions="0.5">
                <VBox spacing="10" style="-fx-padding: 10;">
                    <Label text="Policy Renewals" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

                    <ProgressIndicator fx:id="loadProgress" visible="false" maxWidth="30"/>

                    <TableView fx:id="renewalsTable" prefHeight="400">
                        <columns>
                            <TableColumn fx:id="policyColumn" text="Policy Number" prefWidth="150"/>
                            <TableColumn fx:id="vehicleColumn" text="Vehicle" prefWidth="150"/>
                            <TableColumn fx:id="renewalDateColumn" text="Renewal Date" prefWidth="120"/>
                            <TableColumn fx:id="premiumColumn" text="Premium (M)" prefWidth="100"/>
                            <TableColumn fx:id="paymentStatusColumn" text="Payment Status" prefWidth="100"/>
                            <TableColumn fx:id="renewalStatusColumn" text="Status" prefWidth="100"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                        <placeholder>
                            <Label text="No renewals found" style="-fx-text-fill: #7f8c8d;"/>
                        </placeholder>
                    </TableView>

                    <Pagination fx:id="renewalsPagination" pageCount="1" maxPageIndicatorCount="5"/>

                    <HBox spacing="10">
                        <Button fx:id="refreshButton" text="Refresh" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
                        <Button fx:id="fadeButton" text="Animate" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;">
                            <effect>
                                <DropShadow radius="3" color="rgba(0,0,0,0.2)"/>
                            </effect>
                        </Button>
                    </HBox>
                </VBox>

                <VBox spacing="15" style="-fx-padding: 10;">
                    <Label text="Create Renewal" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

                    <ProgressBar fx:id="operationProgress" prefWidth="Infinity" progress="0" visible="false"/>

                    <GridPane hgap="10" vgap="10">
                        <Label text="Policy:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                        <ComboBox fx:id="policyComboBox" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="250"/>

                        <Label text="Renewal Date:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                        <DatePicker fx:id="renewalDatePicker" GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="200"/>

                        <Label text="Premium Amount (M):" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                        <TextField fx:id="premiumField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                        <Label text="No Claim Bonus Applied:" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                        <Label fx:id="ncbLabel" GridPane.rowIndex="3" GridPane.columnIndex="1" style="-fx-text-fill: #27ae60; -fx-font-weight: bold;"/>

                        <Label text="Discounted Premium:" GridPane.rowIndex="4" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                        <Label fx:id="discountedPremiumLabel" GridPane.rowIndex="4" GridPane.columnIndex="1" style="-fx-text-fill: #2980b9; -fx-font-weight: bold;"/>
                    </GridPane>

                    <Label text="Payment Method:" style="-fx-font-weight: bold;"/>
                    <ComboBox fx:id="paymentMethodComboBox" prefWidth="200">
                        <items>
                            <FXCollections fx:factory="observableArrayList">
                                <String fx:value="Credit Card"/>
                                <String fx:value="Debit Card"/>
                                <String fx:value="Bank Transfer"/>
                                <String fx:value="Digital Wallet"/>
                                <String fx:value="Cash"/>
                            </FXCollections>
                        </items>
                    </ComboBox>

                    <HBox spacing="10">
                        <Button fx:id="createButton" text="Create Renewal" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;">
                            <effect>
                                <DropShadow radius="3" color="rgba(0,0,0,0.2)"/>
                            </effect>
                        </Button>
                        <Button fx:id="processPaymentButton" text="Process Payment" style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
                        <Button fx:id="clearButton" text="Clear" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
                    </HBox>

                    <Separator/>

                    <Label text="Renewal Summary" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                    <TextArea fx:id="summaryArea" prefHeight="100" editable="false" promptText="Renewal summary will appear here..."/>

                    <Label fx:id="statusLabel" style="-fx-text-fill: #7f8c8d; -fx-font-style: italic;"/>
                </VBox>
            </SplitPane>
        </ScrollPane>
    </center>

    <bottom>
        <HBox spacing="10" style="-fx-padding: 10;" alignment="CENTER_RIGHT">
            <Button fx:id="backButton" text="Back to Dashboard" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-pref-width: 150;"/>
        </HBox>
        <fx:include source="FooterComponent.fxml"/>
    </bottom>
</BorderPane>