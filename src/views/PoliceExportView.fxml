<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.PoliceExportController">

    <top>
        <VBox>
            <fx:include source="MenuBarComponent.fxml"/>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true">
            <VBox spacing="20" style="-fx-padding: 20;">

                <Label text="Police Data Export" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <Label text="Export police-related data only" style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;"/>

                <Separator/>

                <ProgressIndicator fx:id="loadProgress" visible="false" maxWidth="40"/>

                <TitledPane text="Export Configuration" expanded="true" style="-fx-font-weight: bold;">
                    <GridPane hgap="15" vgap="15" style="-fx-padding: 15;">
                        <Label text="Export Type:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                        <ComboBox fx:id="exportTypeComboBox" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="250" promptText="Select data to export"/>

                        <Label text="Format:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                        <ComboBox fx:id="formatComboBox" GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="150"/>

                        <Label text="Start Date:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                        <DatePicker fx:id="startDatePicker" GridPane.rowIndex="2" GridPane.columnIndex="1" prefWidth="200"/>

                        <Label text="End Date:" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                        <DatePicker fx:id="endDatePicker" GridPane.rowIndex="3" GridPane.columnIndex="1" prefWidth="200"/>

                        <Label text="File Name:" GridPane.rowIndex="4" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                        <TextField fx:id="fileNameField" GridPane.rowIndex="4" GridPane.columnIndex="1" promptText="police_export"/>

                        <Button fx:id="fadeButton" text="Animate" GridPane.rowIndex="0" GridPane.columnIndex="2" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;">
                            <effect>
                                <DropShadow radius="3" color="rgba(0,0,0,0.2)"/>
                            </effect>
                        </Button>
                    </GridPane>
                </TitledPane>

                <ProgressBar fx:id="operationProgress" prefWidth="Infinity" progress="0" visible="false"/>

                <HBox spacing="15" alignment="CENTER">
                    <Button fx:id="exportButton" text="Export Data" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-pref-width: 150;">
                        <effect>
                            <DropShadow radius="3" color="rgba(0,0,0,0.2)"/>
                        </effect>
                    </Button>
                    <Button fx:id="previewButton" text="Preview" style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-pref-width: 100;"/>
                    <Button fx:id="clearButton" text="Clear" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-pref-width: 100;"/>
                </HBox>

                <TitledPane text="Export Preview" expanded="false" style="-fx-font-weight: bold;">
                    <TableView fx:id="previewTable" prefHeight="300">
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                        <placeholder>
                            <Label text="Click Preview to see data" style="-fx-text-fill: #7f8c8d;"/>
                        </placeholder>
                    </TableView>
                </TitledPane>

                <Label fx:id="statusLabel" style="-fx-text-fill: #7f8c8d; -fx-font-style: italic;"/>

                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <Button fx:id="backButton" text="Back to Dashboard" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-pref-width: 150;"/>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <fx:include source="FooterComponent.fxml"/>
    </bottom>
</BorderPane>