<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.PoliceExportController"
            stylesheets="@../css/application.css" styleClass="border-pane">

    <top>
        <fx:include source="MenuBarComponent.fxml"/>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="false" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
            <VBox spacing="20" alignment="TOP_CENTER" styleClass="dashboard-container">
                <padding>
                    <Insets top="25" right="40" bottom="30" left="40"/>
                </padding>

                <Label text="Police Data Export" styleClass="label-title" alignment="CENTER" maxWidth="Infinity"/>
                <Label text="Export police-related data only" styleClass="label-subtitle" alignment="CENTER" maxWidth="Infinity"/>

                <Separator/>

                <ProgressIndicator fx:id="loadProgress" visible="false" maxWidth="40"/>

                <!-- Export Configuration -->
                <HBox alignment="CENTER">
                    <VBox maxWidth="800" minWidth="550" styleClass="profile-edit-card" alignment="CENTER">
                        <Label text="Export Configuration" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>

                        <GridPane hgap="15" vgap="12" alignment="CENTER">
                            <columnConstraints>
                                <ColumnConstraints halignment="RIGHT" minWidth="120" prefWidth="120"/>
                                <ColumnConstraints minWidth="250" hgrow="ALWAYS"/>
                            </columnConstraints>

                            <Label text="Export Type:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <ComboBox fx:id="exportTypeComboBox" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="280" promptText="Select data to export"/>

                            <Label text="Format:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <ComboBox fx:id="formatComboBox" GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="200"/>

                            <Label text="Start Date:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <DatePicker fx:id="startDatePicker" GridPane.rowIndex="2" GridPane.columnIndex="1" prefWidth="200"/>

                            <Label text="End Date:" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <DatePicker fx:id="endDatePicker" GridPane.rowIndex="3" GridPane.columnIndex="1" prefWidth="200"/>

                            <Label text="File Name:" GridPane.rowIndex="4" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <TextField fx:id="fileNameField" GridPane.rowIndex="4" GridPane.columnIndex="1" promptText="police_export"/>
                        </GridPane>

                        <HBox alignment="CENTER">
                            <Button fx:id="fadeButton" text="Animate" styleClass="button-warning" prefWidth="100"/>
                        </HBox>
                    </VBox>
                </HBox>

                <ProgressBar fx:id="operationProgress" prefWidth="Infinity" progress="0" visible="false"/>

                <!-- Action Buttons -->
                <HBox alignment="CENTER" spacing="15">
                    <Button fx:id="exportButton" text="Export Data" styleClass="button-success" prefWidth="150"/>
                    <Button fx:id="previewButton" text="Preview" styleClass="button-info" prefWidth="100"/>
                    <Button fx:id="clearButton" text="Clear" styleClass="button-secondary" prefWidth="100"/>
                </HBox>

                <!-- Export Preview - FIXED: Added proper sizing constraints -->
                <VBox spacing="10" alignment="CENTER" VBox.vgrow="ALWAYS" styleClass="profile-edit-card">
                    <Label text="Export Preview" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>

                    <TableView fx:id="previewTable" VBox.vgrow="ALWAYS" maxWidth="Infinity" prefHeight="350">
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                        <placeholder>
                            <Label text="Click Preview to see data" styleClass="status-text"/>
                        </placeholder>
                    </TableView>
                </VBox>

                <Label fx:id="statusLabel" styleClass="status-text" alignment="CENTER" maxWidth="Infinity"/>

                <HBox alignment="CENTER">
                    <Button fx:id="backButton" text="Back to Dashboard" styleClass="button-secondary" prefWidth="150"/>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <fx:include source="FooterComponent.fxml"/>
    </bottom>
</BorderPane>