<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.VehicleStatusController"
            stylesheets="@../css/application.css" styleClass="border-pane">

    <top>
        <fx:include source="MenuBarComponent.fxml"/>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="false" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
            <VBox spacing="20" alignment="TOP_CENTER" styleClass="dashboard-container">
                <padding>
                    <Insets top="25" right="40" bottom="30" left="40"/>
                </padding>

                <Label text="Vehicle Status Management" styleClass="label-title" alignment="CENTER" maxWidth="Infinity"/>
                <Label text="Monitor and update vehicle status" styleClass="label-subtitle" alignment="CENTER" maxWidth="Infinity"/>

                <Separator/>

                <ProgressIndicator fx:id="loadProgress" visible="false" maxWidth="40"/>

                <!-- Vehicle List Table -->
                <HBox alignment="CENTER">
                    <VBox maxWidth="1300" styleClass="profile-edit-card" alignment="CENTER">
                        <TableView fx:id="vehiclesTable" prefHeight="400" minHeight="350" maxWidth="Infinity">
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                            <columns>
                                <TableColumn fx:id="registrationColumn" text="Registration" minWidth="120" maxWidth="160"/>
                                <TableColumn fx:id="makeColumn" text="Make" minWidth="100" maxWidth="130"/>
                                <TableColumn fx:id="modelColumn" text="Model" minWidth="100" maxWidth="130"/>
                                <TableColumn fx:id="currentStatusColumn" text="Current Status" minWidth="120" maxWidth="160"/>
                            </columns>
                            <placeholder>
                                <Label text="No vehicles found" styleClass="status-text"/>
                            </placeholder>
                        </TableView>

                        <HBox alignment="CENTER">
                            <Pagination fx:id="statusPagination" pageCount="1" maxPageIndicatorCount="8"/>
                        </HBox>
                    </VBox>
                </HBox>

                <Separator/>

                <!-- Update Status Form -->
                <HBox alignment="CENTER">
                    <VBox maxWidth="900" minWidth="600" styleClass="profile-edit-card" alignment="CENTER">
                        <Label text="Update Vehicle Status" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>

                        <GridPane hgap="15" vgap="12" alignment="CENTER">
                            <columnConstraints>
                                <ColumnConstraints halignment="RIGHT" minWidth="100" prefWidth="100"/>
                                <ColumnConstraints minWidth="300" hgrow="ALWAYS"/>
                            </columnConstraints>

                            <Label text="Select Vehicle:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <ComboBox fx:id="vehicleComboBox" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="350"/>

                            <Label text="New Status:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <ComboBox fx:id="statusComboBox" GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="350"/>
                        </GridPane>

                        <Label fx:id="vehicleInfoLabel" styleClass="status-text" alignment="CENTER" maxWidth="Infinity"/>

                        <HBox alignment="CENTER" spacing="15">
                            <Button fx:id="updateStatusButton" text="Update Status" styleClass="button-primary" prefWidth="130"/>
                            <Button fx:id="refreshButton" text="Refresh" styleClass="button-info" prefWidth="100"/>
                            <Button fx:id="fadeButton" text="Animate" styleClass="button-warning" prefWidth="100"/>
                            <Button fx:id="backButton" text="Back to Dashboard" styleClass="button-secondary" prefWidth="150"/>
                        </HBox>
                    </VBox>
                </HBox>

                <ProgressBar fx:id="operationProgress" prefWidth="Infinity" progress="0" visible="false"/>

                <Label fx:id="statusLabel" styleClass="status-text" alignment="CENTER" maxWidth="Infinity"/>

            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <fx:include source="FooterComponent.fxml"/>
    </bottom>
</BorderPane>