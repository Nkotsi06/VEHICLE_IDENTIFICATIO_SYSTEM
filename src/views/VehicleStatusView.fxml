<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.VehicleStatusController">

    <top>
        <VBox>
            <fx:include source="MenuBarComponent.fxml"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="20" style="-fx-padding: 20;">
            <Label text="Vehicle Status Management" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

            <TableView fx:id="vehiclesTable">
                <columns>
                    <TableColumn fx:id="registrationColumn" text="Registration" prefWidth="150"/>
                    <TableColumn fx:id="makeColumn" text="Make" prefWidth="120"/>
                    <TableColumn fx:id="modelColumn" text="Model" prefWidth="120"/>
                    <TableColumn fx:id="currentStatusColumn" text="Current Status" prefWidth="150"/>
                </columns>
            </TableView>

            <Separator/>

            <GridPane hgap="10" vgap="10" alignment="CENTER">
                <Label text="Select Vehicle:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <ComboBox fx:id="vehicleComboBox" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="300"/>

                <Label text="New Status:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <ComboBox fx:id="statusComboBox" GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="300"/>
            </GridPane>

            <Label fx:id="vehicleInfoLabel" style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;"/>

            <HBox spacing="10" alignment="CENTER">
                <Button fx:id="updateStatusButton" text="Update Status" style="-fx-background-color: #2980b9; -fx-text-fill: white;"/>
                <Button fx:id="refreshButton" text="Refresh"/>
                <Button fx:id="backButton" text="Back"/>
            </HBox>
        </VBox>
    </center>

    <bottom>
        <fx:include source="FooterComponent.fxml"/>
    </bottom>
</BorderPane>