<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ViolationController"
            stylesheets="@../css/application.css" styleClass="border-pane">

    <top>
        <fx:include source="MenuBarComponent.fxml"/>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="false" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
            <VBox spacing="20" alignment="TOP_CENTER" styleClass="dashboard-container">
                <padding>
                    <Insets top="25" right="40" bottom="30" left="40"/>
                </padding>

                <Label text="Violations Management" styleClass="label-title" alignment="CENTER" maxWidth="Infinity"/>
                <Label text="Manage traffic violations and fines" styleClass="label-subtitle" alignment="CENTER" maxWidth="Infinity"/>

                <Separator/>

                <HBox spacing="25" alignment="CENTER" fillHeight="true">
                    <!-- Left Panel - Violations List -->
                    <VBox spacing="15" alignment="CENTER" HBox.hgrow="ALWAYS" prefWidth="600">
                        <VBox styleClass="profile-edit-card" alignment="CENTER" prefWidth="600">
                            <Label text="Violations List" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>

                            <ProgressIndicator fx:id="loadProgress" visible="false" maxWidth="30"/>

                            <TableView fx:id="violationsTable" prefHeight="450" maxWidth="Infinity">
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                </columnResizePolicy>
                                <columns>
                                    <TableColumn fx:id="regNumberColumn" text="Registration" prefWidth="110"/>
                                    <TableColumn fx:id="violationTypeColumn" text="Violation Type" prefWidth="140"/>
                                    <TableColumn fx:id="violationDateColumn" text="Date" prefWidth="100"/>
                                    <TableColumn fx:id="fineAmountColumn" text="Fine Amount (M)" prefWidth="100"/>
                                    <TableColumn fx:id="paymentStatusColumn" text="Payment Status" prefWidth="100"/>
                                    <TableColumn fx:id="officerColumn" text="Officer" prefWidth="120"/>
                                </columns>
                                <placeholder>
                                    <Label text="No violations found" styleClass="status-text"/>
                                </placeholder>
                            </TableView>

                            <HBox alignment="CENTER">
                                <Pagination fx:id="violationsPagination" pageCount="1" maxPageIndicatorCount="5"/>
                            </HBox>

                            <ProgressBar fx:id="operationProgress" prefWidth="Infinity" progress="0" visible="false"/>

                            <HBox alignment="CENTER" spacing="15">
                                <Button fx:id="refreshButton" text="Refresh" styleClass="button-info" prefWidth="100"/>
                                <Button fx:id="fadeButton" text="Animate" styleClass="button-warning" prefWidth="100"/>
                            </HBox>
                        </VBox>
                    </VBox>

                    <!-- Right Panel - Violation Details -->
                    <VBox spacing="15" alignment="CENTER" HBox.hgrow="ALWAYS" prefWidth="450">
                        <VBox styleClass="profile-edit-card" alignment="CENTER" prefWidth="450">
                            <Label text="Violation Details" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>

                            <GridPane hgap="15" vgap="12" alignment="CENTER">
                                <columnConstraints>
                                    <ColumnConstraints halignment="RIGHT" minWidth="100" prefWidth="100"/>
                                    <ColumnConstraints minWidth="250" hgrow="ALWAYS"/>
                                </columnConstraints>

                                <Label text="Vehicle:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <ComboBox fx:id="vehicleComboBox" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="280" promptText="Select vehicle"/>

                                <Label text="Violation Type:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <TextField fx:id="violationTypeField" GridPane.rowIndex="1" GridPane.columnIndex="1" promptText="Enter violation type"/>

                                <Label text="Fine Amount (M):" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <TextField fx:id="fineAmountField" GridPane.rowIndex="2" GridPane.columnIndex="1" promptText="Enter fine amount"/>

                                <Label text="Location:" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <TextField fx:id="locationField" GridPane.rowIndex="3" GridPane.columnIndex="1" promptText="Enter location"/>

                                <Label text="Violation Date:" GridPane.rowIndex="4" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <DatePicker fx:id="violationDatePicker" GridPane.rowIndex="4" GridPane.columnIndex="1" prefWidth="200"/>

                                <Label text="Payment Status:" GridPane.rowIndex="5" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <ComboBox fx:id="paymentStatusComboBox" GridPane.rowIndex="5" GridPane.columnIndex="1" prefWidth="200"/>
                            </GridPane>

                            <Label text="Description:" style="-fx-font-weight: bold;" alignment="CENTER" maxWidth="Infinity"/>
                            <TextArea fx:id="descriptionArea" prefHeight="80" promptText="Enter description..."/>

                            <HBox alignment="CENTER" spacing="15">
                                <Button fx:id="addButton" text="Add Violation" styleClass="button-warning" prefWidth="110"/>
                                <Button fx:id="updateButton" text="Update" styleClass="button-info" prefWidth="90"/>
                                <Button fx:id="deleteButton" text="Delete" styleClass="button-danger" prefWidth="90"/>
                                <Button fx:id="markPaidButton" text="Mark Paid" styleClass="button-success" prefWidth="100"/>
                            </HBox>

                            <Label fx:id="statusLabel" styleClass="status-text" alignment="CENTER" maxWidth="Infinity"/>
                        </VBox>
                    </VBox>
                </HBox>

                <HBox alignment="CENTER">
                    <Button fx:id="backButton" text="Back to Dashboard" styleClass="button-secondary" prefWidth="150"/>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <fx:include source="FooterComponent.fxml"/>
    </bottom>
</BorderPane>