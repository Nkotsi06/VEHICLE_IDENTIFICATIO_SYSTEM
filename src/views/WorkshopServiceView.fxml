<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.WorkshopServiceController"
            stylesheets="@../css/application.css" styleClass="border-pane">

    <top>
        <fx:include source="MenuBarComponent.fxml"/>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="false" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
            <VBox spacing="20" alignment="TOP_CENTER" styleClass="dashboard-container">
                <padding>
                    <Insets top="25" right="40" bottom="30" left="40"/>
                </padding>

                <Label text="Workshop Services" styleClass="label-title" alignment="CENTER" maxWidth="Infinity"/>
                <Label text="Manage workshop services" styleClass="label-subtitle" alignment="CENTER" maxWidth="Infinity"/>

                <Separator/>

                <HBox spacing="25" alignment="CENTER" fillHeight="true">
                    <!-- Left Panel - Services List -->
                    <VBox spacing="15" alignment="CENTER" HBox.hgrow="ALWAYS" prefWidth="550">
                        <VBox styleClass="profile-edit-card" alignment="CENTER" prefWidth="550">
                            <Label text="Services" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>

                            <ProgressIndicator fx:id="loadProgress" visible="false" maxWidth="30"/>

                            <TableView fx:id="servicesTable" prefHeight="450" maxWidth="Infinity">
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                </columnResizePolicy>
                                <columns>
                                    <TableColumn fx:id="serviceNameColumn" text="Service Name" prefWidth="170"/>
                                    <TableColumn fx:id="durationColumn" text="Duration (hrs)" prefWidth="90"/>
                                    <TableColumn fx:id="basePriceColumn" text="Base Price (M)" prefWidth="110"/>
                                    <TableColumn fx:id="categoryColumn" text="Category" prefWidth="120"/>
                                    <TableColumn fx:id="serviceStatusColumn" text="Status" prefWidth="90"/>
                                </columns>
                                <placeholder>
                                    <Label text="No services found" styleClass="status-text"/>
                                </placeholder>
                            </TableView>

                            <HBox alignment="CENTER">
                                <Pagination fx:id="servicesPagination" pageCount="1" maxPageIndicatorCount="5"/>
                            </HBox>

                            <HBox alignment="CENTER" spacing="15">
                                <Button fx:id="refreshButton" text="Refresh" styleClass="button-info" prefWidth="100"/>
                                <Button fx:id="fadeButton" text="Animate" styleClass="button-warning" prefWidth="100"/>
                            </HBox>
                        </VBox>
                    </VBox>

                    <!-- Right Panel - Service Details -->
                    <VBox spacing="15" alignment="CENTER" HBox.hgrow="ALWAYS" prefWidth="450">
                        <VBox styleClass="profile-edit-card" alignment="CENTER" prefWidth="450">
                            <Label text="Service Details" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>

                            <ProgressBar fx:id="operationProgress" prefWidth="Infinity" progress="0" visible="false"/>

                            <GridPane hgap="15" vgap="12" alignment="CENTER">
                                <columnConstraints>
                                    <ColumnConstraints halignment="RIGHT" minWidth="100" prefWidth="100"/>
                                    <ColumnConstraints minWidth="250" hgrow="ALWAYS"/>
                                </columnConstraints>

                                <Label text="Service Name:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <TextField fx:id="serviceNameField" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="250"/>

                                <Label text="Category:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <ComboBox fx:id="categoryComboBox" GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="250"/>

                                <Label text="Duration (hours):" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <TextField fx:id="durationField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                                <Label text="Base Price (M):" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <TextField fx:id="basePriceField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                                <Label text="Status:" GridPane.rowIndex="4" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <ComboBox fx:id="statusComboBox" GridPane.rowIndex="4" GridPane.columnIndex="1" prefWidth="200"/>
                            </GridPane>

                            <Label text="Description:" style="-fx-font-weight: bold;" alignment="CENTER" maxWidth="Infinity"/>
                            <TextArea fx:id="descriptionArea" prefHeight="80" wrapText="true"/>

                            <HBox alignment="CENTER" spacing="15">
                                <Button fx:id="addButton" text="Add Service" styleClass="button-success" prefWidth="110"/>
                                <Button fx:id="updateButton" text="Update" styleClass="button-info" prefWidth="90"/>
                                <Button fx:id="deleteButton" text="Delete" styleClass="button-danger" prefWidth="90"/>
                                <Button fx:id="clearButton" text="Clear" styleClass="button-secondary" prefWidth="90"/>
                            </HBox>

                            <Label fx:id="statusLabel" styleClass="status-text" alignment="CENTER" maxWidth="Infinity"/>
                        </VBox>
                    </VBox>
                </HBox>

                <HBox alignment="CENTER">
                    <Button fx:id="backButton" text="Back to Dashboard" styleClass="button-secondary" prefWidth="150"/>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <fx:include source="FooterComponent.fxml"/>
    </bottom>
</BorderPane>