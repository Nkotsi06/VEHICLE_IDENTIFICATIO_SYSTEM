<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.MechanicController"
            stylesheets="@../css/application.css" styleClass="border-pane">

    <top>
        <fx:include source="MenuBarComponent.fxml"/>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="false" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
            <VBox spacing="20" alignment="TOP_CENTER" styleClass="dashboard-container">
                <padding>
                    <Insets top="25" right="40" bottom="30" left="40"/>
                </padding>

                <Label text="Mechanics Management" styleClass="label-title" alignment="CENTER" maxWidth="Infinity"/>
                <Label text="Manage workshop mechanics and their specializations" styleClass="label-subtitle" alignment="CENTER" maxWidth="Infinity"/>

                <Separator/>

                <HBox spacing="25" alignment="CENTER" fillHeight="true">
                    <!-- Left Panel - Mechanics List -->
                    <VBox spacing="15" alignment="CENTER" HBox.hgrow="ALWAYS" prefWidth="550">
                        <VBox styleClass="profile-edit-card" alignment="CENTER" prefWidth="550">
                            <Label text="Mechanics List" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>

                            <ProgressIndicator fx:id="loadProgress" visible="false" maxWidth="30"/>

                            <TableView fx:id="mechanicsTable" prefHeight="450" maxWidth="Infinity">
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                </columnResizePolicy>
                                <columns>
                                    <TableColumn fx:id="nameColumn" text="Name" prefWidth="140"/>
                                    <TableColumn fx:id="specializationColumn" text="Specialization" prefWidth="160"/>
                                    <TableColumn fx:id="phoneColumn" text="Phone" prefWidth="120"/>
                                    <TableColumn fx:id="emailColumn" text="Email" prefWidth="160"/>
                                    <TableColumn fx:id="statusColumn" text="Status" prefWidth="100"/>
                                </columns>
                                <placeholder>
                                    <Label text="No mechanics found" styleClass="status-text"/>
                                </placeholder>
                            </TableView>

                            <HBox alignment="CENTER">
                                <Pagination fx:id="mechanicsPagination" pageCount="1" maxPageIndicatorCount="5"/>
                            </HBox>

                            <ProgressBar fx:id="operationProgress" prefWidth="Infinity" progress="0" visible="false"/>

                            <HBox alignment="CENTER" spacing="15">
                                <Button fx:id="refreshButton" text="Refresh" styleClass="button-info" prefWidth="100"/>
                                <Button fx:id="fadeButton" text="Animate" styleClass="button-warning" prefWidth="100"/>
                            </HBox>
                        </VBox>
                    </VBox>

                    <!-- Right Panel - Mechanic Details -->
                    <VBox spacing="15" alignment="CENTER" HBox.hgrow="ALWAYS" prefWidth="450">
                        <VBox styleClass="profile-edit-card" alignment="CENTER" prefWidth="450">
                            <Label text="Mechanic Details" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>

                            <GridPane hgap="15" vgap="12" alignment="CENTER">
                                <columnConstraints>
                                    <ColumnConstraints halignment="RIGHT" minWidth="100" prefWidth="100"/>
                                    <ColumnConstraints minWidth="250" hgrow="ALWAYS"/>
                                </columnConstraints>

                                <Label text="Name:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <TextField fx:id="nameField" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="250"/>

                                <Label text="Specialization:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <TextField fx:id="specializationField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                                <Label text="Quick Specialization:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <ComboBox fx:id="specializationComboBox" GridPane.rowIndex="2" GridPane.columnIndex="1" prefWidth="250"/>

                                <Label text="Phone:" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <TextField fx:id="phoneField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                                <Label text="Email:" GridPane.rowIndex="4" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <TextField fx:id="emailField" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                                <Label text="Hire Date:" GridPane.rowIndex="5" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <DatePicker fx:id="hireDatePicker" GridPane.rowIndex="5" GridPane.columnIndex="1" prefWidth="200"/>
                            </GridPane>

                            <HBox alignment="CENTER" spacing="15">
                                <Button fx:id="addButton" text="Add Mechanic" styleClass="button-success" prefWidth="120"/>
                                <Button fx:id="updateButton" text="Update" styleClass="button-info" prefWidth="90"/>
                                <Button fx:id="deleteButton" text="Delete" styleClass="button-danger" prefWidth="90"/>
                                <Button fx:id="clearButton" text="Clear" styleClass="button-secondary" prefWidth="90"/>
                            </HBox>

                            <Label fx:id="statusLabel" styleClass="status-text" alignment="CENTER" maxWidth="Infinity"/>
                        </VBox>
                    </VBox>
                </HBox>

                <HBox alignment="CENTER">
                    <Button fx:id="backButton" text="Back to Dashboard" styleClass="button-secondary" prefWidth="150"/>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <fx:include source="FooterComponent.fxml"/>
    </bottom>
</BorderPane>