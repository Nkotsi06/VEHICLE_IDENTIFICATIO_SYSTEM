<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.VehicleHistoryController">

    <top>
        <VBox>
            <fx:include source="MenuBarComponent.fxml"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="15" style="-fx-padding: 20;">
            <Label text="Vehicle History" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

            <GridPane hgap="10" vgap="10">
                <Label text="Vehicle:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <ComboBox fx:id="vehicleComboBox" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="300"/>

                <Label text="Start Date:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <DatePicker fx:id="startDatePicker" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="End Date:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <DatePicker fx:id="endDatePicker" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
            </GridPane>

            <HBox spacing="10">
                <Button fx:id="searchButton" text="Search" style="-fx-background-color: #2980b9; -fx-text-fill: white;"/>
                <Button fx:id="refreshButton" text="Refresh"/>
                <Button fx:id="exportButton" text="Export CSV"/>
            </HBox>

            <Separator/>

            <Label fx:id="vehicleInfoLabel" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
            <Label fx:id="totalEventsLabel" style="-fx-text-fill: #7f8c8d;"/>

            <TableView fx:id="historyTable">
                <columns>
                    <TableColumn fx:id="eventTypeColumn" text="Event Type" prefWidth="120"/>
                    <TableColumn fx:id="eventDateColumn" text="Date" prefWidth="120"/>
                    <TableColumn fx:id="descriptionColumn" text="Description" prefWidth="300"/>
                    <TableColumn fx:id="detailsColumn" text="Details" prefWidth="300"/>
                </columns>
            </TableView>
        </VBox>
    </center>

    <bottom>
        <HBox spacing="10" style="-fx-padding: 10;" alignment="CENTER_RIGHT">
            <Button fx:id="backButton" text="Back"/>
        </HBox>
        <fx:include source="FooterComponent.fxml"/>
    </bottom>
</BorderPane>