<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.OfficerLogController"
            stylesheets="@../css/application.css" styleClass="border-pane">

    <top>
        <fx:include source="MenuBarComponent.fxml"/>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="false" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
            <VBox spacing="20" alignment="TOP_CENTER" styleClass="dashboard-container">
                <padding>
                    <Insets top="25" right="40" bottom="30" left="40"/>
                </padding>

                <Label text="Officer Activity Logs" styleClass="label-title" alignment="CENTER" maxWidth="Infinity"/>
                <Label text="Track and monitor police officer actions" styleClass="label-subtitle" alignment="CENTER" maxWidth="Infinity"/>

                <Separator/>

                <ProgressIndicator fx:id="loadProgress" visible="false" maxWidth="40"/>

                <!-- Search Filters -->
                <VBox maxWidth="1100" styleClass="profile-edit-card" alignment="CENTER">
                    <Label text="Search Filters" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>

                    <GridPane hgap="15" vgap="12" alignment="CENTER">
                        <columnConstraints>
                            <ColumnConstraints halignment="RIGHT" minWidth="60" prefWidth="60"/>
                            <ColumnConstraints minWidth="200" hgrow="ALWAYS"/>
                            <ColumnConstraints halignment="RIGHT" minWidth="60" prefWidth="60"/>
                            <ColumnConstraints minWidth="200" hgrow="ALWAYS"/>
                        </columnConstraints>

                        <Label text="Action:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                        <ComboBox fx:id="actionFilterComboBox" prefWidth="200" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                        <Label text="Officer:" GridPane.rowIndex="0" GridPane.columnIndex="2" style="-fx-font-weight: bold;"/>
                        <TextField fx:id="officerNameField" promptText="Officer name..." GridPane.rowIndex="0" GridPane.columnIndex="3" prefWidth="220"/>

                        <Label text="From:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                        <DatePicker fx:id="startDatePicker" GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="180"/>

                        <Label text="To:" GridPane.rowIndex="1" GridPane.columnIndex="2" style="-fx-font-weight: bold;"/>
                        <DatePicker fx:id="endDatePicker" GridPane.rowIndex="1" GridPane.columnIndex="3" prefWidth="180"/>
                    </GridPane>

                    <HBox alignment="CENTER" spacing="15">
                        <Button fx:id="searchButton" text="Search" styleClass="button-primary" prefWidth="100"/>
                        <Button fx:id="refreshButton" text="Refresh" styleClass="button-info" prefWidth="100"/>
                        <Button fx:id="exportButton" text="Export" styleClass="button-success" prefWidth="100"/>
                        <Button fx:id="fadeButton" text="Animate" styleClass="button-warning" prefWidth="100"/>
                    </HBox>
                </VBox>

                <ProgressBar fx:id="operationProgress" prefWidth="Infinity" progress="0" visible="false"/>

                <!-- Log Entries -->
                <VBox maxWidth="1300" styleClass="profile-edit-card" alignment="CENTER" VBox.vgrow="ALWAYS">
                    <Label text="Log Entries" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>

                    <TableView fx:id="logsTable" prefHeight="450" maxWidth="Infinity">
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="officerColumn" text="Officer Name" prefWidth="160"/>
                            <TableColumn fx:id="badgeColumn" text="Badge #" prefWidth="80"/>
                            <TableColumn fx:id="actionColumn" text="Action" prefWidth="180"/>
                            <TableColumn fx:id="vehicleColumn" text="Vehicle" prefWidth="120"/>
                            <TableColumn fx:id="detailsColumn" text="Details" prefWidth="250"/>
                            <TableColumn fx:id="timestampColumn" text="Timestamp" prefWidth="160"/>
                        </columns>
                        <placeholder>
                            <Label text="No log entries found" styleClass="status-text"/>
                        </placeholder>
                    </TableView>

                    <HBox alignment="CENTER">
                        <Pagination fx:id="logsPagination" pageCount="1" maxPageIndicatorCount="5"/>
                    </HBox>
                    <Label fx:id="totalCountLabel" styleClass="status-text" alignment="CENTER" maxWidth="Infinity"/>
                </VBox>

                <Label fx:id="statusLabel" styleClass="status-text" alignment="CENTER" maxWidth="Infinity"/>

                <HBox alignment="CENTER">
                    <Button fx:id="backButton" text="Back to Dashboard" styleClass="button-secondary" prefWidth="150"/>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <fx:include source="FooterComponent.fxml"/>
    </bottom>
</BorderPane>