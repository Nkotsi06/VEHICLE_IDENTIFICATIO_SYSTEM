<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.OfficerLogController">

    <top>
        <VBox>
            <fx:include source="MenuBarComponent.fxml"/>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true">
            <VBox spacing="20" style="-fx-padding: 20;">
                <Label text="Officer Activity Logs" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <Label text="Track and monitor police officer actions" style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;"/>

                <Separator/>

                <ProgressIndicator fx:id="loadProgress" visible="false" maxWidth="40"/>

                <TitledPane text="Search Filters" expanded="true" style="-fx-font-weight: bold;">
                    <GridPane hgap="15" vgap="10" style="-fx-padding: 10;">
                        <Label text="Action:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                        <ComboBox fx:id="actionFilterComboBox" prefWidth="150" GridPane.rowIndex="0" GridPane.columnIndex="1">
                            <items>
                                <FXCollections fx:factory="observableArrayList">
                                    <String fx:value="All"/>
                                    <String fx:value="LOGIN"/>
                                    <String fx:value="SEARCH_VEHICLE"/>
                                    <String fx:value="ISSUE_WARRANT"/>
                                    <String fx:value="REPORT_STOLEN"/>
                                    <String fx:value="ADD_VIOLATION"/>
                                    <String fx:value="GENERATE_BOLO"/>
                                </FXCollections>
                            </items>
                        </ComboBox>

                        <Label text="Officer:" GridPane.rowIndex="0" GridPane.columnIndex="2" style="-fx-font-weight: bold;"/>
                        <TextField fx:id="officerNameField" promptText="Officer name..." GridPane.rowIndex="0" GridPane.columnIndex="3" prefWidth="200"/>

                        <Label text="From:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                        <DatePicker fx:id="startDatePicker" GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="150"/>

                        <Label text="To:" GridPane.rowIndex="1" GridPane.columnIndex="2" style="-fx-font-weight: bold;"/>
                        <DatePicker fx:id="endDatePicker" GridPane.rowIndex="1" GridPane.columnIndex="3" prefWidth="150"/>

                        <HBox spacing="10" GridPane.rowIndex="2" GridPane.columnIndex="0" GridPane.columnSpan="4">
                            <Button fx:id="searchButton" text="Search" style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;">
                                <effect>
                                    <DropShadow radius="3" color="rgba(0,0,0,0.2)"/>
                                </effect>
                            </Button>
                            <Button fx:id="refreshButton" text="Refresh" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
                            <Button fx:id="exportButton" text="Export" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
                            <Button fx:id="fadeButton" text="Animate" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
                        </HBox>
                    </GridPane>
                </TitledPane>

                <ProgressBar fx:id="operationProgress" prefWidth="Infinity" progress="0" visible="false"/>

                <TitledPane text="Log Entries" expanded="true" style="-fx-font-weight: bold;">
                    <VBox spacing="10" style="-fx-padding: 10;">
                        <TableView fx:id="logsTable" prefHeight="400">
                            <columns>
                                <TableColumn fx:id="officerColumn" text="Officer Name" prefWidth="180"/>
                                <TableColumn fx:id="badgeColumn" text="Badge #" prefWidth="100"/>
                                <TableColumn fx:id="actionColumn" text="Action" prefWidth="200"/>
                                <TableColumn fx:id="vehicleColumn" text="Vehicle" prefWidth="120"/>
                                <TableColumn fx:id="detailsColumn" text="Details" prefWidth="250"/>
                                <TableColumn fx:id="timestampColumn" text="Timestamp" prefWidth="180"/>
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                            <placeholder>
                                <Label text="No log entries found" style="-fx-text-fill: #7f8c8d;"/>
                            </placeholder>
                        </TableView>
                        <Pagination fx:id="logsPagination" pageCount="1" maxPageIndicatorCount="10"/>
                        <Label fx:id="totalCountLabel" style="-fx-text-fill: #7f8c8d; -fx-font-style: italic;"/>
                    </VBox>
                </TitledPane>

                <Label fx:id="statusLabel" style="-fx-text-fill: #7f8c8d; -fx-font-style: italic;"/>
            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <HBox spacing="10" style="-fx-padding: 10;" alignment="CENTER_RIGHT">
            <Button fx:id="backButton" text="Back to Dashboard" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-pref-width: 150;"/>
        </HBox>
        <fx:include source="FooterComponent.fxml"/>
    </bottom>
</BorderPane>