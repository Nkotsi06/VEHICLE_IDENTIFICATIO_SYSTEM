<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ReportController"
            stylesheets="@../css/application.css" styleClass="border-pane">

    <top>
        <fx:include source="MenuBarComponent.fxml"/>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="false" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
            <VBox spacing="20" alignment="TOP_CENTER" styleClass="dashboard-container">
                <padding>
                    <Insets top="25" right="40" bottom="30" left="40"/>
                </padding>

                <Label text="Report Generator" styleClass="label-title" alignment="CENTER" maxWidth="Infinity"/>
                <Label text="Generate and export system reports" styleClass="label-subtitle" alignment="CENTER" maxWidth="Infinity"/>

                <Separator/>

                <ProgressIndicator fx:id="loadProgress" visible="false" maxWidth="40"/>

                <HBox alignment="CENTER">
                    <VBox maxWidth="800" minWidth="550" styleClass="profile-edit-card" alignment="CENTER">
                        <Label text="Report Configuration" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>

                        <GridPane hgap="15" vgap="15" alignment="CENTER">
                            <columnConstraints>
                                <ColumnConstraints halignment="RIGHT" minWidth="100" prefWidth="100"/>
                                <ColumnConstraints minWidth="280" hgrow="ALWAYS"/>
                            </columnConstraints>

                            <Label text="Report Type:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <ComboBox fx:id="reportTypeComboBox" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="350" promptText="Select report type"/>

                            <Label text="Start Date:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <DatePicker fx:id="startDatePicker" GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="200"/>

                            <Label text="End Date:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <DatePicker fx:id="endDatePicker" GridPane.rowIndex="2" GridPane.columnIndex="1" prefWidth="200"/>
                        </GridPane>
                    </VBox>
                </HBox>

                <ProgressBar fx:id="operationProgress" prefWidth="Infinity" progress="0" visible="false"/>

                <HBox alignment="CENTER" spacing="15">
                    <Button fx:id="generateButton" text="Generate Report" styleClass="button-success" prefWidth="150"/>
                    <Button fx:id="exportButton" text="Export CSV" disable="true" styleClass="button-info" prefWidth="120"/>
                    <Button fx:id="printButton" text="Print" disable="true" styleClass="button-warning" prefWidth="100"/>
                    <Button fx:id="clearButton" text="Clear" styleClass="button-secondary" prefWidth="100"/>
                </HBox>

                <Separator/>

                <HBox alignment="CENTER">
                    <VBox maxWidth="1300" styleClass="profile-edit-card" alignment="CENTER" VBox.vgrow="ALWAYS">
                        <Label text="Report Results" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>

                        <TableView fx:id="reportTable" prefHeight="400" maxWidth="Infinity">
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                            <placeholder>
                                <Label text="Select a report type and click Generate" styleClass="status-text"/>
                            </placeholder>
                        </TableView>

                        <HBox alignment="CENTER">
                            <Pagination fx:id="reportPagination" pageCount="1" maxPageIndicatorCount="10"/>
                        </HBox>
                        <Label fx:id="recordCountLabel" styleClass="status-text" alignment="CENTER" maxWidth="Infinity"/>
                    </VBox>
                </HBox>

                <HBox alignment="CENTER">
                    <VBox maxWidth="1300" styleClass="profile-edit-card" alignment="CENTER">
                        <Label text="Report Summary" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>
                        <TextArea fx:id="reportSummaryArea" prefHeight="150" minHeight="100" wrapText="true"
                                  style="-fx-font-family: monospace; -fx-font-size: 12px;" promptText="Report summary will appear here..."/>
                    </VBox>
                </HBox>

                <Label fx:id="statusLabel" styleClass="status-text" alignment="CENTER" maxWidth="Infinity"/>

                <HBox alignment="CENTER">
                    <Button fx:id="backButton" text="Back to Dashboard" styleClass="button-secondary" prefWidth="150"/>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <fx:include source="FooterComponent.fxml"/>
    </bottom>
</BorderPane>