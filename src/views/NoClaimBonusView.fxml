<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.NoClaimBonusController">

    <top>
        <VBox>
            <fx:include source="MenuBarComponent.fxml"/>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true">
            <VBox spacing="20" style="-fx-padding: 20;">
                <Label text="No Claim Bonus Calculator" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <Label text="Calculate your no-claim bonus and potential savings" style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;"/>

                <Separator/>

                <ProgressIndicator fx:id="loadProgress" visible="false" maxWidth="40"/>

                <TitledPane text="Select Policy" expanded="true" style="-fx-font-weight: bold;">
                    <GridPane hgap="15" vgap="10" style="-fx-padding: 10;">
                        <Label text="Select Policy:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                        <ComboBox fx:id="policyComboBox" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="350"/>
                        <Button fx:id="calculateButton" text="Calculate Bonus" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-pref-width: 130;">
                            <effect>
                                <DropShadow radius="3" color="rgba(0,0,0,0.2)"/>
                            </effect>
                        </Button>
                        <Button fx:id="fadeButton" text="Animate" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
                    </GridPane>
                </TitledPane>

                <ProgressBar fx:id="operationProgress" prefWidth="Infinity" progress="0" visible="false"/>

                <VBox spacing="15" style="-fx-background-color: linear-gradient(to bottom, #27ae60, #1e8449); -fx-padding: 25; -fx-border-radius: 15; -fx-background-radius: 15;">
                    <Label text="No Claim Bonus Details" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    <GridPane hgap="25" vgap="12">
                        <Label text="Current Bonus:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold; -fx-text-fill: white;"/>
                        <Label fx:id="currentBonusLabel" GridPane.rowIndex="0" GridPane.columnIndex="1" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #f1c40f;"/>

                        <Label text="Estimated Savings:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold; -fx-text-fill: white;"/>
                        <Label fx:id="savingsLabel" GridPane.rowIndex="1" GridPane.columnIndex="1" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white;"/>

                        <Label text="Claim-Free Years:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold; -fx-text-fill: white;"/>
                        <Label fx:id="claimFreeYearsLabel" GridPane.rowIndex="2" GridPane.columnIndex="1" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>

                        <Label text="Next Year Bonus (if claim-free):" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-font-weight: bold; -fx-text-fill: white;"/>
                        <Label fx:id="nextYearBonusLabel" GridPane.rowIndex="3" GridPane.columnIndex="1" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #f1c40f;"/>
                    </GridPane>
                </VBox>

                <Separator/>

                <Label text="Bonus History" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <TableView fx:id="bonusTable" prefHeight="250">
                    <columns>
                        <TableColumn fx:id="policyColumn" text="Policy #" prefWidth="150"/>
                        <TableColumn fx:id="yearColumn" text="Year" prefWidth="100"/>
                        <TableColumn fx:id="claimFreeYearsColumn" text="Claim-Free Years" prefWidth="120"/>
                        <TableColumn fx:id="bonusPercentageColumn" text="Bonus %" prefWidth="80"/>
                        <TableColumn fx:id="savedAmountColumn" text="Saved Amount (M)" prefWidth="150"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                    <placeholder>
                        <Label text="No bonus history available" style="-fx-text-fill: #7f8c8d;"/>
                    </placeholder>
                </TableView>

                <Pagination fx:id="bonusPagination" pageCount="1" maxPageIndicatorCount="5"/>

                <HBox spacing="15" alignment="CENTER_RIGHT">
                    <Button fx:id="refreshButton" text="Refresh" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
                    <Button fx:id="backButton" text="Back to Dashboard" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-pref-width: 150;"/>
                </HBox>

                <Label fx:id="statusLabel" style="-fx-text-fill: #7f8c8d; -fx-font-style: italic;"/>
            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <fx:include source="FooterComponent.fxml"/>
    </bottom>
</BorderPane>