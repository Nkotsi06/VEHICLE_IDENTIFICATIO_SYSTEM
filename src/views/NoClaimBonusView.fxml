<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.NoClaimBonusController"
            stylesheets="@../css/application.css" styleClass="border-pane">

    <top>
        <fx:include source="MenuBarComponent.fxml"/>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="false" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
            <VBox spacing="20" alignment="TOP_CENTER" styleClass="dashboard-container">
                <padding>
                    <Insets top="25" right="40" bottom="30" left="40"/>
                </padding>

                <Label text="No Claim Bonus Calculator" styleClass="label-title" alignment="CENTER" maxWidth="Infinity"/>
                <Label text="Calculate your no-claim bonus and potential savings" styleClass="label-subtitle" alignment="CENTER" maxWidth="Infinity"/>

                <Separator/>

                <ProgressIndicator fx:id="loadProgress" visible="false" maxWidth="40"/>

                <!-- Select Policy Section -->
                <HBox alignment="CENTER">
                    <VBox maxWidth="800" minWidth="550" styleClass="profile-edit-card" alignment="CENTER">
                        <Label text="Select Policy" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>

                        <GridPane hgap="15" vgap="12" alignment="CENTER">
                            <columnConstraints>
                                <ColumnConstraints halignment="RIGHT" minWidth="100" prefWidth="100"/>
                                <ColumnConstraints minWidth="280" hgrow="ALWAYS"/>
                            </columnConstraints>
                            <Label text="Select Policy:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <ComboBox fx:id="policyComboBox" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="350"/>
                        </GridPane>

                        <HBox alignment="CENTER" spacing="15">
                            <Button fx:id="calculateButton" text="Calculate Bonus" styleClass="button-success" prefWidth="140"/>
                            <Button fx:id="fadeButton" text="Animate" styleClass="button-warning" prefWidth="100"/>
                        </HBox>
                    </VBox>
                </HBox>

                <ProgressBar fx:id="operationProgress" prefWidth="Infinity" progress="0" visible="false"/>

                <!-- Bonus Details Card -->
                <HBox alignment="CENTER">
                    <VBox spacing="15" alignment="CENTER" style="-fx-background-color: linear-gradient(to bottom, #27ae60, #1e8449); -fx-padding: 25; -fx-border-radius: 15; -fx-background-radius: 15; min-width: 500;">
                        <Label text="No Claim Bonus Details" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;" alignment="CENTER" maxWidth="Infinity"/>
                        <GridPane hgap="25" vgap="12" alignment="CENTER">
                            <Label text="Current Bonus:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold; -fx-text-fill: white;"/>
                            <Label fx:id="currentBonusLabel" GridPane.rowIndex="0" GridPane.columnIndex="1" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #f1c40f;"/>

                            <Label text="Estimated Savings:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold; -fx-text-fill: white;"/>
                            <Label fx:id="savingsLabel" GridPane.rowIndex="1" GridPane.columnIndex="1" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white;"/>

                            <Label text="Claim-Free Years:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold; -fx-text-fill: white;"/>
                            <Label fx:id="claimFreeYearsLabel" GridPane.rowIndex="2" GridPane.columnIndex="1" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>

                            <Label text="Next Year Bonus:" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-font-weight: bold; -fx-text-fill: white;"/>
                            <Label fx:id="nextYearBonusLabel" GridPane.rowIndex="3" GridPane.columnIndex="1" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #f1c40f;"/>
                        </GridPane>
                    </VBox>
                </HBox>

                <Separator/>

                <!-- Bonus History Table -->
                <HBox alignment="CENTER">
                    <VBox maxWidth="1000" styleClass="profile-edit-card" alignment="CENTER">
                        <Label text="Bonus History" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>

                        <TableView fx:id="bonusTable" prefHeight="250" maxWidth="Infinity">
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                            <columns>
                                <TableColumn fx:id="policyColumn" text="Policy #" prefWidth="140"/>
                                <TableColumn fx:id="yearColumn" text="Year" prefWidth="90"/>
                                <TableColumn fx:id="claimFreeYearsColumn" text="Claim-Free Years" prefWidth="120"/>
                                <TableColumn fx:id="bonusPercentageColumn" text="Bonus %" prefWidth="80"/>
                                <TableColumn fx:id="savedAmountColumn" text="Saved Amount (M)" prefWidth="140"/>
                            </columns>
                            <placeholder>
                                <Label text="No bonus history available" styleClass="status-text"/>
                            </placeholder>
                        </TableView>

                        <HBox alignment="CENTER">
                            <Pagination fx:id="bonusPagination" pageCount="1" maxPageIndicatorCount="5"/>
                        </HBox>
                    </VBox>
                </HBox>

                <HBox spacing="15" alignment="CENTER">
                    <Button fx:id="refreshButton" text="Refresh" styleClass="button-info" prefWidth="100"/>
                    <Button fx:id="backButton" text="Back to Dashboard" styleClass="button-secondary" prefWidth="150"/>
                </HBox>

                <Label fx:id="statusLabel" styleClass="status-text" alignment="CENTER" maxWidth="Infinity"/>

            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <fx:include source="FooterComponent.fxml"/>
    </bottom>
</BorderPane>