<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.RiskAssessmentController">

    <top>
        <VBox>
            <fx:include source="MenuBarComponent.fxml"/>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true">
            <VBox spacing="20" style="-fx-padding: 20;">
                <Label text="Risk Assessment" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <Label text="Assess vehicle risk for insurance premiums" style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;"/>

                <Separator/>

                <ProgressIndicator fx:id="loadProgress" visible="false" maxWidth="40"/>

                <TitledPane text="Select Vehicle" expanded="true" style="-fx-font-weight: bold;">
                    <GridPane hgap="15" vgap="10" style="-fx-padding: 10;">
                        <Label text="Select Vehicle:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                        <ComboBox fx:id="vehicleComboBox" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="300"/>
                        <Button fx:id="assessButton" text="Assess Risk" style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;">
                            <effect>
                                <DropShadow radius="3" color="rgba(0,0,0,0.2)"/>
                            </effect>
                        </Button>
                        <Button fx:id="refreshButton" text="Refresh" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
                        <Button fx:id="fadeButton" text="Animate" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
                    </GridPane>
                </TitledPane>

                <ProgressBar fx:id="operationProgress" prefWidth="Infinity" progress="0" visible="false"/>

                <GridPane hgap="20" vgap="10" style="-fx-background-color: #f8f9fa; -fx-padding: 20; -fx-border-radius: 10;">
                    <Label text="Vehicle:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                    <Label fx:id="vehicleInfoLabel" GridPane.rowIndex="0" GridPane.columnIndex="1" GridPane.columnSpan="3" style="-fx-text-fill: #2c3e50;"/>

                    <Label text="Risk Category:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                    <Label fx:id="riskCategoryLabel" GridPane.rowIndex="1" GridPane.columnIndex="1" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

                    <Label text="Risk Score:" GridPane.rowIndex="1" GridPane.columnIndex="2" style="-fx-font-weight: bold;"/>
                    <Label fx:id="riskScoreLabel" GridPane.rowIndex="1" GridPane.columnIndex="3" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

                    <Label text="Risk Level:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                    <ProgressBar fx:id="riskProgressBar" prefWidth="200" progress="0" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                    <Label fx:id="riskLevelLabel" GridPane.rowIndex="2" GridPane.columnIndex="2" style="-fx-font-weight: bold;"/>
                </GridPane>

                <Separator/>

                <Label text="Risk Factors" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <TableView fx:id="riskFactorsTable" prefHeight="200">
                    <columns>
                        <TableColumn fx:id="factorNameColumn" text="Risk Factor" prefWidth="250"/>
                        <TableColumn fx:id="factorValueColumn" text="Value" prefWidth="150"/>
                        <TableColumn fx:id="factorWeightColumn" text="Weight" prefWidth="100"/>
                        <TableColumn fx:id="factorImpactColumn" text="Impact" prefWidth="100"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                    <placeholder>
                        <Label text="No risk factors available" style="-fx-text-fill: #7f8c8d;"/>
                    </placeholder>
                </TableView>

                <Pagination fx:id="factorsPagination" pageCount="1" maxPageIndicatorCount="5"/>

                <Separator/>

                <Label text="Recommended Premium" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <GridPane hgap="20" vgap="10" style="-fx-background-color: #1e8449; -fx-padding: 20; -fx-border-radius: 10;">
                    <Label text="Base Premium:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold; -fx-text-fill: white;"/>
                    <Label fx:id="basePremiumLabel" GridPane.rowIndex="0" GridPane.columnIndex="1" style="-fx-text-fill: white; -fx-font-size: 16px;"/>

                    <Label text="Risk Multiplier:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold; -fx-text-fill: white;"/>
                    <Label fx:id="riskMultiplierLabel" GridPane.rowIndex="1" GridPane.columnIndex="1" style="-fx-text-fill: white; -fx-font-size: 16px;"/>

                    <Label text="Final Premium (Annual):" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold; -fx-text-fill: white; -fx-font-size: 14px;"/>
                    <Label fx:id="finalPremiumLabel" GridPane.rowIndex="2" GridPane.columnIndex="1" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #f1c40f;"/>

                    <Label text="Monthly Installment:" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-font-weight: bold; -fx-text-fill: white;"/>
                    <Label fx:id="monthlyPremiumLabel" GridPane.rowIndex="3" GridPane.columnIndex="1" style="-fx-text-fill: white; -fx-font-size: 14px;"/>
                </GridPane>

                <HBox spacing="15" alignment="CENTER">
                    <Button fx:id="generatePolicyButton" text="Generate Policy" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-pref-width: 150;">
                        <effect>
                            <DropShadow radius="3" color="rgba(0,0,0,0.2)"/>
                        </effect>
                    </Button>
                    <Button fx:id="exportReportButton" text="Export Report" style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-pref-width: 120;"/>
                </HBox>

                <Label fx:id="statusLabel" style="-fx-text-fill: #7f8c8d; -fx-font-style: italic;"/>
            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <HBox spacing="10" style="-fx-padding: 10;" alignment="CENTER_RIGHT">
            <Button fx:id="backButton" text="Back to Dashboard" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-pref-width: 150;"/>
        </HBox>
        <fx:include source="FooterComponent.fxml"/>
    </bottom>
</BorderPane>