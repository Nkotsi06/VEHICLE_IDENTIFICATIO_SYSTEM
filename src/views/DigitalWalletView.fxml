<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.DigitalWalletController">

    <top>
        <VBox>
            <fx:include source="MenuBarComponent.fxml"/>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true">
            <VBox spacing="20" style="-fx-padding: 20;">
                <Label text="Digital Wallet" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <Label text="Manage your digital wallet balance and transactions" style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;"/>

                <Separator/>

                <ProgressIndicator fx:id="loadProgress" visible="false" maxWidth="40"/>

                <VBox spacing="10" style="-fx-background-color: linear-gradient(to bottom, #2c3e50, #1a252f); -fx-padding: 25; -fx-border-radius: 15; -fx-background-radius: 15;" alignment="CENTER">
                    <Label text="Current Balance" style="-fx-text-fill: #ecf0f1; -fx-font-size: 14px;"/>
                    <Label fx:id="balanceLabel" style="-fx-font-size: 48px; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
                    <Label fx:id="customerNameLabel" style="-fx-text-fill: #bdc3c7; -fx-font-size: 12px;"/>
                </VBox>

                <TitledPane text="Add Funds" expanded="true" style="-fx-font-weight: bold;">
                    <HBox spacing="15" alignment="CENTER" style="-fx-padding: 15;">
                        <Label text="Amount (M):" style="-fx-font-weight: bold;"/>
                        <TextField fx:id="amountField" promptText="Enter amount" prefWidth="150"/>
                        <Button fx:id="addFundsButton" text="Add Funds" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-pref-width: 100;">
                            <effect>
                                <DropShadow radius="3" color="rgba(0,0,0,0.2)"/>
                            </effect>
                        </Button>
                        <Button fx:id="refreshButton" text="Refresh" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
                    </HBox>
                </TitledPane>

                <ProgressBar fx:id="operationProgress" prefWidth="Infinity" progress="0" visible="false"/>

                <TitledPane text="Transaction History" expanded="true" style="-fx-font-weight: bold;">
                    <VBox spacing="10" style="-fx-padding: 10;">
                        <TableView fx:id="transactionsTable" prefHeight="300">
                            <columns>
                                <TableColumn fx:id="dateColumn" text="Date" prefWidth="150"/>
                                <TableColumn fx:id="amountColumn" text="Amount (M)" prefWidth="100"/>
                                <TableColumn fx:id="typeColumn" text="Type" prefWidth="100"/>
                                <TableColumn fx:id="descriptionColumn" text="Description" prefWidth="300"/>
                                <TableColumn fx:id="transactionStatusColumn" text="Status" prefWidth="80"/>
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                            <placeholder>
                                <Label text="No transactions found" style="-fx-text-fill: #7f8c8d;"/>
                            </placeholder>
                        </TableView>
                        <Pagination fx:id="transactionsPagination" pageCount="1" maxPageIndicatorCount="5"/>
                    </VBox>
                </TitledPane>

                <Label fx:id="statusLabel" style="-fx-text-fill: #7f8c8d; -fx-font-style: italic;"/>
            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <HBox spacing="10" style="-fx-padding: 10;" alignment="CENTER_RIGHT">
            <Button fx:id="backButton" text="Back to Dashboard" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-pref-width: 150;"/>
        </HBox>
        <fx:include source="FooterComponent.fxml"/>
    </bottom>
</BorderPane>