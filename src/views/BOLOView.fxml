<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.BOLOController"
            stylesheets="@../css/application.css" styleClass="border-pane">

    <top>
        <fx:include source="MenuBarComponent.fxml"/>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="false" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    style="-fx-background-color: #f0f2f5; -fx-background: #f0f2f5;">
            <VBox spacing="20" alignment="TOP_CENTER"
                  style="-fx-background-color: #f0f2f5; -fx-padding: 25 40 30 40;">

                <Label text="BOLO Alerts Management" styleClass="label-title" alignment="CENTER" maxWidth="Infinity"/>
                <Label text="Be On the LookOut - Vehicle Alerts for Law Enforcement" styleClass="label-subtitle" alignment="CENTER" maxWidth="Infinity"/>

                <Separator/>

                <HBox spacing="20" alignment="CENTER">
                    <!-- Left Panel - Active BOLO Alerts -->
                    <VBox spacing="10" alignment="CENTER" HBox.hgrow="ALWAYS">
                        <Label text="Active BOLO Alerts" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>

                        <ProgressIndicator fx:id="loadProgress" visible="false" maxWidth="30"/>

                        <TableView fx:id="boloTable" prefHeight="400" minHeight="300"
                                   maxWidth="Infinity" columnResizePolicy="CONSTRAINED_RESIZE_POLICY">
                            <columns>
                                <TableColumn fx:id="vehicleColumn" text="Vehicle" minWidth="120" maxWidth="150"/>
                                <TableColumn fx:id="messageColumn" text="Alert Message" minWidth="200"/>
                                <TableColumn fx:id="priorityColumn" text="Priority" minWidth="70" maxWidth="80"/>
                                <TableColumn fx:id="expiryDateColumn" text="Expiry Date" minWidth="90" maxWidth="120"/>
                                <TableColumn fx:id="boloStatusColumn" text="Status" minWidth="70" maxWidth="80"/>
                                <TableColumn fx:id="issuedDateColumn" text="Issued Date" minWidth="100" maxWidth="130"/>
                            </columns>
                            <placeholder>
                                <Label text="No active BOLO alerts" styleClass="status-text"/>
                            </placeholder>
                        </TableView>

                        <HBox spacing="10" alignment="CENTER">
                            <Pagination fx:id="boloPagination" pageCount="1" maxPageIndicatorCount="5"/>
                        </HBox>

                        <ProgressBar fx:id="operationProgress" prefWidth="Infinity" progress="0" visible="false"/>

                        <HBox spacing="10" alignment="CENTER">
                            <Button fx:id="refreshButton" text="Refresh" styleClass="button-info" prefWidth="100"/>
                            <Button fx:id="fadeButton" text="Animate" styleClass="button-warning" prefWidth="100">
                                <effect><DropShadow radius="3" color="rgba(0,0,0,0.2)"/></effect>
                            </Button>
                        </HBox>
                    </VBox>

                    <!-- Right Panel - Generate BOLO Alert -->
                    <VBox spacing="15" alignment="CENTER" HBox.hgrow="ALWAYS">
                        <VBox styleClass="profile-edit-card" alignment="CENTER">
                            <Label text="Generate BOLO Alert" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>

                            <GridPane hgap="10" vgap="10" alignment="CENTER">
                                <columnConstraints>
                                    <ColumnConstraints halignment="RIGHT" minWidth="100"/>
                                    <ColumnConstraints minWidth="200"/>
                                </columnConstraints>

                                <Label text="Vehicle:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <ComboBox fx:id="vehicleComboBox" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="250" promptText="Select vehicle"/>

                                <Label text="Priority:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <ComboBox fx:id="priorityComboBox" GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="150" promptText="Select priority"/>

                                <Label text="Expiry Date:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <DatePicker fx:id="expiryDatePicker" GridPane.rowIndex="2" GridPane.columnIndex="1" prefWidth="200"/>
                            </GridPane>

                            <Label text="Alert Message:" style="-fx-font-weight: bold;" alignment="CENTER" maxWidth="Infinity"/>
                            <TextField fx:id="messageField" promptText="Enter BOLO alert message..." maxWidth="Infinity"/>

                            <Label text="Additional Details:" style="-fx-font-weight: bold;" alignment="CENTER" maxWidth="Infinity"/>
                            <TextArea fx:id="detailsArea" prefHeight="100" promptText="Enter additional details..."/>

                            <HBox spacing="10" alignment="CENTER">
                                <Button fx:id="generateButton" text="Generate BOLO" styleClass="button-warning" prefWidth="120">
                                    <effect><DropShadow radius="3" color="rgba(0,0,0,0.2)"/></effect>
                                </Button>
                                <Button fx:id="cancelButton" text="Cancel Alert" styleClass="button-danger" prefWidth="120"/>
                            </HBox>

                            <Label fx:id="statusLabel" styleClass="status-text" alignment="CENTER" maxWidth="Infinity"/>
                        </VBox>
                    </VBox>
                </HBox>

                <HBox spacing="10" alignment="CENTER">
                    <Button fx:id="backButton" text="Back to Dashboard" styleClass="button-secondary" prefWidth="150"/>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <fx:include source="FooterComponent.fxml"/>
    </bottom>
</BorderPane>