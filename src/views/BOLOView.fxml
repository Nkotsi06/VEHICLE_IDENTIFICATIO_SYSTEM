<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.BOLOController">

    <top>
        <VBox>
            <fx:include source="MenuBarComponent.fxml"/>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true">
            <SplitPane dividerPositions="0.5">

                <!-- Left Panel - Active BOLO Alerts -->
                <VBox spacing="10" style="-fx-padding: 15;">
                    <Label text="Active BOLO Alerts" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

                    <ProgressIndicator fx:id="loadProgress" visible="false" maxWidth="30"/>

                    <TableView fx:id="boloTable" prefHeight="400">
                        <columns>
                            <TableColumn fx:id="vehicleColumn" text="Vehicle" prefWidth="150"/>
                            <TableColumn fx:id="messageColumn" text="Alert Message" prefWidth="250"/>
                            <TableColumn fx:id="priorityColumn" text="Priority" prefWidth="80"/>
                            <TableColumn fx:id="expiryDateColumn" text="Expiry Date" prefWidth="100"/>
                            <TableColumn fx:id="boloStatusColumn" text="Status" prefWidth="80"/>
                            <TableColumn fx:id="issuedDateColumn" text="Issued Date" prefWidth="120"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                        <placeholder>
                            <Label text="No active BOLO alerts" style="-fx-text-fill: #7f8c8d;"/>
                        </placeholder>
                    </TableView>

                    <Pagination fx:id="boloPagination" pageCount="1" maxPageIndicatorCount="5"/>

                    <ProgressBar fx:id="operationProgress" prefWidth="Infinity" progress="0" visible="false"/>

                    <HBox spacing="10">
                        <Button fx:id="refreshButton" text="Refresh" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
                        <Button fx:id="fadeButton" text="Animate" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;">
                            <effect>
                                <DropShadow radius="3" color="rgba(0,0,0,0.2)"/>
                            </effect>
                        </Button>
                    </HBox>
                </VBox>

                <!-- Right Panel - Generate BOLO Alert -->
                <VBox spacing="15" style="-fx-padding: 15;">
                    <Label text="Generate BOLO Alert" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

                    <GridPane hgap="10" vgap="10">
                        <Label text="Vehicle:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                        <ComboBox fx:id="vehicleComboBox" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="250" promptText="Select vehicle"/>

                        <Label text="Priority:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                        <ComboBox fx:id="priorityComboBox" GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="150">
                            <items>
                                <FXCollections fx:factory="observableArrayList">
                                    <String fx:value="HIGH"/>
                                    <String fx:value="MEDIUM"/>
                                    <String fx:value="LOW"/>
                                </FXCollections>
                            </items>
                        </ComboBox>

                        <Label text="Expiry Date:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                        <DatePicker fx:id="expiryDatePicker" GridPane.rowIndex="2" GridPane.columnIndex="1" prefWidth="200"/>
                    </GridPane>

                    <Label text="Alert Message:" style="-fx-font-weight: bold;"/>
                    <TextField fx:id="messageField" promptText="Enter BOLO alert message..."/>

                    <Label text="Additional Details:" style="-fx-font-weight: bold;"/>
                    <TextArea fx:id="detailsArea" prefHeight="100" promptText="Enter additional details..."/>

                    <HBox spacing="10">
                        <Button fx:id="generateButton" text="Generate BOLO" style="-fx-background-color: #f1c40f; -fx-text-fill: black; -fx-font-weight: bold; -fx-cursor: hand; -fx-pref-width: 120;">
                            <effect>
                                <DropShadow radius="3" color="rgba(0,0,0,0.2)"/>
                            </effect>
                        </Button>
                        <Button fx:id="cancelButton" text="Cancel Alert" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-pref-width: 120;"/>
                    </HBox>

                    <Label fx:id="statusLabel" style="-fx-text-fill: #7f8c8d; -fx-font-style: italic;"/>
                </VBox>
            </SplitPane>
        </ScrollPane>
    </center>

    <bottom>
        <HBox spacing="10" style="-fx-padding: 10;" alignment="CENTER_RIGHT">
            <Button fx:id="backButton" text="Back to Dashboard" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
        </HBox>
        <fx:include source="FooterComponent.fxml"/>
    </bottom>

</BorderPane>