<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.TrafficCameraIntegrationController">

    <top>
        <VBox>
            <fx:include source="MenuBarComponent.fxml"/>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true">
            <SplitPane dividerPositions="0.5">

                <VBox spacing="10" style="-fx-padding: 15;">
                    <Label text="Recent Sightings" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

                    <ProgressIndicator fx:id="loadProgress" visible="false" maxWidth="30"/>

                    <TableView fx:id="sightingsTable" prefHeight="400">
                        <columns>
                            <TableColumn fx:id="timestampColumn" text="Timestamp" prefWidth="180"/>
                            <TableColumn fx:id="vehicleColumn" text="Vehicle" prefWidth="120"/>
                            <TableColumn fx:id="cameraColumn" text="Camera ID" prefWidth="120"/>
                            <TableColumn fx:id="locationColumn" text="Location" prefWidth="150"/>
                            <TableColumn fx:id="confidenceColumn" text="Confidence" prefWidth="80"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                        <placeholder>
                            <Label text="No sightings recorded" style="-fx-text-fill: #7f8c8d;"/>
                        </placeholder>
                    </TableView>

                    <Pagination fx:id="sightingsPagination" pageCount="1" maxPageIndicatorCount="5"/>

                    <ProgressBar fx:id="operationProgress" prefWidth="Infinity" progress="0" visible="false"/>

                    <HBox spacing="10">
                        <Button fx:id="refreshButton" text="Refresh" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
                        <Button fx:id="fadeButton" text="Animate" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;">
                            <effect>
                                <DropShadow radius="3" color="rgba(0,0,0,0.2)"/>
                            </effect>
                        </Button>
                    </HBox>
                </VBox>

                <VBox spacing="15" style="-fx-padding: 15;">
                    <Label text="Add Sighting" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

                    <GridPane hgap="10" vgap="10">
                        <Label text="License Plate:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                        <TextField fx:id="licensePlateField" GridPane.rowIndex="0" GridPane.columnIndex="1" promptText="Enter license plate"/>

                        <Label text="Camera/Source ID:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                        <TextField fx:id="cameraIdField" GridPane.rowIndex="1" GridPane.columnIndex="1" promptText="Camera identifier"/>

                        <Label text="Source Type:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                        <ComboBox fx:id="sourceTypeComboBox" GridPane.rowIndex="2" GridPane.columnIndex="1" prefWidth="200">
                            <items>
                                <FXCollections fx:factory="observableArrayList">
                                    <String fx:value="Traffic Camera"/>
                                    <String fx:value="ANPR Camera"/>
                                    <String fx:value="Manual Entry"/>
                                    <String fx:value="Mobile Patrol"/>
                                </FXCollections>
                            </items>
                        </ComboBox>

                        <Label text="Latitude:" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                        <TextField fx:id="latitudeField" GridPane.rowIndex="3" GridPane.columnIndex="1" promptText="Latitude"/>

                        <Label text="Longitude:" GridPane.rowIndex="4" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                        <TextField fx:id="longitudeField" GridPane.rowIndex="4" GridPane.columnIndex="1" promptText="Longitude"/>

                        <Label text="Date/Time:" GridPane.rowIndex="5" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                        <DatePicker fx:id="sightingDatePicker" GridPane.rowIndex="5" GridPane.columnIndex="1" prefWidth="200"/>
                    </GridPane>

                    <Button fx:id="addSightingButton" text="Record Sighting" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-pref-width: 150;">
                        <effect>
                            <DropShadow radius="3" color="rgba(0,0,0,0.2)"/>
                        </effect>
                    </Button>

                    <Separator/>

                    <Label text="Search" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                    <HBox spacing="10">
                        <TextField fx:id="searchPlateField" promptText="License plate" HBox.hgrow="ALWAYS"/>
                        <Button fx:id="searchButton" text="Search" style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
                    </HBox>

                    <Label fx:id="statusLabel" style="-fx-text-fill: #7f8c8d; -fx-font-style: italic;"/>
                </VBox>
            </SplitPane>
        </ScrollPane>
    </center>

    <bottom>
        <HBox spacing="10" style="-fx-padding: 10;" alignment="CENTER_RIGHT">
            <Button fx:id="backButton" text="Back to Dashboard" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-pref-width: 150;"/>
        </HBox>
        <fx:include source="FooterComponent.fxml"/>
    </bottom>
</BorderPane>