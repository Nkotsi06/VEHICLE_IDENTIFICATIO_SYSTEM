<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.VehicleTrackingController"
            stylesheets="@../css/application.css" styleClass="border-pane">

    <top>
        <fx:include source="MenuBarComponent.fxml"/>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="false" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
            <VBox spacing="20" alignment="TOP_CENTER" styleClass="dashboard-container">
                <padding>
                    <Insets top="25" right="40" bottom="30" left="40"/>
                </padding>

                <Label text="Vehicle Tracking" styleClass="label-title" alignment="CENTER" maxWidth="Infinity"/>
                <Label text="Track and monitor vehicle locations" styleClass="label-subtitle" alignment="CENTER" maxWidth="Infinity"/>

                <Separator/>

                <ProgressIndicator fx:id="loadProgress" visible="false" maxWidth="40"/>

                <!-- Search Vehicle -->
                <HBox alignment="CENTER">
                    <VBox maxWidth="900" minWidth="600" styleClass="profile-edit-card" alignment="CENTER">
                        <Label text="Search Vehicle" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>

                        <HBox spacing="15" alignment="CENTER">
                            <TextField fx:id="registrationField" promptText="Enter Registration Number" HBox.hgrow="ALWAYS" prefWidth="400"/>
                            <Button fx:id="trackButton" text="Track" styleClass="button-primary" prefWidth="100"/>
                            <Button fx:id="fadeButton" text="Animate" styleClass="button-warning" prefWidth="100"/>
                        </HBox>
                    </VBox>
                </HBox>

                <ProgressBar fx:id="operationProgress" prefWidth="Infinity" progress="0" visible="false"/>

                <!-- Vehicle Information -->
                <VBox fx:id="trackingDetailsBox" spacing="15" styleClass="profile-edit-card" maxWidth="900" minWidth="600" alignment="CENTER" visible="false">
                    <Label text="Vehicle Information" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>

                    <GridPane hgap="15" vgap="12" alignment="CENTER">
                        <columnConstraints>
                            <ColumnConstraints halignment="RIGHT" minWidth="120" prefWidth="120"/>
                            <ColumnConstraints minWidth="250" hgrow="ALWAYS"/>
                        </columnConstraints>

                        <Label text="Registration:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                        <Label fx:id="registrationInfoLabel" GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="status-text"/>

                        <Label text="Vehicle:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                        <Label fx:id="vehicleInfoLabel" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="status-text"/>

                        <Label text="Status:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                        <Label fx:id="statusLabel" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                        <Label text="Last Location:" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                        <Label fx:id="lastLocationLabel" GridPane.rowIndex="3" GridPane.columnIndex="1" styleClass="status-text"/>

                        <Label text="Last Updated:" GridPane.rowIndex="4" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                        <Label fx:id="lastUpdatedLabel" GridPane.rowIndex="4" GridPane.columnIndex="1" styleClass="status-text"/>
                    </GridPane>

                    <Separator/>

                    <Label text="Location History" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>

                    <TableView fx:id="locationHistoryTable" prefHeight="220" maxWidth="Infinity">
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="historyDateColumn" text="Date" prefWidth="150"/>
                            <TableColumn fx:id="historyLocationColumn" text="Location" prefWidth="250"/>
                            <TableColumn fx:id="historySourceColumn" text="Source" prefWidth="140"/>
                        </columns>
                        <placeholder>
                            <Label text="No location history available" styleClass="status-text"/>
                        </placeholder>
                    </TableView>

                    <HBox alignment="CENTER">
                        <Pagination fx:id="historyPagination" pageCount="1" maxPageIndicatorCount="5"/>
                    </HBox>

                    <Separator/>

                    <Label text="Send Alert" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>
                    <TextArea fx:id="alertMessageArea" promptText="Enter alert message..." prefHeight="80"/>

                    <HBox alignment="CENTER" spacing="15">
                        <Button fx:id="alertButton" text="Send Alert" styleClass="button-danger" prefWidth="120"/>
                        <Button fx:id="locateButton" text="Locate on Map" styleClass="button-success" prefWidth="130"/>
                    </HBox>
                </VBox>

                <Label fx:id="statusMessageLabel" styleClass="status-text" alignment="CENTER" maxWidth="Infinity"/>

                <HBox alignment="CENTER">
                    <Button fx:id="backButton" text="Back to Dashboard" styleClass="button-secondary" prefWidth="150"/>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <fx:include source="FooterComponent.fxml"/>
    </bottom>
</BorderPane>