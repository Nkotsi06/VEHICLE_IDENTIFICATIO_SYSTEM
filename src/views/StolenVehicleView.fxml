<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.StolenVehicleController"
            stylesheets="@../css/application.css" styleClass="border-pane">

    <top>
        <fx:include source="MenuBarComponent.fxml"/>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="false" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
            <VBox spacing="20" alignment="TOP_CENTER" styleClass="dashboard-container">
                <padding>
                    <Insets top="25" right="40" bottom="30" left="40"/>
                </padding>

                <Label text="Stolen Vehicles Management" styleClass="label-title" alignment="CENTER" maxWidth="Infinity"/>
                <Label text="Report and track stolen vehicles" styleClass="label-subtitle" alignment="CENTER" maxWidth="Infinity"/>

                <Separator/>

                <HBox spacing="25" alignment="CENTER" fillHeight="true">
                    <!-- Left Panel - Stolen Vehicles List -->
                    <VBox spacing="15" alignment="CENTER" HBox.hgrow="ALWAYS" prefWidth="600">
                        <VBox styleClass="profile-edit-card" alignment="CENTER" prefWidth="600">
                            <Label text="Stolen Vehicles List" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>

                            <ProgressIndicator fx:id="loadProgress" visible="false" maxWidth="30"/>

                            <TableView fx:id="stolenVehiclesTable" prefHeight="450" maxWidth="Infinity">
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                </columnResizePolicy>
                                <columns>
                                    <TableColumn fx:id="regNumberColumn" text="Registration" prefWidth="110"/>
                                    <TableColumn fx:id="makeColumn" text="Make" prefWidth="90"/>
                                    <TableColumn fx:id="modelColumn" text="Model" prefWidth="90"/>
                                    <TableColumn fx:id="caseNumberColumn" text="Case Number" prefWidth="130"/>
                                    <TableColumn fx:id="statusColumn" text="Status" prefWidth="90"/>
                                    <TableColumn fx:id="officerColumn" text="Assigned Officer" prefWidth="130"/>
                                    <TableColumn fx:id="stolenDateColumn" text="Stolen Date" prefWidth="110"/>
                                </columns>
                                <placeholder>
                                    <Label text="No stolen vehicles found" styleClass="status-text"/>
                                </placeholder>
                            </TableView>

                            <HBox alignment="CENTER">
                                <Pagination fx:id="stolenPagination" pageCount="1" maxPageIndicatorCount="5"/>
                            </HBox>

                            <ProgressBar fx:id="operationProgress" prefWidth="Infinity" progress="0" visible="false"/>

                            <HBox alignment="CENTER" spacing="15">
                                <Button fx:id="refreshButton" text="Refresh" styleClass="button-info" prefWidth="100"/>
                                <Button fx:id="fadeButton" text="Animate" styleClass="button-warning" prefWidth="100"/>
                            </HBox>
                        </VBox>
                    </VBox>

                    <!-- Right Panel - Report Stolen Vehicle -->
                    <VBox spacing="15" alignment="CENTER" HBox.hgrow="ALWAYS" prefWidth="450">
                        <VBox styleClass="profile-edit-card" alignment="CENTER" prefWidth="450">
                            <Label text="Report Stolen Vehicle" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>

                            <GridPane hgap="15" vgap="12" alignment="CENTER">
                                <columnConstraints>
                                    <ColumnConstraints halignment="RIGHT" minWidth="100" prefWidth="100"/>
                                    <ColumnConstraints minWidth="250" hgrow="ALWAYS"/>
                                </columnConstraints>

                                <Label text="Vehicle:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <ComboBox fx:id="vehicleComboBox" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="280" promptText="Select vehicle"/>

                                <Label text="Case Number:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <TextField fx:id="caseNumberField" GridPane.rowIndex="1" GridPane.columnIndex="1" promptText="Enter case number"/>

                                <Label text="Assigned Officer:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <TextField fx:id="assignedOfficerField" GridPane.rowIndex="2" GridPane.columnIndex="1" promptText="Officer name"/>

                                <Label text="Badge Number:" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <TextField fx:id="badgeNumberField" GridPane.rowIndex="3" GridPane.columnIndex="1" promptText="Badge number"/>

                                <Label text="Reported Date:" GridPane.rowIndex="4" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <DatePicker fx:id="reportedDatePicker" GridPane.rowIndex="4" GridPane.columnIndex="1" prefWidth="200"/>

                                <Label text="Status:" GridPane.rowIndex="5" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <ComboBox fx:id="statusComboBox" GridPane.rowIndex="5" GridPane.columnIndex="1" prefWidth="200"/>

                                <Label text="Location (Latitude):" GridPane.rowIndex="6" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <TextField fx:id="latitudeField" GridPane.rowIndex="6" GridPane.columnIndex="1" promptText="e.g., -29.3167"/>

                                <Label text="Location (Longitude):" GridPane.rowIndex="7" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <TextField fx:id="longitudeField" GridPane.rowIndex="7" GridPane.columnIndex="1" promptText="e.g., 27.4833"/>
                            </GridPane>

                            <Label text="Description:" style="-fx-font-weight: bold;" alignment="CENTER" maxWidth="Infinity"/>
                            <TextArea fx:id="descriptionArea" prefHeight="100" promptText="Enter description..."/>

                            <HBox alignment="CENTER" spacing="15">
                                <Button fx:id="reportButton" text="Report Stolen" styleClass="button-danger" prefWidth="130"/>
                                <Button fx:id="markRecoveredButton" text="Mark Recovered" styleClass="button-success" prefWidth="130"/>
                            </HBox>

                            <Label fx:id="statusLabel" styleClass="status-text" alignment="CENTER" maxWidth="Infinity"/>
                        </VBox>
                    </VBox>
                </HBox>

                <HBox alignment="CENTER">
                    <Button fx:id="backButton" text="Back to Dashboard" styleClass="button-secondary" prefWidth="150"/>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <fx:include source="FooterComponent.fxml"/>
    </bottom>
</BorderPane>