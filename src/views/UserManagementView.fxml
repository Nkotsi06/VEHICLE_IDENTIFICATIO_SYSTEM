<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.UserManagementController"
            stylesheets="@../css/application.css" styleClass="border-pane">

    <top>
        <fx:include source="MenuBarComponent.fxml"/>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="false" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
            <VBox spacing="20" alignment="TOP_CENTER" styleClass="dashboard-container">
                <padding>
                    <Insets top="25" right="40" bottom="30" left="40"/>
                </padding>

                <Label text="User Management" styleClass="label-title" alignment="CENTER" maxWidth="Infinity"/>
                <Label text="Manage system users and their roles" styleClass="label-subtitle" alignment="CENTER" maxWidth="Infinity"/>

                <Separator/>

                <ProgressIndicator fx:id="loadProgress" visible="false" maxWidth="40"/>

                <HBox spacing="20" alignment="CENTER">
                    <!-- LEFT PANEL - User List -->
                    <VBox spacing="10" alignment="CENTER" HBox.hgrow="ALWAYS" prefWidth="500">
                        <VBox styleClass="profile-edit-card" alignment="CENTER" prefWidth="500">
                            <Label text="User List" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>

                            <ProgressIndicator fx:id="loadProgress2" visible="false" maxWidth="30"/>

                            <TableView fx:id="usersTable" prefHeight="450" minHeight="350" maxWidth="Infinity">
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                </columnResizePolicy>
                                <columns>
                                    <TableColumn fx:id="usernameColumn" text="Username" minWidth="100" maxWidth="130"/>
                                    <TableColumn fx:id="fullNameColumn" text="Full Name" minWidth="120" maxWidth="160"/>
                                    <TableColumn fx:id="emailColumn" text="Email" minWidth="180"/>
                                    <TableColumn fx:id="roleColumn" text="Role" minWidth="90" maxWidth="110"/>
                                    <TableColumn fx:id="statusColumn" text="Status" minWidth="70" maxWidth="90"/>
                                </columns>
                                <placeholder>
                                    <Label text="No users found" styleClass="status-text"/>
                                </placeholder>
                            </TableView>

                            <HBox alignment="CENTER" spacing="10">
                                <Pagination fx:id="usersPagination" pageCount="1" maxPageIndicatorCount="5"/>
                            </HBox>

                            <HBox alignment="CENTER" spacing="15">
                                <Button fx:id="refreshButton" text="Refresh" styleClass="button-primary" prefWidth="100"/>
                                <Button fx:id="resetPasswordButton" text="Reset Password" styleClass="button-warning" prefWidth="120"/>
                                <Button fx:id="fadeButton" text="Animate" styleClass="button-warning" prefWidth="100"/>
                            </HBox>
                        </VBox>
                    </VBox>

                    <!-- RIGHT PANEL - User Details -->
                    <VBox spacing="15" alignment="CENTER" HBox.hgrow="ALWAYS" prefWidth="400">
                        <VBox styleClass="profile-edit-card" alignment="CENTER" prefWidth="400">
                            <Label text="User Details" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>

                            <GridPane hgap="15" vgap="12" alignment="CENTER">
                                <columnConstraints>
                                    <ColumnConstraints halignment="RIGHT" minWidth="80" prefWidth="80"/>
                                    <ColumnConstraints minWidth="200" hgrow="ALWAYS"/>
                                </columnConstraints>

                                <Label text="Username:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <TextField fx:id="usernameField" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="250"/>

                                <Label text="Full Name:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <TextField fx:id="fullNameField" GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="250"/>

                                <Label text="Email:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <TextField fx:id="emailField" GridPane.rowIndex="2" GridPane.columnIndex="1" prefWidth="250"/>

                                <Label text="Password:" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <PasswordField fx:id="passwordField" GridPane.rowIndex="3" GridPane.columnIndex="1" prefWidth="250"/>

                                <Label text="Role:" GridPane.rowIndex="4" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <ComboBox fx:id="roleComboBox" GridPane.rowIndex="4" GridPane.columnIndex="1" prefWidth="250"/>

                                <Label text="Status:" GridPane.rowIndex="5" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <ComboBox fx:id="statusComboBox" GridPane.rowIndex="5" GridPane.columnIndex="1" prefWidth="250"/>
                            </GridPane>

                            <Separator/>

                            <Label text="Additional Information" style="-fx-font-size: 14px; -fx-font-weight: bold;" alignment="CENTER" maxWidth="Infinity"/>

                            <Label fx:id="customerFieldsLabel" text="Customer Details:" style="-fx-font-weight: bold;" alignment="CENTER" maxWidth="Infinity"/>
                            <TextField fx:id="addressField" promptText="Address" visible="false" prefWidth="300" maxWidth="300"/>
                            <TextField fx:id="phoneField" promptText="Phone" visible="false" prefWidth="300" maxWidth="300"/>
                            <TextField fx:id="nationalIdField" promptText="National ID" visible="false" prefWidth="300" maxWidth="300"/>
                            <TextField fx:id="driversLicenseField" promptText="Driver's License" visible="false" prefWidth="300" maxWidth="300"/>

                            <Label fx:id="workshopFieldsLabel" text="Workshop Details:" style="-fx-font-weight: bold;" visible="false" alignment="CENTER" maxWidth="Infinity"/>
                            <TextField fx:id="workshopNameField" promptText="Workshop Name" visible="false" prefWidth="300" maxWidth="300"/>
                            <TextField fx:id="licenseNumberField" promptText="License Number" visible="false" prefWidth="300" maxWidth="300"/>

                            <Separator/>

                            <HBox alignment="CENTER" spacing="15">
                                <Button fx:id="addButton" text="Add User" styleClass="button-success" prefWidth="100"/>
                                <Button fx:id="updateButton" text="Update" styleClass="button-info" prefWidth="100"/>
                                <Button fx:id="deleteButton" text="Delete" styleClass="button-danger" prefWidth="100"/>
                            </HBox>

                            <ProgressBar fx:id="operationProgress" prefWidth="Infinity" progress="0" visible="false"/>
                            <Label fx:id="statusLabel" styleClass="status-text" alignment="CENTER" maxWidth="Infinity"/>
                        </VBox>
                    </VBox>
                </HBox>

                <HBox alignment="CENTER">
                    <Button fx:id="backButton" text="Back to Dashboard" styleClass="button-secondary" prefWidth="150"/>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <fx:include source="FooterComponent.fxml"/>
    </bottom>
</BorderPane>