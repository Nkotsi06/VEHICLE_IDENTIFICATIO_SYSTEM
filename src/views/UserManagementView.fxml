<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.UserManagementController">

    <top>
        <VBox>
            <fx:include source="MenuBarComponent.fxml"/>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true">
            <SplitPane dividerPositions="0.55">
                <!-- Left Panel - User List -->
                <VBox spacing="10" style="-fx-padding: 15;">
                    <Label text="User List" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

                    <TableView fx:id="usersTable" prefHeight="400">
                        <columns>
                            <TableColumn fx:id="usernameColumn" text="Username" prefWidth="120"/>
                            <TableColumn fx:id="fullNameColumn" text="Full Name" prefWidth="150"/>
                            <TableColumn fx:id="emailColumn" text="Email" prefWidth="180"/>
                            <TableColumn fx:id="roleColumn" text="Role" prefWidth="100"/>
                            <TableColumn fx:id="statusColumn" text="Status" prefWidth="80"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                        <placeholder>
                            <Label text="No users found" style="-fx-text-fill: #7f8c8d;"/>
                        </placeholder>
                    </TableView>

                    <Pagination fx:id="usersPagination" pageCount="1" maxPageIndicatorCount="5"/>

                    <HBox spacing="10">
                        <Button fx:id="refreshButton" text="Refresh" style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;">
                            <effect>
                                <DropShadow radius="3" color="rgba(0,0,0,0.2)"/>
                            </effect>
                        </Button>
                        <Button fx:id="resetPasswordButton" text="Reset Password" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
                        <Button fx:id="fadeButton" text="Animate" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
                    </HBox>

                    <ProgressIndicator fx:id="loadProgress" visible="false" maxWidth="30"/>

                    <!-- Status Label added here -->
                    <Label fx:id="statusLabel" style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;" wrapText="true"/>
                </VBox>

                <!-- Right Panel - User Details -->
                <ScrollPane fitToWidth="true">
                    <VBox spacing="15" style="-fx-padding: 15;">
                        <Label text="User Details" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

                        <GridPane hgap="10" vgap="10">
                            <Label text="Username:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <TextField fx:id="usernameField" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="200"/>

                            <Label text="Full Name:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <TextField fx:id="fullNameField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                            <Label text="Email:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <TextField fx:id="emailField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                            <Label text="Password:" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <PasswordField fx:id="passwordField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                            <Label text="Role:" GridPane.rowIndex="4" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <ComboBox fx:id="roleComboBox" GridPane.rowIndex="4" GridPane.columnIndex="1" prefWidth="200"/>

                            <Label text="Status:" GridPane.rowIndex="5" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <ComboBox fx:id="statusComboBox" GridPane.rowIndex="5" GridPane.columnIndex="1" prefWidth="200"/>
                        </GridPane>

                        <Separator/>

                        <Label text="Additional Information" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>

                        <Label fx:id="customerFieldsLabel" text="Customer Details:" style="-fx-font-weight: bold;"/>
                        <TextField fx:id="addressField" promptText="Address" visible="false" prefWidth="300"/>
                        <TextField fx:id="phoneField" promptText="Phone" visible="false" prefWidth="300"/>
                        <TextField fx:id="nationalIdField" promptText="National ID" visible="false" prefWidth="300"/>
                        <TextField fx:id="driversLicenseField" promptText="Driver's License" visible="false" prefWidth="300"/>

                        <Label fx:id="workshopFieldsLabel" text="Workshop Details:" style="-fx-font-weight: bold;" visible="false"/>
                        <TextField fx:id="workshopNameField" promptText="Workshop Name" visible="false" prefWidth="300"/>
                        <TextField fx:id="licenseNumberField" promptText="License Number" visible="false" prefWidth="300"/>

                        <Separator/>

                        <HBox spacing="15">
                            <Button fx:id="addButton" text="Add" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;">
                                <effect>
                                    <DropShadow radius="3" color="rgba(0,0,0,0.2)"/>
                                </effect>
                            </Button>
                            <Button fx:id="updateButton" text="Update" style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
                            <Button fx:id="deleteButton" text="Delete" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
                        </HBox>

                        <ProgressBar fx:id="operationProgress" prefWidth="Infinity" progress="0" visible="false"/>
                    </VBox>
                </ScrollPane>
            </SplitPane>
        </ScrollPane>
    </center>

    <bottom>
        <VBox>
            <HBox spacing="10" style="-fx-padding: 10;" alignment="CENTER_RIGHT">
                <Button fx:id="backButton" text="Back to Dashboard" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-pref-width: 150;"/>
            </HBox>
            <fx:include source="FooterComponent.fxml"/>
        </VBox>
    </bottom>

</BorderPane>