<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.NotificationController"
            stylesheets="@../css/application.css" styleClass="border-pane">

    <top>
        <fx:include source="MenuBarComponent.fxml"/>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="false" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
            <VBox spacing="20" alignment="TOP_CENTER" styleClass="dashboard-container">
                <padding>
                    <Insets top="25" right="40" bottom="30" left="40"/>
                </padding>

                <Label text="Notifications" styleClass="label-title" alignment="CENTER" maxWidth="Infinity"/>
                <Label text="View and manage your notifications" styleClass="label-subtitle" alignment="CENTER" maxWidth="Infinity"/>

                <Separator/>

                <HBox spacing="25" alignment="CENTER" fillHeight="true">
                    <!-- LEFT PANEL - Notifications List -->
                    <VBox spacing="15" alignment="CENTER" HBox.hgrow="ALWAYS" prefWidth="500">
                        <VBox styleClass="profile-edit-card" alignment="CENTER" prefWidth="500">
                            <Label text="Notifications" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>

                            <ProgressIndicator fx:id="loadProgress" visible="false" maxWidth="30"/>

                            <TableView fx:id="notificationsTable" prefHeight="450" minHeight="400" maxWidth="Infinity">
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                </columnResizePolicy>
                                <columns>
                                    <TableColumn fx:id="messageColumn" text="Message" minWidth="250" prefWidth="300"/>
                                    <TableColumn fx:id="typeColumn" text="Type" minWidth="80" maxWidth="110" prefWidth="90"/>
                                    <TableColumn fx:id="createdAtColumn" text="Date" minWidth="120" maxWidth="160" prefWidth="140"/>
                                    <TableColumn fx:id="statusColumn" text="Status" minWidth="70" maxWidth="90" prefWidth="80"/>
                                </columns>
                                <placeholder>
                                    <Label text="No notifications" styleClass="status-text"/>
                                </placeholder>
                            </TableView>

                            <ProgressBar fx:id="operationProgress" prefWidth="Infinity" progress="0" visible="false"/>

                            <HBox alignment="CENTER" spacing="15">
                                <Button fx:id="markReadButton" text="Mark as Read" styleClass="button-info" prefWidth="120"/>
                                <Button fx:id="markAllReadButton" text="Mark All Read" styleClass="button-primary" prefWidth="120"/>
                                <Button fx:id="refreshButton" text="Refresh" styleClass="button-success" prefWidth="100"/>
                                <Button fx:id="deleteButton" text="Delete" styleClass="button-danger" prefWidth="100"/>
                                <Button fx:id="fadeButton" text="Animate" styleClass="button-warning" prefWidth="100"/>
                            </HBox>
                        </VBox>
                    </VBox>

                    <!-- RIGHT PANEL - Notification Details -->
                    <VBox spacing="15" alignment="CENTER" HBox.hgrow="ALWAYS" prefWidth="400">
                        <VBox styleClass="profile-edit-card" alignment="CENTER" prefWidth="400">
                            <Label text="Notification Details" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>

                            <GridPane hgap="15" vgap="15" alignment="CENTER">
                                <columnConstraints>
                                    <ColumnConstraints halignment="RIGHT" minWidth="80" prefWidth="80"/>
                                    <ColumnConstraints minWidth="200" hgrow="ALWAYS"/>
                                </columnConstraints>

                                <Label text="Type:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <Label fx:id="typeLabel" GridPane.rowIndex="0" GridPane.columnIndex="1" style="-fx-text-fill: #2c3e50;" wrapText="true"/>

                                <Label text="Date:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <Label fx:id="createdAtLabel" GridPane.rowIndex="1" GridPane.columnIndex="1" style="-fx-text-fill: #2c3e50;" wrapText="true"/>

                                <Label text="Reference ID:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <Label fx:id="referenceIdLabel" GridPane.rowIndex="2" GridPane.columnIndex="1" style="-fx-text-fill: #2c3e50;" wrapText="true"/>
                            </GridPane>

                            <Separator/>

                            <Label text="Message:" style="-fx-font-weight: bold;" alignment="CENTER" maxWidth="Infinity"/>
                            <TextArea fx:id="messageArea" prefHeight="250" minHeight="200" wrapText="true" editable="false"
                                      style="-fx-background-color: #f8f9fa; -fx-font-family: monospace; -fx-font-size: 13px;"
                                      maxWidth="Infinity"/>
                        </VBox>
                    </VBox>
                </HBox>

                <Label fx:id="statusLabel" styleClass="status-text" alignment="CENTER" maxWidth="Infinity"/>

                <HBox alignment="CENTER">
                    <Button fx:id="backButton" text="Back to Dashboard" styleClass="button-secondary" prefWidth="150"/>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <fx:include source="FooterComponent.fxml"/>
    </bottom>
</BorderPane>