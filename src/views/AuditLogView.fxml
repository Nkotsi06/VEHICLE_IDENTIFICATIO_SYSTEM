<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.AuditLogController">

    <top>
        <VBox>
            <fx:include source="MenuBarComponent.fxml"/>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true">
            <VBox spacing="15" style="-fx-padding: 20;">

                <!-- Title -->
                <Label text="Audit Logs" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

                <!-- Progress Indicator for Loading -->
                <ProgressIndicator fx:id="loadProgress" visible="false" maxWidth="40" style="-fx-padding: 5;"/>

                <!-- Search and Filter Section -->
                <TitledPane text="Search &amp; Filters" expanded="true" style="-fx-font-weight: bold;">
                    <VBox spacing="10">
                        <GridPane hgap="10" vgap="10">
                            <Label text="Search:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <TextField fx:id="searchField" promptText="Search by user or action..." GridPane.rowIndex="0" GridPane.columnIndex="1" HBox.hgrow="ALWAYS" prefWidth="300"/>

                            <Label text="Action:" GridPane.rowIndex="0" GridPane.columnIndex="2" style="-fx-font-weight: bold;"/>
                            <ComboBox fx:id="actionFilterComboBox" prefWidth="150" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

                            <Label text="From:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <DatePicker fx:id="startDatePicker" GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="150"/>

                            <Label text="To:" GridPane.rowIndex="1" GridPane.columnIndex="2" style="-fx-font-weight: bold;"/>
                            <DatePicker fx:id="endDatePicker" GridPane.rowIndex="1" GridPane.columnIndex="3" prefWidth="150"/>

                            <HBox spacing="10" GridPane.rowIndex="2" GridPane.columnIndex="0" GridPane.columnSpan="4">
                                <Button fx:id="searchButton" text="Search" style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;">
                                    <effect>
                                        <DropShadow radius="3" color="rgba(0,0,0,0.2)"/>
                                    </effect>
                                </Button>
                                <Button fx:id="refreshButton" text="Refresh" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
                                <Button fx:id="fadeButton" text="Animate" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
                            </HBox>
                        </GridPane>
                    </VBox>
                </TitledPane>

                <ProgressBar fx:id="operationProgress" prefWidth="Infinity" progress="0" visible="false" style="-fx-padding: 5;"/>

                <Label text="Audit Log Entries" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <TableView fx:id="auditTable" prefHeight="400">
                    <columns>
                        <TableColumn fx:id="usernameColumn" text="User" prefWidth="150"/>
                        <TableColumn fx:id="actionColumn" text="Action" prefWidth="350"/>
                        <TableColumn fx:id="timestampColumn" text="Timestamp" prefWidth="200"/>
                        <TableColumn fx:id="ipAddressColumn" text="IP Address" prefWidth="150"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                    <placeholder>
                        <Label text="No audit logs found" style="-fx-text-fill: #7f8c8d; -fx-font-size: 14px;"/>
                    </placeholder>
                </TableView>

                <Pagination fx:id="auditPagination" pageCount="1" maxPageIndicatorCount="10"/>

                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <Label fx:id="totalCountLabel" style="-fx-text-fill: #7f8c8d; -fx-font-weight: bold;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="exportButton" text="Export CSV" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
                    <Button fx:id="clearLogsButton" text="Clear Old Logs" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
                    <Button fx:id="backButton" text="Back" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
                </HBox>
            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <fx:include source="FooterComponent.fxml"/>
    </bottom>

</BorderPane>