<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.MobilePatrolController"
            stylesheets="@../css/application.css" styleClass="border-pane">

    <top>
        <fx:include source="MenuBarComponent.fxml"/>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="false" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
            <VBox spacing="20" alignment="TOP_CENTER" styleClass="dashboard-container">
                <padding>
                    <Insets top="25" right="40" bottom="30" left="40"/>
                </padding>

                <Label text="Mobile Patrol Integration" styleClass="label-title" alignment="CENTER" maxWidth="Infinity"/>
                <Label text="Coordinate and track mobile patrol units" styleClass="label-subtitle" alignment="CENTER" maxWidth="Infinity"/>

                <Separator/>

                <ProgressIndicator fx:id="loadProgress" visible="false" maxWidth="40"/>

                <!-- Unit Control Section - FIXED: Removed wrapping HBox -->
                <VBox maxWidth="900" minWidth="600" styleClass="profile-edit-card" alignment="CENTER">
                    <Label text="Unit Control" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>

                    <GridPane hgap="15" vgap="12" alignment="CENTER">
                        <columnConstraints>
                            <ColumnConstraints halignment="RIGHT" minWidth="80" prefWidth="80"/>
                            <ColumnConstraints minWidth="250" hgrow="ALWAYS"/>
                        </columnConstraints>

                        <Label text="Select Unit:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                        <ComboBox fx:id="unitComboBox" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="280"/>
                    </GridPane>

                    <HBox alignment="CENTER" spacing="15">
                        <Button fx:id="syncButton" text="Sync Data" styleClass="button-info" prefWidth="100"/>
                        <Button fx:id="refreshButton" text="Refresh" styleClass="button-primary" prefWidth="100"/>
                        <Button fx:id="fadeButton" text="Animate" styleClass="button-warning" prefWidth="100"/>
                    </HBox>
                </VBox>

                <ProgressBar fx:id="operationProgress" prefWidth="Infinity" progress="0" visible="false"/>

                <!-- Unit Status Card - FIXED: Removed wrapping HBox -->
                <VBox maxWidth="900" minWidth="600" styleClass="profile-card" alignment="CENTER">
                    <Label text="Unit Status" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>

                    <GridPane hgap="25" vgap="15" alignment="CENTER">
                        <columnConstraints>
                            <ColumnConstraints halignment="RIGHT" minWidth="100" prefWidth="100"/>
                            <ColumnConstraints minWidth="200" hgrow="ALWAYS"/>
                            <ColumnConstraints halignment="RIGHT" minWidth="100" prefWidth="100"/>
                            <ColumnConstraints minWidth="200" hgrow="ALWAYS"/>
                        </columnConstraints>

                        <Label text="Status:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                        <Label fx:id="unitStatusLabel" GridPane.rowIndex="0" GridPane.columnIndex="1" style="-fx-text-fill: #27ae60; -fx-font-weight: bold;"/>

                        <Label text="Location:" GridPane.rowIndex="0" GridPane.columnIndex="2" style="-fx-font-weight: bold;"/>
                        <Label fx:id="unitLocationLabel" GridPane.rowIndex="0" GridPane.columnIndex="3" styleClass="status-text"/>

                        <Label text="Last Sync:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                        <Label fx:id="lastSyncLabel" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="status-text"/>

                        <Label text="Battery Level:" GridPane.rowIndex="1" GridPane.columnIndex="2" style="-fx-font-weight: bold;"/>
                        <ProgressBar fx:id="batteryProgress" prefWidth="150" progress="0"/>
                    </GridPane>
                </VBox>

                <Separator/>

                <!-- Update Location Section - FIXED: Removed wrapping HBox -->
                <VBox maxWidth="900" minWidth="600" styleClass="profile-edit-card" alignment="CENTER">
                    <Label text="Update Location" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>

                    <GridPane hgap="15" vgap="12" alignment="CENTER">
                        <columnConstraints>
                            <ColumnConstraints halignment="RIGHT" minWidth="80" prefWidth="80"/>
                            <ColumnConstraints minWidth="200" hgrow="ALWAYS"/>
                        </columnConstraints>

                        <Label text="Latitude:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                        <TextField fx:id="latitudeField" promptText="Latitude" prefWidth="200"/>

                        <Label text="Longitude:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                        <TextField fx:id="longitudeField" promptText="Longitude" prefWidth="200"/>
                    </GridPane>

                    <HBox alignment="CENTER" spacing="15">
                        <Button fx:id="updateLocationButton" text="Update Location" styleClass="button-success" prefWidth="140"/>
                        <Button fx:id="locateButton" text="Locate Unit" styleClass="button-info" prefWidth="120"/>
                    </HBox>
                </VBox>

                <!-- Nearby Stolen Vehicles - FIXED: Removed wrapping HBox, added proper table columns -->
                <VBox styleClass="profile-edit-card" alignment="CENTER" VBox.vgrow="ALWAYS">
                    <Label text="Nearby Stolen Vehicles" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>

                    <TableView fx:id="nearbyStolenTable" prefHeight="220" VBox.vgrow="ALWAYS" maxWidth="Infinity">
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="regColumn" text="Registration" prefWidth="120"/>
                            <TableColumn fx:id="makeColumn" text="Make" prefWidth="100"/>
                            <TableColumn fx:id="modelColumn" text="Model" prefWidth="100"/>
                            <TableColumn fx:id="distanceColumn" text="Distance (km)" prefWidth="100"/>
                            <TableColumn fx:id="theftDateColumn" text="Theft Date" prefWidth="120"/>
                        </columns>
                        <placeholder>
                            <Label text="No stolen vehicles nearby" styleClass="status-text"/>
                        </placeholder>
                    </TableView>

                    <HBox alignment="CENTER">
                        <Pagination fx:id="stolenPagination" pageCount="1" maxPageIndicatorCount="5"/>
                    </HBox>
                </VBox>

                <!-- Alerts and Sync - FIXED: Removed wrapping HBox, using direct HBox -->
                <HBox spacing="25" alignment="CENTER" fillHeight="true">
                    <VBox spacing="12" alignment="CENTER" HBox.hgrow="ALWAYS">
                        <VBox styleClass="profile-edit-card" alignment="CENTER">
                            <Label text="BOLO Alerts" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>
                            <ListView fx:id="boloAlertsList" prefHeight="180" maxWidth="Infinity"/>
                        </VBox>
                    </VBox>
                    <VBox spacing="12" alignment="CENTER" HBox.hgrow="ALWAYS">
                        <VBox styleClass="profile-edit-card" alignment="CENTER">
                            <Label text="Pending Sync" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>
                            <ListView fx:id="pendingSyncList" prefHeight="180" maxWidth="Infinity"/>
                        </VBox>
                    </VBox>
                </HBox>

                <!-- Broadcast Alert Button -->
                <HBox alignment="CENTER">
                    <Button fx:id="alertButton" text="Send Broadcast Alert" styleClass="button-danger" prefWidth="220"/>
                </HBox>

                <Label fx:id="statusLabel" styleClass="status-text" alignment="CENTER" maxWidth="Infinity"/>

                <HBox alignment="CENTER">
                    <Button fx:id="backButton" text="Back to Dashboard" styleClass="button-secondary" prefWidth="150"/>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <fx:include source="FooterComponent.fxml"/>
    </bottom>
</BorderPane>