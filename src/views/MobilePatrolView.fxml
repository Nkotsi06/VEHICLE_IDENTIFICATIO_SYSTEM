<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.MobilePatrolController">

    <top>
        <VBox>
            <fx:include source="MenuBarComponent.fxml"/>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true">
            <VBox spacing="20" style="-fx-padding: 20;">
                <Label text="Mobile Patrol Integration" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <Label text="Coordinate and track mobile patrol units" style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;"/>

                <Separator/>

                <ProgressIndicator fx:id="loadProgress" visible="false" maxWidth="40"/>

                <TitledPane text="Unit Control" expanded="true" style="-fx-font-weight: bold;">
                    <GridPane hgap="10" vgap="10" style="-fx-padding: 10;">
                        <Label text="Select Unit:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                        <ComboBox fx:id="unitComboBox" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="250"/>
                        <Button fx:id="syncButton" text="Sync Data" style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;">
                            <effect>
                                <DropShadow radius="3" color="rgba(0,0,0,0.2)"/>
                            </effect>
                        </Button>
                        <Button fx:id="refreshButton" text="Refresh" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
                        <Button fx:id="fadeButton" text="Animate" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
                    </GridPane>
                </TitledPane>

                <ProgressBar fx:id="operationProgress" prefWidth="Infinity" progress="0" visible="false"/>

                <GridPane hgap="20" vgap="15" style="-fx-background-color: #f8f9fa; -fx-padding: 20; -fx-border-radius: 10;">
                    <Label text="Status:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                    <Label fx:id="unitStatusLabel" GridPane.rowIndex="0" GridPane.columnIndex="1" style="-fx-font-weight: bold;"/>

                    <Label text="Location:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                    <Label fx:id="unitLocationLabel" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <Label text="Last Sync:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                    <Label fx:id="lastSyncLabel" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                    <Label text="Battery Level:" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                    <ProgressBar fx:id="batteryProgress" prefWidth="150" progress="0"/>
                </GridPane>

                <Separator/>

                <TitledPane text="Update Location" expanded="true" style="-fx-font-weight: bold;">
                    <GridPane hgap="15" vgap="10" style="-fx-padding: 15;">
                        <Label text="Latitude:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                        <TextField fx:id="latitudeField" promptText="Latitude" prefWidth="150"/>

                        <Label text="Longitude:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                        <TextField fx:id="longitudeField" promptText="Longitude" prefWidth="150"/>

                        <Button fx:id="updateLocationButton" text="Update Location" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-pref-width: 150;" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    </GridPane>
                </TitledPane>

                <TitledPane text="Nearby Stolen Vehicles" expanded="true" style="-fx-font-weight: bold;">
                    <VBox spacing="10" style="-fx-padding: 10;">
                        <TableView fx:id="nearbyStolenTable" prefHeight="200">
                            <columns>
                                <TableColumn fx:id="regColumn" text="Registration" prefWidth="120"/>
                                <TableColumn fx:id="makeColumn" text="Make" prefWidth="100"/>
                                <TableColumn fx:id="modelColumn" text="Model" prefWidth="100"/>
                                <TableColumn fx:id="distanceColumn" text="Distance (km)" prefWidth="100"/>
                                <TableColumn fx:id="theftDateColumn" text="Theft Date" prefWidth="120"/>
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                            <placeholder>
                                <Label text="No stolen vehicles nearby" style="-fx-text-fill: #7f8c8d;"/>
                            </placeholder>
                        </TableView>
                        <Pagination fx:id="stolenPagination" pageCount="1" maxPageIndicatorCount="5"/>
                    </VBox>
                </TitledPane>

                <SplitPane dividerPositions="0.5">
                    <VBox spacing="10">
                        <Label text="BOLO Alerts" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                        <ListView fx:id="boloAlertsList" prefHeight="150"/>
                    </VBox>
                    <VBox spacing="10">
                        <Label text="Pending Sync" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                        <ListView fx:id="pendingSyncList" prefHeight="150"/>
                    </VBox>
                </SplitPane>

                <Button fx:id="alertButton" text="Send Broadcast Alert" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-pref-width: 200;">
                    <effect>
                        <DropShadow radius="3" color="rgba(0,0,0,0.2)"/>
                    </effect>
                </Button>

                <Label fx:id="statusLabel" style="-fx-text-fill: #7f8c8d; -fx-font-style: italic;"/>
            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <HBox spacing="10" style="-fx-padding: 10;" alignment="CENTER_RIGHT">
            <Button fx:id="backButton" text="Back to Dashboard" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-pref-width: 150;"/>
        </HBox>
        <fx:include source="FooterComponent.fxml"/>
    </bottom>
</BorderPane>