<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ReportScheduleController"
            stylesheets="@../css/application.css" styleClass="border-pane">

    <top>
        <fx:include source="MenuBarComponent.fxml"/>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="false" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
            <VBox spacing="20" alignment="TOP_CENTER" styleClass="dashboard-container">
                <padding>
                    <Insets top="25" right="40" bottom="30" left="40"/>
                </padding>

                <Label text="Report Scheduling" styleClass="label-title" alignment="CENTER" maxWidth="Infinity"/>
                <Label text="Schedule automated report generation" styleClass="label-subtitle" alignment="CENTER" maxWidth="Infinity"/>

                <Separator/>

                <HBox spacing="30" alignment="CENTER" fillHeight="true">
                    <!-- LEFT PANEL - Scheduled Reports -->
                    <VBox spacing="15" alignment="CENTER" HBox.hgrow="ALWAYS" prefWidth="400">
                        <VBox styleClass="profile-edit-card" alignment="CENTER" prefWidth="400">
                            <Label text="Scheduled Reports" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>

                            <ProgressIndicator fx:id="loadProgress" visible="false" maxWidth="30"/>

                            <ListView fx:id="scheduledReportsList" prefHeight="400" minHeight="350" maxWidth="Infinity">
                                <placeholder>
                                    <Label text="No scheduled reports found" styleClass="status-text"/>
                                </placeholder>
                            </ListView>

                            <HBox alignment="CENTER" spacing="15">
                                <Button fx:id="unscheduleButton" text="Unschedule Selected" styleClass="button-danger" prefWidth="160"/>
                                <Button fx:id="refreshButton" text="Refresh" styleClass="button-info" prefWidth="100"/>
                                <Button fx:id="fadeButton" text="Animate" styleClass="button-warning" prefWidth="100"/>
                            </HBox>
                        </VBox>
                    </VBox>

                    <!-- RIGHT PANEL - Schedule New Report -->
                    <VBox spacing="15" alignment="CENTER" HBox.hgrow="ALWAYS" prefWidth="500">
                        <VBox styleClass="profile-edit-card" alignment="CENTER" prefWidth="500">
                            <Label text="Schedule New Report" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>

                            <ProgressBar fx:id="operationProgress" prefWidth="Infinity" progress="0" visible="false"/>

                            <TitledPane text="Report Configuration" expanded="true">
                                <GridPane hgap="15" vgap="15" style="-fx-padding: 15;" alignment="CENTER">
                                    <columnConstraints>
                                        <ColumnConstraints halignment="RIGHT" minWidth="100" prefWidth="100"/>
                                        <ColumnConstraints minWidth="250" hgrow="ALWAYS"/>
                                    </columnConstraints>

                                    <Label text="Report Type:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                    <ComboBox fx:id="reportTypeComboBox" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="300" promptText="Select report type"/>

                                    <Label text="Frequency:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                    <ComboBox fx:id="frequencyComboBox" GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="300" promptText="Select frequency"/>

                                    <Label text="Report Name:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                    <TextField fx:id="reportNameField" GridPane.rowIndex="2" GridPane.columnIndex="1" promptText="Optional - custom report name" prefWidth="300"/>
                                </GridPane>
                            </TitledPane>

                            <TitledPane text="Recipient Information" expanded="true">
                                <GridPane hgap="15" vgap="15" style="-fx-padding: 15;" alignment="CENTER">
                                    <columnConstraints>
                                        <ColumnConstraints halignment="RIGHT" minWidth="100" prefWidth="100"/>
                                        <ColumnConstraints minWidth="250" hgrow="ALWAYS"/>
                                    </columnConstraints>

                                    <Label text="Recipient Email:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                    <TextField fx:id="recipientEmailField" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="350" promptText="email@example.com"/>

                                    <Label text="Format:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                    <ComboBox fx:id="formatComboBox" GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="150"/>
                                </GridPane>
                            </TitledPane>

                            <TitledPane text="Schedule Period" expanded="true">
                                <GridPane hgap="15" vgap="15" style="-fx-padding: 15;" alignment="CENTER">
                                    <columnConstraints>
                                        <ColumnConstraints halignment="RIGHT" minWidth="100" prefWidth="100"/>
                                        <ColumnConstraints minWidth="250" hgrow="ALWAYS"/>
                                    </columnConstraints>

                                    <Label text="Start Date:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                    <DatePicker fx:id="startDatePicker" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="200"/>

                                    <Label text="End Date:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                    <DatePicker fx:id="endDatePicker" GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="200"/>

                                    <Label text="Next Run:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                    <Label fx:id="nextRunLabel" GridPane.rowIndex="2" GridPane.columnIndex="1" style="-fx-text-fill: #27ae60; -fx-font-weight: bold;"/>
                                </GridPane>
                            </TitledPane>

                            <HBox alignment="CENTER" spacing="15">
                                <Button fx:id="scheduleButton" text="Schedule Report" styleClass="button-success" prefWidth="150"/>
                                <Button fx:id="clearButton" text="Clear Form" styleClass="button-secondary" prefWidth="120"/>
                            </HBox>

                            <Separator/>
                            <Label fx:id="statusLabel" styleClass="status-text" alignment="CENTER" maxWidth="Infinity"/>
                        </VBox>
                    </VBox>
                </HBox>

                <HBox alignment="CENTER">
                    <Button fx:id="backButton" text="Back to Dashboard" styleClass="button-secondary" prefWidth="150"/>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <fx:include source="FooterComponent.fxml"/>
    </bottom>
</BorderPane>