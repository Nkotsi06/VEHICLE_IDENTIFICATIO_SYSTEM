<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.WorkshopController">

    <top>
        <VBox>
            <fx:include source="MenuBarComponent.fxml"/>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true">
            <VBox spacing="20" style="-fx-padding: 20;">

                <!-- Welcome Section -->
                <Label fx:id="welcomeLabel" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <Label text="Workshop Dashboard" style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;"/>

                <Separator/>

                <!-- Progress Indicator -->
                <ProgressIndicator fx:id="loadProgress" visible="false" maxWidth="40"/>

                <!-- Pagination for Cards -->
                <Pagination fx:id="cardPagination" pageCount="1" maxPageIndicatorCount="3">
                    <pageFactory>
                        <HBox spacing="15" alignment="CENTER">
                            <VBox fx:id="totalServicesCard" style="-fx-background-color: #3498db; -fx-background-radius: 8; -fx-padding: 15; -fx-alignment: CENTER;" HBox.hgrow="ALWAYS">
                                <Label text="Total Services" style="-fx-text-fill: white; -fx-font-size: 12px;"/>
                                <Label fx:id="totalServicesLabel" text="0" style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: bold;"/>
                            </VBox>

                            <VBox fx:id="totalRevenueCard" style="-fx-background-color: #27ae60; -fx-background-radius: 8; -fx-padding: 15; -fx-alignment: CENTER;" HBox.hgrow="ALWAYS">
                                <Label text="Total Revenue" style="-fx-text-fill: white; -fx-font-size: 12px;"/>
                                <Label fx:id="totalRevenueLabel" text="M0.00" style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: bold;"/>
                            </VBox>

                            <VBox fx:id="activeMechanicsCard" style="-fx-background-color: #9b59b6; -fx-background-radius: 8; -fx-padding: 15; -fx-alignment: CENTER;" HBox.hgrow="ALWAYS">
                                <Label text="Active Mechanics" style="-fx-text-fill: white; -fx-font-size: 12px;"/>
                                <Label fx:id="activeMechanicsLabel" text="0" style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: bold;"/>
                            </VBox>

                            <VBox fx:id="lowStockCard" style="-fx-background-color: #e74c3c; -fx-background-radius: 8; -fx-padding: 15; -fx-alignment: CENTER;" HBox.hgrow="ALWAYS">
                                <Label text="Low Stock Items" style="-fx-text-fill: white; -fx-font-size: 12px;"/>
                                <Label fx:id="lowStockLabel" text="0" style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: bold;"/>
                            </VBox>

                            <VBox fx:id="monthlyVehiclesCard" style="-fx-background-color: #f39c12; -fx-background-radius: 8; -fx-padding: 15; -fx-alignment: CENTER;" HBox.hgrow="ALWAYS">
                                <Label text="Vehicles This Month" style="-fx-text-fill: white; -fx-font-size: 12px;"/>
                                <Label fx:id="monthlyVehiclesLabel" text="0" style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: bold;"/>
                            </VBox>

                            <VBox fx:id="avgServiceCostCard" style="-fx-background-color: #1abc9c; -fx-background-radius: 8; -fx-padding: 15; -fx-alignment: CENTER;" HBox.hgrow="ALWAYS">
                                <Label text="Avg Service Cost" style="-fx-text-fill: white; -fx-font-size: 12px;"/>
                                <Label fx:id="avgServiceCostLabel" text="M0.00" style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: bold;"/>
                            </VBox>
                        </HBox>
                    </pageFactory>
                </Pagination>

                <Separator/>

                <!-- Progress Bar -->
                <ProgressBar fx:id="operationProgress" prefWidth="Infinity" progress="0" visible="false"/>

                <!-- Recent Services Table with Pagination -->
                <TitledPane text="Recent Services" expanded="true" style="-fx-font-weight: bold;">
                    <VBox spacing="10" style="-fx-padding: 10;">
                        <TableView fx:id="recentServicesTable" prefHeight="250">
                            <columns>
                                <TableColumn fx:id="serviceDateCol" text="Date" prefWidth="100"/>
                                <TableColumn fx:id="serviceVehicleCol" text="Vehicle" prefWidth="150"/>
                                <TableColumn fx:id="serviceTypeCol" text="Service Type" prefWidth="200"/>
                                <TableColumn fx:id="serviceCostCol" text="Cost (M)" prefWidth="100"/>
                                <TableColumn fx:id="serviceStatusCol" text="Status" prefWidth="100"/>
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                            <placeholder>
                                <Label text="No recent services" style="-fx-text-fill: #7f8c8d;"/>
                            </placeholder>
                        </TableView>
                        <Pagination fx:id="servicesPagination" pageCount="1" maxPageIndicatorCount="5"/>
                    </VBox>
                </TitledPane>

                <!-- Low Stock Items Table with Pagination -->
                <TitledPane text="Low Stock Alert" expanded="false" style="-fx-font-weight: bold;">
                    <VBox spacing="10" style="-fx-padding: 10;">
                        <TableView fx:id="lowStockTable" prefHeight="200">
                            <columns>
                                <TableColumn fx:id="partNameCol" text="Part Name" prefWidth="200"/>
                                <TableColumn fx:id="partNumberCol" text="Part Number" prefWidth="150"/>
                                <TableColumn fx:id="currentStockCol" text="Current Stock" prefWidth="100"/>
                                <TableColumn fx:id="reorderLevelCol" text="Reorder Level" prefWidth="100"/>
                                <TableColumn fx:id="stockStatusCol" text="Status" prefWidth="100"/>
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                            <placeholder>
                                <Label text="No low stock items" style="-fx-text-fill: #7f8c8d;"/>
                            </placeholder>
                        </TableView>
                        <Pagination fx:id="stockPagination" pageCount="1" maxPageIndicatorCount="5"/>
                    </VBox>
                </TitledPane>

                <!-- Status Label -->
                <Label fx:id="statusLabel" style="-fx-text-fill: #7f8c8d; -fx-font-style: italic;"/>

            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <fx:include source="FooterComponent.fxml"/>
    </bottom>

</BorderPane>