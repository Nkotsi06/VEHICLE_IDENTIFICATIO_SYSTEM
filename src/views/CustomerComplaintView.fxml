<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.CustomerComplaintController"
            stylesheets="@../css/application.css" styleClass="border-pane">

    <top>
        <fx:include source="MenuBarComponent.fxml"/>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="false" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
            <VBox spacing="20" alignment="TOP_CENTER" styleClass="dashboard-container">
                <padding>
                    <Insets top="25" right="40" bottom="30" left="40"/>
                </padding>

                <Label text="Customer Complaints" styleClass="label-title" alignment="CENTER" maxWidth="Infinity"/>
                <Label text="Submit and track complaints against workshops" styleClass="label-subtitle" alignment="CENTER" maxWidth="Infinity"/>

                <Separator/>

                <HBox spacing="25" alignment="CENTER" fillHeight="true">
                    <!-- Left Panel - My Complaints -->
                    <VBox spacing="15" alignment="CENTER" HBox.hgrow="ALWAYS" prefWidth="550">
                        <VBox styleClass="profile-edit-card" alignment="CENTER" prefWidth="550">
                            <Label text="My Complaints" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>

                            <ProgressIndicator fx:id="loadProgress" visible="false" maxWidth="30"/>

                            <TableView fx:id="complaintsTable" prefHeight="450" maxWidth="Infinity">
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                </columnResizePolicy>
                                <columns>
                                    <TableColumn fx:id="workshopColumn" text="Workshop" prefWidth="170"/>
                                    <TableColumn fx:id="complaintDateColumn" text="Date" prefWidth="110"/>
                                    <TableColumn fx:id="complaintTextColumn" text="Complaint" prefWidth="250"/>
                                    <TableColumn fx:id="complaintStatusColumn" text="Status" prefWidth="100"/>
                                </columns>
                                <placeholder>
                                    <Label text="No complaints found" styleClass="status-text"/>
                                </placeholder>
                            </TableView>

                            <HBox spacing="10" alignment="CENTER">
                                <Pagination fx:id="complaintsPagination" pageCount="1" maxPageIndicatorCount="5"/>
                            </HBox>

                            <HBox spacing="15" alignment="CENTER">
                                <Button fx:id="refreshButton" text="Refresh" styleClass="button-info" prefWidth="100"/>
                                <Button fx:id="submitButton" text="New Complaint" styleClass="button-danger" prefWidth="130"/>
                            </HBox>
                        </VBox>
                    </VBox>

                    <!-- Right Panel - Complaint Details -->
                    <VBox spacing="15" alignment="CENTER" HBox.hgrow="ALWAYS" prefWidth="450">
                        <VBox styleClass="profile-edit-card" alignment="CENTER" prefWidth="450">
                            <Label text="Complaint Details" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>

                            <ProgressBar fx:id="operationProgress" prefWidth="Infinity" progress="0" visible="false"/>

                            <GridPane hgap="15" vgap="12" alignment="CENTER">
                                <columnConstraints>
                                    <ColumnConstraints halignment="RIGHT" minWidth="80" prefWidth="80"/>
                                    <ColumnConstraints minWidth="250" hgrow="ALWAYS"/>
                                </columnConstraints>

                                <Label text="Workshop:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <ComboBox fx:id="workshopComboBox" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="280"/>

                                <Label text="Status:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <TextField fx:id="statusField" GridPane.rowIndex="1" GridPane.columnIndex="1" editable="false"/>

                                <Label text="Date:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <Label fx:id="complaintDateLabel" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                            </GridPane>

                            <Label text="Complaint:" style="-fx-font-weight: bold;" alignment="CENTER" maxWidth="Infinity"/>
                            <TextArea fx:id="complaintTextArea" prefHeight="80" promptText="Describe your complaint..."/>

                            <Label text="Resolution Notes:" style="-fx-font-weight: bold;" alignment="CENTER" maxWidth="Infinity"/>
                            <TextArea fx:id="resolutionNotesArea" prefHeight="60" editable="false" promptText="Resolution from management will appear here..."/>

                            <HBox spacing="15" alignment="CENTER">
                                <Button fx:id="sendButton" text="Submit Complaint" styleClass="button-danger" prefWidth="150"/>
                                <Button fx:id="resolveButton" text="Mark Resolved" styleClass="button-success" prefWidth="130" visible="false"/>
                                <Button fx:id="deleteButton" text="Delete" styleClass="button-danger" prefWidth="100" visible="false"/>
                            </HBox>

                            <Label fx:id="statusLabel" styleClass="status-text" alignment="CENTER" maxWidth="Infinity"/>
                        </VBox>
                    </VBox>
                </HBox>

                <HBox spacing="10" alignment="CENTER">
                    <Button fx:id="backButton" text="Back to Dashboard" styleClass="button-secondary" prefWidth="150"/>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <fx:include source="FooterComponent.fxml"/>
    </bottom>
</BorderPane>