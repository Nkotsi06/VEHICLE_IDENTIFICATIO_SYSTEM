<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ProviderComparisonController"
            stylesheets="@../css/application.css" styleClass="border-pane">

    <top>
        <fx:include source="MenuBarComponent.fxml"/>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="false" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
            <VBox spacing="20" alignment="TOP_CENTER" styleClass="dashboard-container">
                <padding>
                    <Insets top="25" right="40" bottom="30" left="40"/>
                </padding>

                <Label text="Insurance Provider Comparison" styleClass="label-title" alignment="CENTER" maxWidth="Infinity"/>
                <Label text="Compare insurance providers to find the best coverage" styleClass="label-subtitle" alignment="CENTER" maxWidth="Infinity"/>

                <Separator/>

                <ProgressIndicator fx:id="loadProgress" visible="false" maxWidth="40"/>

                <!-- Select Vehicle -->
                <HBox alignment="CENTER">
                    <VBox maxWidth="800" minWidth="550" styleClass="profile-edit-card" alignment="CENTER">
                        <Label text="Select Vehicle" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>

                        <GridPane hgap="15" vgap="12" alignment="CENTER">
                            <columnConstraints>
                                <ColumnConstraints halignment="RIGHT" minWidth="100" prefWidth="100"/>
                                <ColumnConstraints minWidth="280" hgrow="ALWAYS"/>
                            </columnConstraints>
                            <Label text="Select Vehicle:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <ComboBox fx:id="vehicleComboBox" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="350"/>
                        </GridPane>

                        <HBox alignment="CENTER" spacing="15">
                            <Button fx:id="compareButton" text="Compare Providers" styleClass="button-primary" prefWidth="160"/>
                            <Button fx:id="fadeButton" text="Animate" styleClass="button-warning" prefWidth="100"/>
                        </HBox>
                    </VBox>
                </HBox>

                <ProgressBar fx:id="operationProgress" prefWidth="Infinity" progress="0" visible="false"/>

                <Label fx:id="vehicleInfoLabel" styleClass="status-text" alignment="CENTER" maxWidth="Infinity"/>

                <!-- Providers Table -->
                <HBox alignment="CENTER">
                    <VBox maxWidth="1200" styleClass="profile-edit-card" alignment="CENTER">
                        <TableView fx:id="providersTable" prefHeight="300" maxWidth="Infinity">
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                            <columns>
                                <TableColumn fx:id="nameColumn" text="Provider Name" prefWidth="170"/>
                                <TableColumn fx:id="ratingColumn" text="Rating" prefWidth="70"/>
                                <TableColumn fx:id="premiumColumn" text="Annual Premium (M)" prefWidth="150"/>
                                <TableColumn fx:id="excessColumn" text="Excess (M)" prefWidth="110"/>
                                <TableColumn fx:id="phoneColumn" text="Phone" prefWidth="130"/>
                                <TableColumn fx:id="emailColumn" text="Email" prefWidth="180"/>
                            </columns>
                            <placeholder>
                                <Label text="Select a vehicle to compare providers" styleClass="status-text"/>
                            </placeholder>
                        </TableView>

                        <HBox alignment="CENTER">
                            <Pagination fx:id="providersPagination" pageCount="1" maxPageIndicatorCount="5"/>
                        </HBox>
                    </VBox>
                </HBox>

                <Separator/>

                <!-- Provider Details -->
                <HBox alignment="CENTER">
                    <VBox maxWidth="1000" styleClass="profile-edit-card" alignment="CENTER">
                        <Label text="Provider Details" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>

                        <GridPane hgap="25" vgap="12" alignment="CENTER">
                            <Label text="Selected Provider:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <Label fx:id="selectedProviderLabel" GridPane.rowIndex="0" GridPane.columnIndex="1" style="-fx-text-fill: #2c3e50;"/>

                            <Label text="Estimated Premium:" GridPane.rowIndex="0" GridPane.columnIndex="2" style="-fx-font-weight: bold;"/>
                            <Label fx:id="premiumEstimateLabel" GridPane.rowIndex="0" GridPane.columnIndex="3" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>

                            <Label text="Coverage Type:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <Label fx:id="coverageTypeLabel" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                            <Label text="Coverage Limit:" GridPane.rowIndex="1" GridPane.columnIndex="2" style="-fx-font-weight: bold;"/>
                            <Label fx:id="coverageLimitLabel" GridPane.rowIndex="1" GridPane.columnIndex="3"/>

                            <Label text="Benefits:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <TextArea fx:id="benefitsArea" GridPane.rowIndex="2" GridPane.columnIndex="1" GridPane.columnSpan="3" prefHeight="60" editable="false"/>
                        </GridPane>
                    </VBox>
                </HBox>

                <HBox spacing="15" alignment="CENTER">
                    <Button fx:id="selectProviderButton" text="Select This Provider" styleClass="button-success" prefWidth="180"/>
                    <Button fx:id="getQuoteButton" text="Get Quote" styleClass="button-warning" prefWidth="120"/>
                </HBox>

                <Label fx:id="statusLabel" styleClass="status-text" alignment="CENTER" maxWidth="Infinity"/>

                <HBox alignment="CENTER">
                    <Button fx:id="backButton" text="Back to Dashboard" styleClass="button-secondary" prefWidth="150"/>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <fx:include source="FooterComponent.fxml"/>
    </bottom>
</BorderPane>