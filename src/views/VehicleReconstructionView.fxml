<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.VehicleReconstructionController"
            stylesheets="@../css/application.css" styleClass="border-pane">

    <top>
        <fx:include source="MenuBarComponent.fxml"/>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="false" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
            <VBox spacing="20" alignment="TOP_CENTER" styleClass="dashboard-container">
                <padding>
                    <Insets top="25" right="40" bottom="30" left="40"/>
                </padding>

                <Label text="Vehicle Movement Reconstruction" styleClass="label-title" alignment="CENTER" maxWidth="Infinity"/>
                <Label text="Reconstruct vehicle movement and detect suspicious patterns" styleClass="label-subtitle" alignment="CENTER" maxWidth="Infinity"/>

                <Separator/>

                <ProgressIndicator fx:id="loadProgress" visible="false" maxWidth="40"/>

                <!-- Reconstruction Parameters -->
                <HBox alignment="CENTER">
                    <VBox maxWidth="900" minWidth="600" styleClass="profile-edit-card" alignment="CENTER">
                        <Label text="Reconstruction Parameters" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>

                        <GridPane hgap="15" vgap="15" alignment="CENTER">
                            <columnConstraints>
                                <ColumnConstraints halignment="RIGHT" minWidth="100" prefWidth="100"/>
                                <ColumnConstraints minWidth="300" hgrow="ALWAYS"/>
                            </columnConstraints>

                            <Label text="Select Vehicle:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <ComboBox fx:id="vehicleComboBox" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="350" promptText="Select vehicle"/>

                            <Label text="Start Date:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <DatePicker fx:id="startDatePicker" GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="200"/>

                            <Label text="End Date:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <DatePicker fx:id="endDatePicker" GridPane.rowIndex="2" GridPane.columnIndex="1" prefWidth="200"/>
                        </GridPane>

                        <HBox alignment="CENTER">
                            <Button fx:id="fadeButton" text="Animate" styleClass="button-warning" prefWidth="100"/>
                        </HBox>
                    </VBox>
                </HBox>

                <ProgressBar fx:id="operationProgress" prefWidth="Infinity" progress="0" visible="false"/>

                <HBox alignment="CENTER" spacing="15">
                    <Button fx:id="reconstructButton" text="Reconstruct Movement" styleClass="button-primary" prefWidth="180"/>
                    <Button fx:id="exportButton" text="Export Report" styleClass="button-success" prefWidth="120"/>
                    <Button fx:id="clearButton" text="Clear" styleClass="button-secondary" prefWidth="100"/>
                </HBox>

                <Separator/>

                <!-- Analysis Results - FIXED: Removed wrapping HBox -->
                <VBox styleClass="profile-card" alignment="CENTER">
                    <Label text="Analysis Results" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>

                    <GridPane hgap="25" vgap="12" alignment="CENTER">
                        <columnConstraints>
                            <ColumnConstraints halignment="RIGHT" minWidth="120" prefWidth="120"/>
                            <ColumnConstraints minWidth="150" hgrow="ALWAYS"/>
                            <ColumnConstraints halignment="RIGHT" minWidth="120" prefWidth="120"/>
                            <ColumnConstraints minWidth="150" hgrow="ALWAYS"/>
                        </columnConstraints>

                        <Label text="Total Distance:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                        <Label fx:id="totalDistanceLabel" GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="status-text"/>

                        <Label text="Average Speed:" GridPane.rowIndex="0" GridPane.columnIndex="2" style="-fx-font-weight: bold;"/>
                        <Label fx:id="averageSpeedLabel" GridPane.rowIndex="0" GridPane.columnIndex="3" styleClass="status-text"/>

                        <Label text="Sightings Count:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                        <Label fx:id="sightingCountLabel" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="status-text"/>

                        <Label text="Suspicious Score:" GridPane.rowIndex="1" GridPane.columnIndex="2" style="-fx-font-weight: bold;"/>
                        <Label fx:id="suspiciousScoreLabel" GridPane.rowIndex="1" GridPane.columnIndex="3" style="-fx-text-fill: #e74c3c; -fx-font-weight: bold;"/>

                        <Label text="Suspicious Level:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                        <Label fx:id="suspiciousLevelLabel" GridPane.rowIndex="2" GridPane.columnIndex="1" style="-fx-text-fill: #e74c3c; -fx-font-weight: bold;"/>

                        <Label text="Confidence:" GridPane.rowIndex="2" GridPane.columnIndex="2" style="-fx-font-weight: bold;"/>
                        <ProgressBar fx:id="confidenceProgress" prefWidth="150" progress="0"/>
                    </GridPane>
                </VBox>

                <!-- Movement Path - FIXED: Removed wrapping HBox, added proper table columns -->
                <VBox spacing="10" alignment="CENTER" VBox.vgrow="ALWAYS" styleClass="profile-edit-card">
                    <Label text="Movement Path" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>

                    <TableView fx:id="movementTable" prefHeight="300" VBox.vgrow="ALWAYS" maxWidth="Infinity">
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="timestampCol" text="Timestamp" prefWidth="160"/>
                            <TableColumn fx:id="locationCol" text="Location" prefWidth="250"/>
                            <TableColumn fx:id="sourceCol" text="Source" prefWidth="120"/>
                            <TableColumn fx:id="confidenceCol" text="Confidence" prefWidth="100"/>
                        </columns>
                        <placeholder>
                            <Label text="No movement data available" styleClass="status-text"/>
                        </placeholder>
                    </TableView>

                    <HBox alignment="CENTER">
                        <Pagination fx:id="movementPagination" pageCount="1" maxPageIndicatorCount="5"/>
                    </HBox>
                </VBox>

                <Label fx:id="statusLabel" styleClass="status-text" alignment="CENTER" maxWidth="Infinity"/>

                <HBox alignment="CENTER">
                    <Button fx:id="backButton" text="Back to Dashboard" styleClass="button-secondary" prefWidth="150"/>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <fx:include source="FooterComponent.fxml"/>
    </bottom>
</BorderPane>