<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.PoliceController"
            stylesheets="@../css/application.css" styleClass="border-pane">

    <top>
        <fx:include source="MenuBarComponent.fxml"/>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="false" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
            <VBox spacing="20" alignment="TOP_CENTER" styleClass="dashboard-container">
                <padding>
                    <Insets top="25" right="40" bottom="30" left="40"/>
                </padding>

                <Label fx:id="welcomeLabel" styleClass="label-title" alignment="CENTER" maxWidth="Infinity"/>
                <Label text="Police Module" styleClass="label-subtitle" alignment="CENTER" maxWidth="Infinity"/>

                <Separator/>

                <ProgressIndicator fx:id="loadProgress" visible="false" maxWidth="40"/>

                <!-- Stats Cards Row 1 - Using FlowPane for proper wrapping -->
                <FlowPane hgap="15" vgap="15" alignment="CENTER">
                    <VBox styleClass="dashboard-card" alignment="CENTER" minWidth="160" prefWidth="180">
                        <Label text="Stolen Vehicles" styleClass="card-title"/>
                        <Label fx:id="stolenCountLabel" text="0" styleClass="card-value" style="-fx-text-fill: #e74c3c;"/>
                    </VBox>

                    <VBox styleClass="dashboard-card" alignment="CENTER" minWidth="160" prefWidth="180">
                        <Label text="Violations (Today)" styleClass="card-title"/>
                        <Label fx:id="violationsTodayLabel" text="0" styleClass="card-value" style="-fx-text-fill: #e67e22;"/>
                    </VBox>

                    <VBox styleClass="dashboard-card" alignment="CENTER" minWidth="160" prefWidth="180">
                        <Label text="Active Warrants" styleClass="card-title"/>
                        <Label fx:id="activeWarrantsLabel" text="0" styleClass="card-value" style="-fx-text-fill: #9b59b6;"/>
                    </VBox>

                    <VBox styleClass="dashboard-card" alignment="CENTER" minWidth="160" prefWidth="180">
                        <Label text="BOLO Alerts" styleClass="card-title"/>
                        <Label fx:id="boloAlertsLabel" text="0" styleClass="card-value" style="-fx-text-fill: #f39c12;"/>
                    </VBox>

                    <VBox styleClass="dashboard-card" alignment="CENTER" minWidth="160" prefWidth="180">
                        <Label text="Expired Documents" styleClass="card-title"/>
                        <Label fx:id="expiredDocsLabel" text="0" styleClass="card-value" style="-fx-text-fill: #e84393;"/>
                    </VBox>

                    <VBox styleClass="dashboard-card" alignment="CENTER" minWidth="160" prefWidth="180">
                        <Label text="Unpaid Fines" styleClass="card-title"/>
                        <Label fx:id="unpaidFinesLabel" text="M0.00" styleClass="card-value" style="-fx-text-fill: #1abc9c;"/>
                    </VBox>
                </FlowPane>

                <!-- Stats Cards Row 2 -->
                <FlowPane hgap="15" vgap="15" alignment="CENTER">
                    <VBox styleClass="dashboard-card" alignment="CENTER" minWidth="160" prefWidth="180">
                        <Label text="Geofence Alerts" styleClass="card-title"/>
                        <Label fx:id="geofenceAlertsLabel" text="0" styleClass="card-value" style="-fx-text-fill: #3498db;"/>
                    </VBox>

                    <VBox styleClass="dashboard-card" alignment="CENTER" minWidth="160" prefWidth="180">
                        <Label text="Active Tracking" styleClass="card-title"/>
                        <Label fx:id="activeTrackingLabel" text="0" styleClass="card-value" style="-fx-text-fill: #2ecc71;"/>
                    </VBox>

                    <VBox styleClass="dashboard-card" alignment="CENTER" minWidth="160" prefWidth="180">
                        <Label text="Reported Incidents" styleClass="card-title"/>
                        <Label fx:id="reportedIncidentsLabel" text="0" styleClass="card-value" style="-fx-text-fill: #1e8449;"/>
                    </VBox>

                    <VBox styleClass="dashboard-card" alignment="CENTER" minWidth="160" prefWidth="180">
                        <Label text="Recovered Vehicles" styleClass="card-title"/>
                        <Label fx:id="recoveredVehiclesLabel" text="0" styleClass="card-value" style="-fx-text-fill: #27ae60;"/>
                    </VBox>
                </FlowPane>

                <Separator/>

                <ProgressBar fx:id="operationProgress" prefWidth="Infinity" progress="0" visible="false"/>

                <!-- Search Section -->
                <HBox alignment="CENTER">
                    <VBox maxWidth="900" minWidth="600" styleClass="profile-edit-card" alignment="CENTER">
                        <Label text="Search Vehicle" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>

                        <HBox spacing="15" alignment="CENTER">
                            <TextField fx:id="searchRegistrationField" promptText="Enter Registration Number" HBox.hgrow="ALWAYS" prefWidth="400"/>
                            <Button fx:id="searchButton" text="Search" styleClass="button-primary" prefWidth="100"/>
                            <Button fx:id="refreshButton" text="Refresh" styleClass="button-info" prefWidth="100"/>
                            <Button fx:id="fadeButton" text="Animate" styleClass="button-warning" prefWidth="100"/>
                        </HBox>
                    </VBox>
                </HBox>

                <!-- Recent Police Activity Table -->
                <VBox styleClass="profile-edit-card" alignment="CENTER" spacing="10" VBox.vgrow="ALWAYS">
                    <Label text="Recent Police Activity" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>

                    <TableView fx:id="recentActivityTable" prefHeight="400" maxWidth="Infinity">
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="activityTimeColumn" text="Time" prefWidth="170"/>
                            <TableColumn fx:id="activityActionColumn" text="Action" prefWidth="250"/>
                            <TableColumn fx:id="activityVehicleColumn" text="Vehicle" prefWidth="140"/>
                            <TableColumn fx:id="activityOfficerColumn" text="Officer" prefWidth="140"/>
                        </columns>
                        <placeholder>
                            <Label text="No recent activity" styleClass="status-text"/>
                        </placeholder>
                    </TableView>

                    <HBox alignment="CENTER">
                        <Pagination fx:id="activityPagination" pageCount="1" maxPageIndicatorCount="5"/>
                    </HBox>
                </VBox>

                <Label fx:id="statusLabel" styleClass="status-text" alignment="CENTER" maxWidth="Infinity"/>

                <HBox alignment="CENTER">
                    <Button fx:id="backButton" text="Back to Dashboard" styleClass="button-secondary" prefWidth="150"/>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <fx:include source="FooterComponent.fxml"/>
    </bottom>
</BorderPane>