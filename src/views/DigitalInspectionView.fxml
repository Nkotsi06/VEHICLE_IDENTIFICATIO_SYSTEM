<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.DigitalInspectionController">

    <top>
        <VBox>
            <fx:include source="MenuBarComponent.fxml"/>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true">
            <VBox spacing="20" style="-fx-padding: 20;">
                <Label text="Digital Vehicle Inspection" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <Label text="Conduct digital vehicle inspections" style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;"/>

                <Separator/>

                <ProgressIndicator fx:id="loadProgress" visible="false" maxWidth="40"/>

                <TitledPane text="Inspection Setup" expanded="true" style="-fx-font-weight: bold;">
                    <GridPane hgap="15" vgap="10" style="-fx-padding: 10;">
                        <Label text="Service Record:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                        <ComboBox fx:id="serviceRecordComboBox" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="300"/>

                        <Label text="Inspector Name:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                        <TextField fx:id="inspectorNameField" GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="250"/>

                        <Button fx:id="startInspectionButton" text="Start Inspection" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" GridPane.rowIndex="1" GridPane.columnIndex="2">
                            <effect>
                                <DropShadow radius="3" color="rgba(0,0,0,0.2)"/>
                            </effect>
                        </Button>
                        <Button fx:id="fadeButton" text="Animate" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                    </GridPane>
                </TitledPane>

                <ProgressBar fx:id="operationProgress" prefWidth="Infinity" progress="0" visible="false"/>

                <GridPane hgap="20" vgap="10" style="-fx-background-color: #f8f9fa; -fx-padding: 15; -fx-border-radius: 8;">
                    <Label text="Inspection ID:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                    <Label fx:id="inspectionIdLabel" GridPane.rowIndex="0" GridPane.columnIndex="1" style="-fx-text-fill: #2c3e50;"/>

                    <Label text="Status:" GridPane.rowIndex="0" GridPane.columnIndex="2" style="-fx-font-weight: bold;"/>
                    <Label fx:id="statusLabel" GridPane.rowIndex="0" GridPane.columnIndex="3" style="-fx-text-fill: #f39c12; -fx-font-weight: bold;"/>

                    <Label text="Vehicle:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                    <Label fx:id="vehicleInfoLabel" GridPane.rowIndex="1" GridPane.columnIndex="1" GridPane.columnSpan="3" style="-fx-text-fill: #2c3e50;"/>
                </GridPane>

                <Separator/>

                <Label text="Inspection Checklist" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <TableView fx:id="checklistTable" prefHeight="250">
                    <columns>
                        <TableColumn fx:id="itemNameColumn" text="Inspection Item" prefWidth="250"/>
                        <TableColumn fx:id="statusColumn" text="Status" prefWidth="100"/>
                        <TableColumn fx:id="notesColumn" text="Notes" prefWidth="300"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                    <placeholder>
                        <Label text="No inspection items" style="-fx-text-fill: #7f8c8d;"/>
                    </placeholder>
                </TableView>

                <Pagination fx:id="checklistPagination" pageCount="1" maxPageIndicatorCount="5"/>

                <TitledPane text="Add Inspection Item" expanded="true" style="-fx-font-weight: bold;">
                    <GridPane hgap="15" vgap="10" style="-fx-padding: 10;">
                        <Label text="Item Name:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                        <TextField fx:id="newItemField" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="250" HBox.hgrow="ALWAYS"/>

                        <Label text="Status:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                        <ComboBox fx:id="newItemStatusComboBox" GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="150">
                            <items>
                                <FXCollections fx:factory="observableArrayList">
                                    <String fx:value="PASS"/>
                                    <String fx:value="FAIL"/>
                                    <String fx:value="WARNING"/>
                                    <String fx:value="N/A"/>
                                </FXCollections>
                            </items>
                        </ComboBox>

                        <Label text="Notes:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                        <TextArea fx:id="newItemNotesArea" GridPane.rowIndex="2" GridPane.columnIndex="1" prefHeight="60"/>

                        <Button fx:id="addItemButton" text="Add Item" style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                    </GridPane>
                </TitledPane>

                <Separator/>

                <GridPane hgap="15" vgap="10">
                    <Label text="Overall Condition:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                    <ComboBox fx:id="overallConditionComboBox" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="150">
                        <items>
                            <FXCollections fx:factory="observableArrayList">
                                <String fx:value="Excellent"/>
                                <String fx:value="Good"/>
                                <String fx:value="Fair"/>
                                <String fx:value="Poor"/>
                                <String fx:value="Critical"/>
                            </FXCollections>
                        </items>
                    </ComboBox>

                    <Label text="Recommendations:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                    <TextArea fx:id="recommendationsArea" GridPane.rowIndex="1" GridPane.columnIndex="1" prefHeight="80"/>
                </GridPane>

                <HBox spacing="10" alignment="CENTER">
                    <Button fx:id="completeInspectionButton" text="Complete Inspection" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-pref-width: 180;" disable="true">
                        <effect>
                            <DropShadow radius="3" color="rgba(0,0,0,0.2)"/>
                        </effect>
                    </Button>
                    <Button fx:id="generateReportButton" text="Generate Report" style="-fx-background-color: #9b59b6; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-pref-width: 150;" disable="true"/>
                </HBox>

                <Label fx:id="messageLabel" style="-fx-text-fill: #7f8c8d; -fx-font-style: italic;"/>
            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <HBox spacing="10" style="-fx-padding: 10;" alignment="CENTER_RIGHT">
            <Button fx:id="backButton" text="Back to Dashboard" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-pref-width: 150;"/>
        </HBox>
        <fx:include source="FooterComponent.fxml"/>
    </bottom>
</BorderPane>