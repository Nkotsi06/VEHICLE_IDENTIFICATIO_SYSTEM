<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.DigitalInspectionController"
            stylesheets="@../css/application.css" styleClass="border-pane">

    <top>
        <fx:include source="MenuBarComponent.fxml"/>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="false" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
            <VBox spacing="20" alignment="TOP_CENTER" styleClass="dashboard-container">
                <padding>
                    <Insets top="25" right="40" bottom="30" left="40"/>
                </padding>

                <Label text="Digital Vehicle Inspection" styleClass="label-title" alignment="CENTER" maxWidth="Infinity"/>
                <Label text="Conduct digital vehicle inspections" styleClass="label-subtitle" alignment="CENTER" maxWidth="Infinity"/>

                <Separator/>

                <ProgressIndicator fx:id="loadProgress" visible="false" maxWidth="40"/>

                <!-- Inspection Setup -->
                <HBox alignment="CENTER">
                    <VBox maxWidth="900" minWidth="600" styleClass="profile-edit-card" alignment="CENTER">
                        <Label text="Inspection Setup" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>

                        <GridPane hgap="15" vgap="12" alignment="CENTER">
                            <columnConstraints>
                                <ColumnConstraints halignment="RIGHT" minWidth="120" prefWidth="120"/>
                                <ColumnConstraints minWidth="250" hgrow="ALWAYS"/>
                            </columnConstraints>

                            <Label text="Service Record:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <ComboBox fx:id="serviceRecordComboBox" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="300"/>

                            <Label text="Inspector Name:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <TextField fx:id="inspectorNameField" GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="250"/>
                        </GridPane>

                        <HBox spacing="15" alignment="CENTER">
                            <Button fx:id="startInspectionButton" text="Start Inspection" styleClass="button-success" prefWidth="140"/>
                            <Button fx:id="fadeButton" text="Animate" styleClass="button-warning" prefWidth="100"/>
                        </HBox>
                    </VBox>
                </HBox>

                <ProgressBar fx:id="operationProgress" prefWidth="Infinity" progress="0" visible="false"/>

                <!-- Inspection Info -->
                <HBox alignment="CENTER">
                    <VBox maxWidth="900" minWidth="600" styleClass="profile-card" alignment="CENTER">
                        <GridPane hgap="20" vgap="10" alignment="CENTER">
                            <columnConstraints>
                                <ColumnConstraints halignment="RIGHT" minWidth="120" prefWidth="120"/>
                                <ColumnConstraints minWidth="200" hgrow="ALWAYS"/>
                                <ColumnConstraints halignment="RIGHT" minWidth="120" prefWidth="120"/>
                                <ColumnConstraints minWidth="200" hgrow="ALWAYS"/>
                            </columnConstraints>

                            <Label text="Inspection ID:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <Label fx:id="inspectionIdLabel" GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="status-text"/>

                            <Label text="Status:" GridPane.rowIndex="0" GridPane.columnIndex="2" style="-fx-font-weight: bold;"/>
                            <Label fx:id="statusLabel" GridPane.rowIndex="0" GridPane.columnIndex="3" style="-fx-text-fill: #f39c12; -fx-font-weight: bold;"/>

                            <Label text="Vehicle:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <Label fx:id="vehicleInfoLabel" GridPane.rowIndex="1" GridPane.columnIndex="1" GridPane.columnSpan="3" styleClass="status-text"/>
                        </GridPane>
                    </VBox>
                </HBox>

                <Separator/>

                <!-- Inspection Checklist -->
                <Label text="Inspection Checklist" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>

                <TableView fx:id="checklistTable" prefHeight="250" minHeight="200" maxWidth="Infinity">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="itemNameColumn" text="Inspection Item" prefWidth="250"/>
                        <TableColumn fx:id="statusColumn" text="Status" prefWidth="100"/>
                        <TableColumn fx:id="notesColumn" text="Notes" prefWidth="300"/>
                    </columns>
                    <placeholder>
                        <Label text="No inspection items" styleClass="status-text"/>
                    </placeholder>
                </TableView>

                <HBox alignment="CENTER">
                    <Pagination fx:id="checklistPagination" pageCount="1" maxPageIndicatorCount="5"/>
                </HBox>

                <!-- Add Item Section -->
                <HBox alignment="CENTER">
                    <VBox maxWidth="900" minWidth="600" styleClass="profile-edit-card" alignment="CENTER">
                        <Label text="Add Inspection Item" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>

                        <GridPane hgap="15" vgap="12" alignment="CENTER">
                            <columnConstraints>
                                <ColumnConstraints halignment="RIGHT" minWidth="100" prefWidth="100"/>
                                <ColumnConstraints minWidth="250" hgrow="ALWAYS"/>
                            </columnConstraints>

                            <Label text="Item Name:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <TextField fx:id="newItemField" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="250"/>

                            <Label text="Status:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <ComboBox fx:id="newItemStatusComboBox" GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="150"/>

                            <Label text="Notes:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <TextArea fx:id="newItemNotesArea" GridPane.rowIndex="2" GridPane.columnIndex="1" prefHeight="60"/>
                        </GridPane>

                        <HBox alignment="CENTER">
                            <Button fx:id="addItemButton" text="Add Item" styleClass="button-info" prefWidth="120"/>
                        </HBox>
                    </VBox>
                </HBox>

                <Separator/>

                <!-- Overall Assessment -->
                <HBox alignment="CENTER">
                    <VBox maxWidth="900" minWidth="600" styleClass="profile-edit-card" alignment="CENTER">
                        <GridPane hgap="15" vgap="12" alignment="CENTER">
                            <columnConstraints>
                                <ColumnConstraints halignment="RIGHT" minWidth="120" prefWidth="120"/>
                                <ColumnConstraints minWidth="250" hgrow="ALWAYS"/>
                            </columnConstraints>

                            <Label text="Overall Condition:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <ComboBox fx:id="overallConditionComboBox" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="150"/>

                            <Label text="Recommendations:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <TextArea fx:id="recommendationsArea" GridPane.rowIndex="1" GridPane.columnIndex="1" prefHeight="80"/>
                        </GridPane>
                    </VBox>
                </HBox>

                <!-- Action Buttons -->
                <HBox spacing="15" alignment="CENTER">
                    <Button fx:id="completeInspectionButton" text="Complete Inspection" styleClass="button-success" prefWidth="180" disable="true"/>
                    <Button fx:id="generateReportButton" text="Generate Report" styleClass="button-primary" prefWidth="150" disable="true"/>
                </HBox>

                <Label fx:id="messageLabel" styleClass="status-text" alignment="CENTER" maxWidth="Infinity"/>

                <HBox alignment="CENTER">
                    <Button fx:id="backButton" text="Back to Dashboard" styleClass="button-secondary" prefWidth="150"/>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <fx:include source="FooterComponent.fxml"/>
    </bottom>
</BorderPane>