<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.RoleManagementController"
            stylesheets="@../css/application.css" styleClass="border-pane">

    <top>
        <fx:include source="MenuBarComponent.fxml"/>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="false" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
            <VBox spacing="20" alignment="TOP_CENTER" styleClass="dashboard-container">
                <padding>
                    <Insets top="25" right="40" bottom="30" left="40"/>
                </padding>

                <Label text="Role Based Access Control (RBAC)" styleClass="label-title" alignment="CENTER" maxWidth="Infinity"/>
                <Label text="Manage user roles and their permissions" styleClass="label-subtitle" alignment="CENTER" maxWidth="Infinity"/>

                <Separator/>

                <ProgressIndicator fx:id="loadProgress" visible="false" maxWidth="40"/>

                <!-- Role Selection Section -->
                <HBox alignment="CENTER">
                    <VBox maxWidth="900" minWidth="500" styleClass="profile-edit-card" alignment="CENTER">
                        <Label text="Role Selection" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>
                        <HBox spacing="15" alignment="CENTER">
                            <Label text="Select Role:" style="-fx-font-weight: bold;"/>
                            <ComboBox fx:id="roleComboBox" prefWidth="250" promptText="Choose a role"/>
                            <Button fx:id="refreshButton" text="Load Permissions" styleClass="button-primary" prefWidth="150"/>
                            <Button fx:id="fadeButton" text="Animate" styleClass="button-warning" prefWidth="100"/>
                        </HBox>
                    </VBox>
                </HBox>

                <Separator/>

                <ProgressBar fx:id="operationProgress" prefWidth="Infinity" progress="0" visible="false"/>

                <!-- Permissions Table Section -->
                <HBox alignment="CENTER">
                    <VBox maxWidth="1000" minWidth="600" styleClass="profile-edit-card" alignment="CENTER">
                        <Label text="Permissions" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>

                        <TableView fx:id="permissionsTable" prefHeight="450" maxWidth="Infinity">
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                            <columns>
                                <TableColumn fx:id="permissionKeyColumn" text="Permission" prefWidth="500"/>
                                <TableColumn fx:id="permissionValueColumn" text="Granted" prefWidth="120"/>
                            </columns>
                            <placeholder>
                                <Label text="No permissions found for selected role" styleClass="status-text"/>
                            </placeholder>
                        </TableView>

                        <Label fx:id="permissionCountLabel" styleClass="status-text" alignment="CENTER" maxWidth="Infinity"/>
                    </VBox>
                </HBox>

                <Separator/>

                <!-- Manage Permission Section -->
                <HBox alignment="CENTER">
                    <VBox maxWidth="800" minWidth="500" styleClass="profile-edit-card" alignment="CENTER">
                        <Label text="Manage Permission" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>

                        <GridPane hgap="15" vgap="12" alignment="CENTER">
                            <columnConstraints>
                                <ColumnConstraints halignment="RIGHT" minWidth="100" prefWidth="100"/>
                                <ColumnConstraints minWidth="300" hgrow="ALWAYS"/>
                            </columnConstraints>

                            <Label text="Permission:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <ComboBox fx:id="permissionComboBox" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="400" promptText="Select a permission"/>

                            <Label text="Action:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <HBox spacing="20" GridPane.rowIndex="1" GridPane.columnIndex="1" alignment="CENTER_LEFT">
                                <CheckBox fx:id="grantCheckBox" text="Grant Permission" style="-fx-font-weight: bold;"/>
                                <Button fx:id="applyButton" text="Apply Changes" styleClass="button-success" prefWidth="150"/>
                            </HBox>
                        </GridPane>
                    </VBox>
                </HBox>

                <Label fx:id="statusLabel" styleClass="status-text" alignment="CENTER" maxWidth="Infinity"/>

                <HBox alignment="CENTER">
                    <Button fx:id="backButton" text="Back to Dashboard" styleClass="button-secondary" prefWidth="150"/>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <fx:include source="FooterComponent.fxml"/>
    </bottom>
</BorderPane>