<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.RoleManagementController">

    <top>
        <VBox>
            <fx:include source="MenuBarComponent.fxml"/>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="false" vbarPolicy="AS_NEEDED" hbarPolicy="NEVER"
                    style="-fx-background-color: #f0f2f5; -fx-background: #f0f2f5;">
            <VBox spacing="20" style="-fx-padding: 25; -fx-background-color: #f0f2f5;">

                <Label text="Role Based Access Control (RBAC)" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <Label text="Manage user roles and their permissions" style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;"/>

                <Separator/>

                <ProgressIndicator fx:id="loadProgress" visible="false" maxWidth="40"/>

                <TitledPane text="Role Selection" expanded="true" style="-fx-font-weight: bold;">
                    <GridPane hgap="10" vgap="10" style="-fx-padding: 10;">
                        <Label text="Select Role:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                        <ComboBox fx:id="roleComboBox" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="200" promptText="Choose a role"/>
                        <Button fx:id="refreshButton" text="Load Permissions" GridPane.rowIndex="0" GridPane.columnIndex="2" style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;">
                            <effect>
                                <DropShadow radius="3" color="rgba(0,0,0,0.2)"/>
                            </effect>
                        </Button>
                        <Button fx:id="fadeButton" text="Animate" GridPane.rowIndex="0" GridPane.columnIndex="3" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;">
                            <effect>
                                <DropShadow radius="3" color="rgba(0,0,0,0.2)"/>
                            </effect>
                        </Button>
                    </GridPane>
                </TitledPane>

                <Separator/>

                <ProgressBar fx:id="operationProgress" prefWidth="Infinity" progress="0" visible="false"/>

                <TitledPane text="Permissions" expanded="true" style="-fx-font-weight: bold; -fx-background-color: white;">
                    <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 10;">
                        <TableView fx:id="permissionsTable" prefHeight="450" minHeight="300" VBox.vgrow="ALWAYS"
                                   style="-fx-background-color: white; -fx-border-color: #dddddd; -fx-border-width: 1; -fx-border-radius: 5;">
                            <columns>
                                <TableColumn fx:id="permissionKeyColumn" text="Permission" minWidth="400"/>
                                <TableColumn fx:id="permissionValueColumn" text="Granted" minWidth="100" maxWidth="150"/>
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                            <placeholder>
                                <Label text="No permissions found for selected role" style="-fx-text-fill: #7f8c8d; -fx-font-size: 14px;"/>
                            </placeholder>
                        </TableView>

                        <Label fx:id="permissionCountLabel" style="-fx-text-fill: #7f8c8d; -fx-font-style: italic;"/>
                    </VBox>
                </TitledPane>

                <Separator/>

                <TitledPane text="Manage Permission" expanded="true" style="-fx-font-weight: bold; -fx-background-color: white;">
                    <VBox spacing="15" style="-fx-padding: 10; -fx-background-color: white;">
                        <GridPane hgap="10" vgap="10">
                            <Label text="Permission:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <ComboBox fx:id="permissionComboBox" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="350" promptText="Select a permission"/>

                            <Label text="Action:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <CheckBox fx:id="grantCheckBox" text="Grant Permission" GridPane.rowIndex="1" GridPane.columnIndex="1" style="-fx-font-weight: bold;"/>

                            <HBox spacing="10" GridPane.rowIndex="2" GridPane.columnIndex="1">
                                <Button fx:id="applyButton" text="Apply Changes" prefWidth="150"
                                        style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;">
                                    <effect>
                                        <DropShadow radius="3" color="rgba(0,0,0,0.2)"/>
                                    </effect>
                                </Button>
                            </HBox>
                        </GridPane>
                    </VBox>
                </TitledPane>

                <Label fx:id="statusLabel" style="-fx-text-fill: #7f8c8d; -fx-font-style: italic;"/>

                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <Button fx:id="backButton" text="Back to Dashboard" prefWidth="160"
                            style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;">
                        <effect>
                            <DropShadow radius="3" color="rgba(0,0,0,0.2)"/>
                        </effect>
                    </Button>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <fx:include source="FooterComponent.fxml"/>
    </bottom>

</BorderPane>