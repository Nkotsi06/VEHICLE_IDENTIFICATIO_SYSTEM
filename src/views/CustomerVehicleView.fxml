<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.CustomerVehicleController"
            stylesheets="@../css/application.css" styleClass="border-pane">

    <top>
        <fx:include source="MenuBarComponent.fxml"/>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="false" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
            <VBox spacing="20" alignment="TOP_CENTER" styleClass="dashboard-container">
                <padding>
                    <Insets top="25" right="40" bottom="30" left="40"/>
                </padding>

                <Label text="My Vehicles" styleClass="label-title" alignment="CENTER" maxWidth="Infinity"/>
                <Label fx:id="customerNameLabel" styleClass="status-text" alignment="CENTER" maxWidth="Infinity"/>
                <Label fx:id="vehicleCountLabel" styleClass="status-text" alignment="CENTER" maxWidth="Infinity"/>

                <Separator/>

                <ProgressIndicator fx:id="loadProgress" visible="false" maxWidth="40"/>

                <TableView fx:id="vehiclesTable" prefHeight="350" maxWidth="Infinity">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="registrationColumn" text="Registration" prefWidth="120"/>
                        <TableColumn fx:id="makeColumn" text="Make" prefWidth="90"/>
                        <TableColumn fx:id="modelColumn" text="Model" prefWidth="90"/>
                        <TableColumn fx:id="yearColumn" text="Year" prefWidth="70"/>
                        <TableColumn fx:id="vehicleStatusColumn" text="Status" prefWidth="100"/>
                        <TableColumn fx:id="colorColumn" text="Color" prefWidth="80"/>
                        <TableColumn fx:id="engineNumberColumn" text="Engine #" prefWidth="120"/>
                    </columns>
                    <placeholder>
                        <Label text="No vehicles found" styleClass="status-text"/>
                    </placeholder>
                </TableView>

                <HBox spacing="10" alignment="CENTER">
                    <Pagination fx:id="vehiclesPagination" pageCount="1" maxPageIndicatorCount="5"/>
                </HBox>

                <ProgressBar fx:id="operationProgress" prefWidth="Infinity" progress="0" visible="false"/>

                <HBox spacing="15" alignment="CENTER">
                    <Button fx:id="viewDetailsButton" text="View Details" styleClass="button-info" prefWidth="110"/>
                    <Button fx:id="viewHistoryButton" text="Service History" styleClass="button-success" prefWidth="120"/>
                    <Button fx:id="viewInsuranceButton" text="Insurance" styleClass="button-primary" prefWidth="100"/>
                    <Button fx:id="refreshButton" text="Refresh" styleClass="button-info" prefWidth="100"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="backButton" text="Back to Dashboard" styleClass="button-secondary" prefWidth="160"/>
                </HBox>

                <Label fx:id="statusLabel" styleClass="status-text" alignment="CENTER" maxWidth="Infinity"/>

            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <fx:include source="FooterComponent.fxml"/>
    </bottom>
</BorderPane>