<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.DocumentExpiryCalendarController"
            stylesheets="@../css/application.css" styleClass="border-pane">

    <top>
        <fx:include source="MenuBarComponent.fxml"/>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="false" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
            <VBox spacing="20" alignment="TOP_CENTER" styleClass="dashboard-container">
                <padding>
                    <Insets top="25" right="40" bottom="30" left="40"/>
                </padding>

                <Label text="Document Expiry Calendar" styleClass="label-title" alignment="CENTER" maxWidth="Infinity"/>
                <Label text="Track important document expiry dates" styleClass="label-subtitle" alignment="CENTER" maxWidth="Infinity"/>

                <Separator/>

                <ProgressIndicator fx:id="loadProgress" visible="false" maxWidth="40"/>

                <!-- Search Controls - Using FlowPane for proper wrapping -->
                <HBox alignment="CENTER">
                    <VBox maxWidth="1000" minWidth="700" styleClass="profile-edit-card" alignment="CENTER">
                        <FlowPane hgap="15" vgap="10" alignment="CENTER">
                            <Label text="Vehicle:" style="-fx-font-weight: bold;"/>
                            <ComboBox fx:id="vehicleComboBox" prefWidth="250"/>
                            <Label text="Year:" style="-fx-font-weight: bold;"/>
                            <ComboBox fx:id="yearComboBox" prefWidth="80"/>
                            <Label text="Month:" style="-fx-font-weight: bold;"/>
                            <ComboBox fx:id="monthComboBox" prefWidth="80"/>
                            <Button fx:id="loadButton" text="Load" styleClass="button-primary" prefWidth="100"/>
                            <Button fx:id="refreshButton" text="Refresh" styleClass="button-info" prefWidth="100"/>
                            <Button fx:id="fadeButton" text="Animate" styleClass="button-warning" prefWidth="100"/>
                        </FlowPane>
                    </VBox>
                </HBox>

                <ProgressBar fx:id="operationProgress" prefWidth="Infinity" progress="0" visible="false"/>

                <!-- Statistics Cards - Using FlowPane for proper wrapping -->
                <FlowPane hgap="25" vgap="15" alignment="CENTER">
                    <VBox spacing="8" alignment="CENTER" styleClass="dashboard-card" minWidth="180" prefWidth="200">
                        <Label text="Expired" style="-fx-text-fill: #e74c3c; -fx-font-weight: bold;"/>
                        <Label fx:id="expiredCountLabel" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #e74c3c;"/>
                    </VBox>

                    <VBox spacing="8" alignment="CENTER" styleClass="dashboard-card" minWidth="180" prefWidth="200">
                        <Label text="Expiring Soon (30 days)" style="-fx-text-fill: #f39c12; -fx-font-weight: bold;"/>
                        <Label fx:id="expiringSoonLabel" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #f39c12;"/>
                    </VBox>

                    <VBox spacing="8" alignment="CENTER" styleClass="dashboard-card" minWidth="180" prefWidth="200">
                        <Label text="Valid" style="-fx-text-fill: #27ae60; -fx-font-weight: bold;"/>
                        <Label fx:id="validCountLabel" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
                    </VBox>
                </FlowPane>

                <Separator/>

                <Label text="Calendar View" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>
                <Label fx:id="monthYearLabel" styleClass="status-text" alignment="CENTER" maxWidth="Infinity"/>

                <!-- Calendar Grid - Centered -->
                <HBox alignment="CENTER">
                    <GridPane fx:id="calendarGrid" hgap="8" vgap="8" alignment="CENTER"/>
                </HBox>

                <Separator/>

                <Label text="Expiring Documents" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>

                <!-- Table with proper column configuration - REMOVED restrictive maxWidth -->
                <TableView fx:id="expiringDocumentsTable" prefHeight="250" minHeight="200" maxWidth="Infinity">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="documentTypeColumn" text="Document Type" prefWidth="180"/>
                        <TableColumn fx:id="documentNumberColumn" text="Document Number" prefWidth="180"/>
                        <TableColumn fx:id="expiryDateColumn" text="Expiry Date" prefWidth="120"/>
                        <TableColumn fx:id="expiryStatusColumn" text="Status" prefWidth="100"/>
                    </columns>
                    <placeholder>
                        <Label text="No expiring documents" styleClass="status-text"/>
                    </placeholder>
                </TableView>

                <HBox alignment="CENTER">
                    <Pagination fx:id="documentsPagination" pageCount="1" maxPageIndicatorCount="5"/>
                </HBox>

                <Label fx:id="statusLabel" styleClass="status-text" alignment="CENTER" maxWidth="Infinity"/>

                <HBox alignment="CENTER">
                    <Button fx:id="backButton" text="Back to Dashboard" styleClass="button-secondary" prefWidth="150"/>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <fx:include source="FooterComponent.fxml"/>
    </bottom>
</BorderPane>