<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.InsuranceController">

    <top>
        <VBox>
            <fx:include source="MenuBarComponent.fxml"/>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true">
            <VBox spacing="20" style="-fx-padding: 20;">

                <!-- Welcome Section -->
                <Label fx:id="welcomeLabel" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <Label text="Insurance Provider Dashboard" style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;"/>

                <Separator/>

                <!-- Progress Indicator -->
                <ProgressIndicator fx:id="loadProgress" visible="false" maxWidth="40"/>

                <!-- Pagination for Cards -->
                <Pagination fx:id="cardPagination" pageCount="1" maxPageIndicatorCount="3">
                    <pageFactory>
                        <!-- Statistics Cards Row 1 -->
                        <HBox spacing="15" alignment="CENTER">
                            <VBox fx:id="activePoliciesCard" style="-fx-background-color: #3498db; -fx-background-radius: 8; -fx-padding: 15; -fx-alignment: CENTER;" HBox.hgrow="ALWAYS">
                                <Label text="Active Policies" style="-fx-text-fill: white; -fx-font-size: 12px;"/>
                                <Label fx:id="activePoliciesLabel" text="0" style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: bold;"/>
                            </VBox>

                            <VBox fx:id="pendingClaimsCard" style="-fx-background-color: #e74c3c; -fx-background-radius: 8; -fx-padding: 15; -fx-alignment: CENTER;" HBox.hgrow="ALWAYS">
                                <Label text="Pending Claims" style="-fx-text-fill: white; -fx-font-size: 12px;"/>
                                <Label fx:id="pendingClaimsLabel" text="0" style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: bold;"/>
                            </VBox>

                            <VBox fx:id="expiredPoliciesCard" style="-fx-background-color: #e67e22; -fx-background-radius: 8; -fx-padding: 15; -fx-alignment: CENTER;" HBox.hgrow="ALWAYS">
                                <Label text="Expired Policies" style="-fx-text-fill: white; -fx-font-size: 12px;"/>
                                <Label fx:id="expiredPoliciesLabel" text="0" style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: bold;"/>
                            </VBox>

                            <VBox fx:id="totalPremiumCard" style="-fx-background-color: #2ecc71; -fx-background-radius: 8; -fx-padding: 15; -fx-alignment: CENTER;" HBox.hgrow="ALWAYS">
                                <Label text="Total Premium" style="-fx-text-fill: white; -fx-font-size: 12px;"/>
                                <Label fx:id="totalPremiumLabel" text="M0.00" style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: bold;"/>
                            </VBox>

                            <VBox fx:id="expiringSoonCard" style="-fx-background-color: #f39c12; -fx-background-radius: 8; -fx-padding: 15; -fx-alignment: CENTER;" HBox.hgrow="ALWAYS">
                                <Label text="Expiring Soon" style="-fx-text-fill: white; -fx-font-size: 12px;"/>
                                <Label fx:id="expiringSoonLabel" text="0" style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: bold;"/>
                            </VBox>

                            <VBox fx:id="unreadNotificationsCard" style="-fx-background-color: #9b59b6; -fx-background-radius: 8; -fx-padding: 15; -fx-alignment: CENTER;" HBox.hgrow="ALWAYS">
                                <Label text="Notifications" style="-fx-text-fill: white; -fx-font-size: 12px;"/>
                                <Label fx:id="unreadNotificationsLabel" text="0" style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: bold;"/>
                            </VBox>
                        </HBox>
                    </pageFactory>
                </Pagination>

                <Separator/>

                <!-- Progress Bar -->
                <ProgressBar fx:id="operationProgress" prefWidth="Infinity" progress="0" visible="false"/>

                <!-- Recent Policies Table with Pagination -->
                <TitledPane text="Recent Policies" expanded="true" style="-fx-font-weight: bold;">
                    <VBox spacing="10" style="-fx-padding: 10;">
                        <TableView fx:id="policiesTable" prefHeight="250">
                            <columns>
                                <TableColumn fx:id="policyNumberColumn" text="Policy Number" prefWidth="150"/>
                                <TableColumn fx:id="vehicleRegColumn" text="Vehicle Registration" prefWidth="130"/>
                                <TableColumn fx:id="providerNameColumn" text="Provider" prefWidth="150"/>
                                <TableColumn fx:id="startDateColumn" text="Start Date" prefWidth="100"/>
                                <TableColumn fx:id="endDateColumn" text="End Date" prefWidth="100"/>
                                <TableColumn fx:id="policyStatusColumn" text="Status" prefWidth="80"/>
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                            <placeholder>
                                <Label text="No policies found" style="-fx-text-fill: #7f8c8d;"/>
                            </placeholder>
                        </TableView>
                        <Pagination fx:id="policiesPagination" pageCount="1" maxPageIndicatorCount="5"/>
                    </VBox>
                </TitledPane>

                <!-- Recent Claims Table with Pagination -->
                <TitledPane text="Recent Claims" expanded="true" style="-fx-font-weight: bold;">
                    <VBox spacing="10" style="-fx-padding: 10;">
                        <TableView fx:id="claimsTable" prefHeight="200">
                            <columns>
                                <TableColumn fx:id="claimIdColumn" text="Claim ID" prefWidth="80"/>
                                <TableColumn fx:id="claimPolicyNumberColumn" text="Policy Number" prefWidth="130"/>
                                <TableColumn fx:id="claimDateColumn" text="Claim Date" prefWidth="100"/>
                                <TableColumn fx:id="claimAmountColumn" text="Amount (M)" prefWidth="100"/>
                                <TableColumn fx:id="claimStatusColumn" text="Status" prefWidth="100"/>
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                            <placeholder>
                                <Label text="No claims found" style="-fx-text-fill: #7f8c8d;"/>
                            </placeholder>
                        </TableView>
                        <Pagination fx:id="claimsPagination" pageCount="1" maxPageIndicatorCount="5"/>
                    </VBox>
                </TitledPane>

                <!-- Status Label -->
                <Label fx:id="statusLabel" style="-fx-text-fill: #7f8c8d; -fx-font-style: italic;"/>

            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <fx:include source="FooterComponent.fxml"/>
    </bottom>

</BorderPane>