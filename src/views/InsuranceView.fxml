<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.InsuranceController"
            stylesheets="@../css/application.css" styleClass="border-pane">

    <top>
        <fx:include source="MenuBarComponent.fxml"/>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="false" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
            <VBox spacing="20" alignment="TOP_CENTER" styleClass="dashboard-container">
                <padding>
                    <Insets top="25" right="40" bottom="30" left="40"/>
                </padding>

                <Label fx:id="welcomeLabel" styleClass="label-title" alignment="CENTER" maxWidth="Infinity"/>
                <Label text="Insurance Provider Dashboard" styleClass="label-subtitle" alignment="CENTER" maxWidth="Infinity"/>

                <Separator/>

                <ProgressIndicator fx:id="loadProgress" visible="false" maxWidth="40"/>

                <!-- Statistics Cards Row - Using FlowPane for wrapping -->
                <FlowPane hgap="15" vgap="15" alignment="CENTER">
                    <VBox fx:id="activePoliciesCard" styleClass="dashboard-card" alignment="CENTER" minWidth="160" prefWidth="180">
                        <Label text="Active Policies" styleClass="card-title"/>
                        <Label fx:id="activePoliciesLabel" text="0" styleClass="card-value"/>
                    </VBox>

                    <VBox fx:id="pendingClaimsCard" styleClass="dashboard-card" alignment="CENTER" minWidth="160" prefWidth="180">
                        <Label text="Pending Claims" styleClass="card-title"/>
                        <Label fx:id="pendingClaimsLabel" text="0" styleClass="card-value"/>
                    </VBox>

                    <VBox fx:id="expiredPoliciesCard" styleClass="dashboard-card" alignment="CENTER" minWidth="160" prefWidth="180">
                        <Label text="Expired Policies" styleClass="card-title"/>
                        <Label fx:id="expiredPoliciesLabel" text="0" styleClass="card-value"/>
                    </VBox>

                    <VBox fx:id="totalPremiumCard" styleClass="dashboard-card" alignment="CENTER" minWidth="160" prefWidth="180">
                        <Label text="Total Premium" styleClass="card-title"/>
                        <Label fx:id="totalPremiumLabel" text="M0.00" styleClass="card-value"/>
                    </VBox>

                    <VBox fx:id="expiringSoonCard" styleClass="dashboard-card" alignment="CENTER" minWidth="160" prefWidth="180">
                        <Label text="Expiring Soon" styleClass="card-title"/>
                        <Label fx:id="expiringSoonLabel" text="0" styleClass="card-value"/>
                    </VBox>

                    <VBox fx:id="unreadNotificationsCard" styleClass="dashboard-card" alignment="CENTER" minWidth="160" prefWidth="180">
                        <Label text="Notifications" styleClass="card-title"/>
                        <Label fx:id="unreadNotificationsLabel" text="0" styleClass="card-value"/>
                    </VBox>
                </FlowPane>

                <Separator/>

                <ProgressBar fx:id="operationProgress" prefWidth="Infinity" progress="0" visible="false"/>

                <!-- Recent Policies Table -->
                <TitledPane text="Recent Policies" expanded="true">
                    <VBox spacing="10" style="-fx-padding: 10;">
                        <TableView fx:id="policiesTable" prefHeight="250" maxWidth="Infinity">
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                            <columns>
                                <TableColumn fx:id="policyNumberColumn" text="Policy Number" prefWidth="140"/>
                                <TableColumn fx:id="vehicleRegColumn" text="Vehicle Registration" prefWidth="130"/>
                                <TableColumn fx:id="providerNameColumn" text="Provider" prefWidth="140"/>
                                <TableColumn fx:id="startDateColumn" text="Start Date" prefWidth="100"/>
                                <TableColumn fx:id="endDateColumn" text="End Date" prefWidth="100"/>
                                <TableColumn fx:id="policyStatusColumn" text="Status" prefWidth="90"/>
                            </columns>
                            <placeholder>
                                <Label text="No policies found" styleClass="status-text"/>
                            </placeholder>
                        </TableView>
                        <HBox alignment="CENTER">
                            <Pagination fx:id="policiesPagination" pageCount="1" maxPageIndicatorCount="5"/>
                        </HBox>
                    </VBox>
                </TitledPane>

                <!-- Recent Claims Table -->
                <TitledPane text="Recent Claims" expanded="true">
                    <VBox spacing="10" style="-fx-padding: 10;">
                        <TableView fx:id="claimsTable" prefHeight="200" maxWidth="Infinity">
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                            <columns>
                                <TableColumn fx:id="claimIdColumn" text="Claim ID" prefWidth="80"/>
                                <TableColumn fx:id="claimPolicyNumberColumn" text="Policy Number" prefWidth="130"/>
                                <TableColumn fx:id="claimDateColumn" text="Claim Date" prefWidth="100"/>
                                <TableColumn fx:id="claimAmountColumn" text="Amount (M)" prefWidth="100"/>
                                <TableColumn fx:id="claimStatusColumn" text="Status" prefWidth="100"/>
                            </columns>
                            <placeholder>
                                <Label text="No claims found" styleClass="status-text"/>
                            </placeholder>
                        </TableView>
                        <HBox alignment="CENTER">
                            <Pagination fx:id="claimsPagination" pageCount="1" maxPageIndicatorCount="5"/>
                        </HBox>
                    </VBox>
                </TitledPane>

                <Label fx:id="statusLabel" styleClass="status-text" alignment="CENTER" maxWidth="Infinity"/>

            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <fx:include source="FooterComponent.fxml"/>
    </bottom>
</BorderPane>