<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.PoliceProfileController">

    <top>
        <VBox>
            <fx:include source="MenuBarComponent.fxml"/>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true">
            <VBox spacing="20" style="-fx-padding: 20;">

                <Label text="Police Officer Profile" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <Label text="View and manage your personal and professional information" style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;"/>

                <Separator/>

                <ProgressIndicator fx:id="loadProgress" visible="false" maxWidth="40"/>

                <HBox spacing="30">

                    <VBox spacing="15" style="-fx-background-color: #f8f9fa; -fx-background-radius: 10; -fx-padding: 20;" HBox.hgrow="NEVER" prefWidth="300">
                        <ImageView fx:id="profileImageView" fitHeight="150" fitWidth="150" style="-fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 10, 0, 0, 5);"/>
                        <Button fx:id="uploadPhotoButton" text="Upload Photo" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>

                        <Separator/>

                        <Label text="Badge Information" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

                        <GridPane hgap="10" vgap="8">
                            <Label text="Badge Number:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <Label fx:id="badgeNumberLabel" GridPane.rowIndex="0" GridPane.columnIndex="1" style="-fx-text-fill: #2c3e50;"/>

                            <Label text="Rank:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <Label fx:id="rankDisplayLabel" GridPane.rowIndex="1" GridPane.columnIndex="1" style="-fx-text-fill: #2c3e50;"/>

                            <Label text="Department:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <Label fx:id="departmentDisplayLabel" GridPane.rowIndex="2" GridPane.columnIndex="1" style="-fx-text-fill: #2c3e50;"/>

                            <Label text="Station:" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <Label fx:id="stationDisplayLabel" GridPane.rowIndex="3" GridPane.columnIndex="1" style="-fx-text-fill: #2c3e50;"/>

                            <Label text="Hire Date:" GridPane.rowIndex="4" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <Label fx:id="hireDateLabel" GridPane.rowIndex="4" GridPane.columnIndex="1" style="-fx-text-fill: #2c3e50;"/>
                        </GridPane>
                    </VBox>

                    <VBox spacing="15" style="-fx-background-color: #ffffff; -fx-background-radius: 10; -fx-padding: 20; -fx-border-color: #e0e0e0; -fx-border-radius: 10;" HBox.hgrow="ALWAYS">

                        <Label text="Personal Information" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

                        <GridPane hgap="15" vgap="12">
                            <Label text="Full Name:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <TextField fx:id="fullNameField" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="300"/>

                            <Label text="Email:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <TextField fx:id="emailField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                            <Label text="Phone:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <TextField fx:id="phoneField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                            <Label text="Address:" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <TextArea fx:id="addressField" GridPane.rowIndex="3" GridPane.columnIndex="1" prefHeight="60" wrapText="true"/>
                        </GridPane>

                        <Separator/>

                        <Label text="Professional Information" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

                        <GridPane hgap="15" vgap="12">
                            <Label text="Rank:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <HBox spacing="10" GridPane.rowIndex="0" GridPane.columnIndex="1">
                                <ComboBox fx:id="rankComboBox" prefWidth="200" promptText="Select Rank"/>
                                <Button fx:id="requestRankChangeButton" text="Request Promotion" style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
                            </HBox>

                            <Label text="Department:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <ComboBox fx:id="departmentComboBox" GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="250"/>

                            <Label text="Station Assigned:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <TextField fx:id="stationField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                            <Label text="Supervisor:" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <TextField fx:id="supervisorField" GridPane.rowIndex="3" GridPane.columnIndex="1" editable="false" style="-fx-background-color: #f0f0f0;"/>
                        </GridPane>

                        <Separator/>

                        <Label text="Account Security" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

                        <GridPane hgap="15" vgap="12">
                            <Label text="Username:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <Label fx:id="usernameLabel" GridPane.rowIndex="0" GridPane.columnIndex="1" style="-fx-text-fill: #7f8c8d;"/>

                            <Label text="Last Login:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <Label fx:id="lastLoginLabel" GridPane.rowIndex="1" GridPane.columnIndex="1" style="-fx-text-fill: #7f8c8d;"/>

                            <Label text="Account Status:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <Label fx:id="accountStatusLabel" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                            <Button fx:id="changePasswordButton" text="Change Password" GridPane.rowIndex="3" GridPane.columnIndex="0" GridPane.columnSpan="2" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-pref-width: 150;"/>
                        </GridPane>

                        <ProgressBar fx:id="operationProgress" prefWidth="Infinity" progress="0" visible="false"/>

                        <HBox spacing="15" alignment="CENTER_RIGHT">
                            <Button fx:id="saveButton" text="Save Changes" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-pref-width: 120;">
                                <effect>
                                    <DropShadow radius="3" color="rgba(0,0,0,0.2)"/>
                                </effect>
                            </Button>
                            <Button fx:id="cancelButton" text="Cancel" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-pref-width: 100;"/>
                            <Button fx:id="backButton" text="Back to Dashboard" style="-fx-background-color: #7f8c8d; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-pref-width: 150;"/>
                        </HBox>
                    </VBox>
                </HBox>

                <TitledPane text="Recent Activity Log" expanded="true" style="-fx-font-weight: bold;">
                    <VBox spacing="10" style="-fx-padding: 10;">
                        <TableView fx:id="activityTable" prefHeight="250">
                            <columns>
                                <TableColumn fx:id="activityTimeColumn" text="Time" prefWidth="180"/>
                                <TableColumn fx:id="activityActionColumn" text="Action" prefWidth="250"/>
                                <TableColumn fx:id="activityDescriptionColumn" text="Description" prefWidth="300"/>
                                <TableColumn fx:id="activityTargetColumn" text="Target" prefWidth="150"/>
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                            <placeholder>
                                <Label text="No recent activity" style="-fx-text-fill: #7f8c8d;"/>
                            </placeholder>
                        </TableView>
                        <Pagination fx:id="activityPagination" pageCount="1" maxPageIndicatorCount="5"/>
                        <Button fx:id="refreshActivityButton" text="Refresh" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-pref-width: 100;"/>
                    </VBox>
                </TitledPane>

                <Label fx:id="statusLabel" style="-fx-text-fill: #7f8c8d; -fx-font-style: italic;"/>

            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <fx:include source="FooterComponent.fxml"/>
    </bottom>
</BorderPane>