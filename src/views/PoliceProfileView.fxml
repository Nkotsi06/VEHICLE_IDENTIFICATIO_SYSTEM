<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.PoliceProfileController"
            stylesheets="@../css/application.css" styleClass="border-pane">

    <top>
        <fx:include source="MenuBarComponent.fxml"/>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="false" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    style="-fx-background-color: #f0f2f5; -fx-background: #f0f2f5;">
            <VBox spacing="20" alignment="TOP_CENTER"
                  style="-fx-background-color: #f0f2f5; -fx-padding: 25 40 30 40;">

                <!-- Title Section -->
                <Label text="Police Officer Profile" styleClass="label-title" alignment="CENTER" maxWidth="Infinity"/>
                <Label text="View and manage your personal and professional information" styleClass="label-subtitle" alignment="CENTER" maxWidth="Infinity"/>

                <Separator/>

                <!-- Progress Indicator -->
                <ProgressIndicator fx:id="loadProgress" visible="false" maxWidth="40"/>

                <!-- Main Profile Layout -->
                <HBox spacing="30" alignment="CENTER">

                    <!-- LEFT PANEL - Profile Photo Card -->
                    <VBox spacing="20" styleClass="profile-card" alignment="CENTER" HBox.hgrow="NEVER" prefWidth="320">
                        <ImageView fx:id="profileImageView" fitHeight="160" fitWidth="160" styleClass="profile-image-circle"/>
                        <Button fx:id="uploadPhotoButton" text="Upload Photo" styleClass="button-info" maxWidth="160" prefWidth="140"/>

                        <Separator/>

                        <Label text="BADGE INFORMATION" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>

                        <GridPane hgap="15" vgap="12" alignment="CENTER">
                            <Label text="Badge Number:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold; -fx-text-fill: #006400;"/>
                            <Label fx:id="badgeNumberLabel" GridPane.rowIndex="0" GridPane.columnIndex="1"
                                   style="-fx-text-fill: #2c3e50; -fx-font-family: monospace; -fx-font-size: 14px; -fx-font-weight: bold;"/>

                            <Label text="Rank:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <Label fx:id="rankDisplayLabel" GridPane.rowIndex="1" GridPane.columnIndex="1"
                                   style="-fx-text-fill: #2c3e50; -fx-font-weight: bold;"/>

                            <Label text="Department:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <Label fx:id="departmentDisplayLabel" GridPane.rowIndex="2" GridPane.columnIndex="1"
                                   style="-fx-text-fill: #2c3e50;"/>

                            <Label text="Station:" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <Label fx:id="stationDisplayLabel" GridPane.rowIndex="3" GridPane.columnIndex="1"
                                   style="-fx-text-fill: #2c3e50;"/>

                            <Label text="Hire Date:" GridPane.rowIndex="4" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <Label fx:id="hireDateLabel" GridPane.rowIndex="4" GridPane.columnIndex="1"
                                   style="-fx-text-fill: #2c3e50;"/>
                        </GridPane>
                    </VBox>

                    <!-- RIGHT PANEL - Editable Information -->
                    <VBox spacing="20" HBox.hgrow="ALWAYS" maxWidth="700">
                        <VBox spacing="15" styleClass="profile-edit-card">
                            <Label text="PERSONAL INFORMATION" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>

                            <GridPane hgap="15" vgap="14" alignment="CENTER">
                                <Label text="Full Name:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <TextField fx:id="fullNameField" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="300" promptText="Enter full name"/>

                                <Label text="Email:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <TextField fx:id="emailField" GridPane.rowIndex="1" GridPane.columnIndex="1" promptText="Enter email address"/>

                                <Label text="Phone:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <TextField fx:id="phoneField" GridPane.rowIndex="2" GridPane.columnIndex="1" promptText="Enter phone number"/>

                                <Label text="Address:" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <TextArea fx:id="addressField" GridPane.rowIndex="3" GridPane.columnIndex="1" prefHeight="70" wrapText="true" promptText="Enter your address"/>
                            </GridPane>
                        </VBox>

                        <VBox spacing="15" styleClass="profile-edit-card">
                            <Label text="PROFESSIONAL INFORMATION" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>

                            <GridPane hgap="15" vgap="14" alignment="CENTER">
                                <Label text="Rank:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <HBox spacing="10" GridPane.rowIndex="0" GridPane.columnIndex="1" alignment="CENTER_LEFT">
                                    <ComboBox fx:id="rankComboBox" prefWidth="200" promptText="Select Rank"/>
                                    <Button fx:id="requestRankChangeButton" text="Request Promotion" styleClass="button-warning" prefWidth="140"/>
                                </HBox>

                                <Label text="Department:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <ComboBox fx:id="departmentComboBox" GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="250" promptText="Select department"/>

                                <Label text="Station Assigned:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <TextField fx:id="stationField" GridPane.rowIndex="2" GridPane.columnIndex="1" promptText="Enter station name"/>

                                <Label text="Supervisor:" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <TextField fx:id="supervisorField" GridPane.rowIndex="3" GridPane.columnIndex="1" editable="false"/>
                            </GridPane>
                        </VBox>

                        <VBox spacing="15" styleClass="profile-edit-card">
                            <Label text="ACCOUNT SECURITY" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>

                            <GridPane hgap="15" vgap="14" alignment="CENTER">
                                <Label text="Username:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <Label fx:id="usernameLabel" GridPane.rowIndex="0" GridPane.columnIndex="1" style="-fx-text-fill: #7f8c8d; -fx-font-family: monospace;"/>

                                <Label text="Last Login:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <Label fx:id="lastLoginLabel" GridPane.rowIndex="1" GridPane.columnIndex="1" style="-fx-text-fill: #7f8c8d;"/>

                                <Label text="Account Status:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <Label fx:id="accountStatusLabel" GridPane.rowIndex="2" GridPane.columnIndex="1" style="-fx-text-fill: #27ae60; -fx-font-weight: bold;"/>

                                <Label text="Password:" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <HBox spacing="15" GridPane.rowIndex="3" GridPane.columnIndex="1" alignment="CENTER_LEFT">
                                    <Button fx:id="changePasswordButton" text="Change Password" styleClass="button-warning" prefWidth="160"/>
                                    <Label text="Click to update your password" style="-fx-text-fill: #7f8c8d; -fx-font-style: italic; -fx-font-size: 11px;"/>
                                </HBox>
                            </GridPane>
                        </VBox>

                        <HBox spacing="15" alignment="CENTER_RIGHT">
                            <Button fx:id="saveButton" text="Save Changes" styleClass="button-success" prefWidth="130"/>
                            <Button fx:id="cancelButton" text="Cancel" styleClass="button-secondary" prefWidth="100"/>
                            <Button fx:id="backButton" text="Back to Dashboard" styleClass="button-primary" prefWidth="160"/>
                        </HBox>

                        <ProgressBar fx:id="operationProgress" prefWidth="Infinity" progress="0" visible="false"/>

                        <Label fx:id="statusLabel" styleClass="status-text" alignment="CENTER" maxWidth="Infinity"/>
                    </VBox>
                </HBox>

                <!-- Recent Activity Log Section -->
                <TitledPane text="Recent Activity Log" expanded="true" style="-fx-font-weight: bold;" animated="true">
                    <VBox spacing="12" alignment="CENTER">
                        <TableView fx:id="activityTable" prefHeight="280" minHeight="200" maxWidth="Infinity" columnResizePolicy="CONSTRAINED_RESIZE_POLICY">
                            <columns>
                                <TableColumn fx:id="activityTimeColumn" text="Date &amp; Time" minWidth="150" maxWidth="190"/>
                                <TableColumn fx:id="activityActionColumn" text="Action Type" minWidth="150" maxWidth="220"/>
                                <TableColumn fx:id="activityDescriptionColumn" text="Description" minWidth="250"/>
                                <TableColumn fx:id="activityTargetColumn" text="Target" minWidth="120" maxWidth="160"/>
                            </columns>
                            <placeholder>
                                <Label text="No recent activity found" styleClass="status-text"/>
                            </placeholder>
                        </TableView>
                        <HBox alignment="CENTER">
                            <Pagination fx:id="activityPagination" pageCount="1" maxPageIndicatorCount="5"/>
                            <Button fx:id="refreshActivityButton" text="Refresh" styleClass="button-info" prefWidth="100"/>
                        </HBox>
                    </VBox>
                </TitledPane>

            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <fx:include source="FooterComponent.fxml"/>
    </bottom>
</BorderPane>