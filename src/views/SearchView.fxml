<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.SearchController">

    <top>
        <VBox>
            <fx:include source="MenuBarComponent.fxml"/>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true">
            <VBox spacing="20" style="-fx-padding: 20;">

                <Label text="Global Search" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <Label text="Search across all system records" style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;"/>

                <Separator/>

                <ProgressIndicator fx:id="loadProgress" visible="false" maxWidth="40"/>

                <TitledPane text="Search Parameters" expanded="true" style="-fx-font-weight: bold;">
                    <HBox spacing="10" alignment="CENTER" style="-fx-padding: 10;">
                        <TextField fx:id="searchField" promptText="Enter search keyword..." HBox.hgrow="ALWAYS"/>
                        <ComboBox fx:id="searchTypeComboBox" prefWidth="150"/>
                        <Button fx:id="searchButton" text="Search" style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;">
                            <effect>
                                <DropShadow radius="3" color="rgba(0,0,0,0.2)"/>
                            </effect>
                        </Button>
                        <Button fx:id="clearButton" text="Clear" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
                        <Button fx:id="fadeButton" text="Animate" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;">
                            <effect>
                                <DropShadow radius="3" color="rgba(0,0,0,0.2)"/>
                            </effect>
                        </Button>
                    </HBox>
                </TitledPane>

                <ProgressBar fx:id="operationProgress" prefWidth="Infinity" progress="0" visible="false"/>

                <TabPane fx:id="resultsTabPane">
                    <Tab text="Vehicles" closable="false">
                        <VBox spacing="10" style="-fx-padding: 10;">
                            <TableView fx:id="vehiclesTable" prefHeight="350">
                                <columns>
                                    <TableColumn fx:id="searchRegColumn" text="Registration" prefWidth="120"/>
                                    <TableColumn fx:id="searchMakeColumn" text="Make" prefWidth="100"/>
                                    <TableColumn fx:id="searchModelColumn" text="Model" prefWidth="100"/>
                                    <TableColumn fx:id="searchYearColumn" text="Year" prefWidth="80"/>
                                    <TableColumn fx:id="searchStatusColumn" text="Status" prefWidth="100"/>
                                </columns>
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                </columnResizePolicy>
                                <placeholder>
                                    <Label text="No vehicles found" style="-fx-text-fill: #7f8c8d;"/>
                                </placeholder>
                            </TableView>
                            <Pagination fx:id="vehiclesPagination" pageCount="1" maxPageIndicatorCount="5"/>
                        </VBox>
                    </Tab>
                    <Tab text="Customers" closable="false">
                        <VBox spacing="10" style="-fx-padding: 10;">
                            <TableView fx:id="customersTable" prefHeight="350">
                                <columns>
                                    <TableColumn fx:id="searchNameColumn" text="Name" prefWidth="150"/>
                                    <TableColumn fx:id="searchEmailColumn" text="Email" prefWidth="200"/>
                                    <TableColumn fx:id="searchPhoneColumn" text="Phone" prefWidth="120"/>
                                </columns>
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                </columnResizePolicy>
                                <placeholder>
                                    <Label text="No customers found" style="-fx-text-fill: #7f8c8d;"/>
                                </placeholder>
                            </TableView>
                            <Pagination fx:id="customersPagination" pageCount="1" maxPageIndicatorCount="5"/>
                        </VBox>
                    </Tab>
                    <Tab text="Violations" closable="false">
                        <VBox spacing="10" style="-fx-padding: 10;">
                            <TableView fx:id="violationsTable" prefHeight="350">
                                <columns>
                                    <TableColumn fx:id="searchViolationRegColumn" text="Vehicle" prefWidth="120"/>
                                    <TableColumn fx:id="searchViolationTypeColumn" text="Type" prefWidth="150"/>
                                    <TableColumn fx:id="searchFineColumn" text="Fine" prefWidth="100"/>
                                    <TableColumn fx:id="searchPaymentColumn" text="Payment" prefWidth="100"/>
                                </columns>
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                </columnResizePolicy>
                                <placeholder>
                                    <Label text="No violations found" style="-fx-text-fill: #7f8c8d;"/>
                                </placeholder>
                            </TableView>
                            <Pagination fx:id="violationsPagination" pageCount="1" maxPageIndicatorCount="5"/>
                        </VBox>
                    </Tab>
                    <Tab text="Stolen Vehicles" closable="false">
                        <VBox spacing="10" style="-fx-padding: 10;">
                            <TableView fx:id="stolenTable" prefHeight="350">
                                <columns>
                                    <TableColumn fx:id="searchStolenRegColumn" text="Registration" prefWidth="120"/>
                                    <TableColumn fx:id="searchCaseNumberColumn" text="Case Number" prefWidth="150"/>
                                    <TableColumn fx:id="searchStolenStatusColumn" text="Status" prefWidth="100"/>
                                </columns>
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                </columnResizePolicy>
                                <placeholder>
                                    <Label text="No stolen vehicles found" style="-fx-text-fill: #7f8c8d;"/>
                                </placeholder>
                            </TableView>
                            <Pagination fx:id="stolenPagination" pageCount="1" maxPageIndicatorCount="5"/>
                        </VBox>
                    </Tab>
                    <Tab text="Workshops" closable="false">
                        <VBox spacing="10" style="-fx-padding: 10;">
                            <TableView fx:id="workshopsTable" prefHeight="350">
                                <columns>
                                    <TableColumn fx:id="searchWorkshopNameColumn" text="Name" prefWidth="180"/>
                                    <TableColumn fx:id="searchWorkshopPhoneColumn" text="Phone" prefWidth="120"/>
                                    <TableColumn fx:id="searchWorkshopStatusColumn" text="Status" prefWidth="100"/>
                                </columns>
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                </columnResizePolicy>
                                <placeholder>
                                    <Label text="No workshops found" style="-fx-text-fill: #7f8c8d;"/>
                                </placeholder>
                            </TableView>
                            <Pagination fx:id="workshopsPagination" pageCount="1" maxPageIndicatorCount="5"/>
                        </VBox>
                    </Tab>
                    <Tab text="Insurance" closable="false">
                        <VBox spacing="10" style="-fx-padding: 10;">
                            <TableView fx:id="insuranceTable" prefHeight="350">
                                <columns>
                                    <TableColumn fx:id="searchPolicyColumn" text="Policy #" prefWidth="150"/>
                                    <TableColumn fx:id="searchProviderColumn" text="Provider" prefWidth="150"/>
                                    <TableColumn fx:id="searchInsuranceStatusColumn" text="Status" prefWidth="100"/>
                                </columns>
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                </columnResizePolicy>
                                <placeholder>
                                    <Label text="No insurance policies found" style="-fx-text-fill: #7f8c8d;"/>
                                </placeholder>
                            </TableView>
                            <Pagination fx:id="insurancePagination" pageCount="1" maxPageIndicatorCount="5"/>
                        </VBox>
                    </Tab>
                </TabPane>

                <Label fx:id="statusLabel" style="-fx-text-fill: #7f8c8d; -fx-font-style: italic;"/>
            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <HBox spacing="10" style="-fx-padding: 10;" alignment="CENTER_RIGHT">
            <Button fx:id="backButton" text="Back to Dashboard" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-pref-width: 150;"/>
        </HBox>
        <fx:include source="FooterComponent.fxml"/>
    </bottom>
</BorderPane>