<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.SearchController"
            stylesheets="@../css/application.css" styleClass="border-pane">

    <top>
        <VBox>
            <fx:include source="MenuBarComponent.fxml"/>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
            <VBox spacing="20" styleClass="dashboard-container" alignment="TOP_CENTER" maxWidth="1400">

                <Label text="Global Search" styleClass="label-title"/>
                <Label text="Search across all system records including activities, logs, and notifications" styleClass="label-subtitle"/>

                <Separator/>

                <ProgressIndicator fx:id="loadProgress" visible="false" maxWidth="40"/>

                <TitledPane text="Search Parameters" expanded="true" style="-fx-font-weight: bold;">
                    <HBox spacing="10" alignment="CENTER" style="-fx-padding: 10;">
                        <TextField fx:id="searchField" promptText="Enter search keyword..." HBox.hgrow="ALWAYS"/>
                        <ComboBox fx:id="searchTypeComboBox" prefWidth="200"/>
                        <Button fx:id="searchButton" text="Search" styleClass="button-primary"/>
                        <Button fx:id="clearButton" text="Clear" styleClass="button-secondary"/>
                        <Button fx:id="fadeButton" text="Animate" styleClass="button-warning"/>
                    </HBox>
                </TitledPane>

                <ProgressBar fx:id="operationProgress" prefWidth="Infinity" progress="0" visible="false"/>

                <!-- Centered TabPane with All System Activities -->
                <TabPane fx:id="resultsTabPane" styleClass="centered-tab-pane" VBox.vgrow="ALWAYS" maxHeight="Infinity">

                    <!-- VEHICLES TAB -->
                    <Tab text="Vehicles" closable="false">
                        <VBox spacing="10">
                            <TableView fx:id="vehiclesTable" VBox.vgrow="ALWAYS" prefHeight="400" minHeight="200">
                                <columns>
                                    <TableColumn fx:id="searchRegColumn" text="Registration" prefWidth="180"/>
                                    <TableColumn fx:id="searchMakeColumn" text="Make" prefWidth="150"/>
                                    <TableColumn fx:id="searchModelColumn" text="Model" prefWidth="150"/>
                                    <TableColumn fx:id="searchYearColumn" text="Year" prefWidth="100"/>
                                    <TableColumn fx:id="searchStatusColumn" text="Status" prefWidth="120"/>
                                </columns>
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                </columnResizePolicy>
                                <placeholder>
                                    <Label text="No vehicles found" styleClass="status-text"/>
                                </placeholder>
                            </TableView>
                            <HBox spacing="10" alignment="CENTER_RIGHT">
                                <Label fx:id="vehicleCountLabel" styleClass="status-text"/>
                                <Pagination fx:id="vehiclesPagination" pageCount="1" maxPageIndicatorCount="5"/>
                            </HBox>
                        </VBox>
                    </Tab>

                    <!-- CUSTOMERS TAB -->
                    <Tab text="Customers" closable="false">
                        <VBox spacing="10">
                            <TableView fx:id="customersTable" VBox.vgrow="ALWAYS" prefHeight="400" minHeight="200">
                                <columns>
                                    <TableColumn fx:id="searchNameColumn" text="Name" prefWidth="220"/>
                                    <TableColumn fx:id="searchEmailColumn" text="Email" prefWidth="250"/>
                                    <TableColumn fx:id="searchPhoneColumn" text="Phone" prefWidth="150"/>
                                </columns>
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                </columnResizePolicy>
                                <placeholder>
                                    <Label text="No customers found" styleClass="status-text"/>
                                </placeholder>
                            </TableView>
                            <HBox spacing="10" alignment="CENTER_RIGHT">
                                <Label fx:id="customerCountLabel" styleClass="status-text"/>
                                <Pagination fx:id="customersPagination" pageCount="1" maxPageIndicatorCount="5"/>
                            </HBox>
                        </VBox>
                    </Tab>

                    <!-- VIOLATIONS TAB -->
                    <Tab text="Violations" closable="false">
                        <VBox spacing="10">
                            <TableView fx:id="violationsTable" VBox.vgrow="ALWAYS" prefHeight="400" minHeight="200">
                                <columns>
                                    <TableColumn fx:id="searchViolationRegColumn" text="Vehicle" prefWidth="180"/>
                                    <TableColumn fx:id="searchViolationTypeColumn" text="Type" prefWidth="200"/>
                                    <TableColumn fx:id="searchFineColumn" text="Fine" prefWidth="120"/>
                                    <TableColumn fx:id="searchPaymentColumn" text="Payment" prefWidth="120"/>
                                    <TableColumn fx:id="searchViolationDateColumn" text="Date" prefWidth="150"/>
                                    <TableColumn fx:id="searchOfficerColumn" text="Officer" prefWidth="180"/>
                                </columns>
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                </columnResizePolicy>
                                <placeholder>
                                    <Label text="No violations found" styleClass="status-text"/>
                                </placeholder>
                            </TableView>
                            <HBox spacing="10" alignment="CENTER_RIGHT">
                                <Label fx:id="violationCountLabel" styleClass="status-text"/>
                                <Pagination fx:id="violationsPagination" pageCount="1" maxPageIndicatorCount="5"/>
                            </HBox>
                        </VBox>
                    </Tab>

                    <!-- STOLEN VEHICLES TAB -->
                    <Tab text="Stolen Vehicles" closable="false">
                        <VBox spacing="10">
                            <TableView fx:id="stolenTable" VBox.vgrow="ALWAYS" prefHeight="400" minHeight="200">
                                <columns>
                                    <TableColumn fx:id="searchStolenRegColumn" text="Registration" prefWidth="180"/>
                                    <TableColumn fx:id="searchStolenMakeColumn" text="Make" prefWidth="150"/>
                                    <TableColumn fx:id="searchStolenModelColumn" text="Model" prefWidth="150"/>
                                    <TableColumn fx:id="searchCaseNumberColumn" text="Case Number" prefWidth="200"/>
                                    <TableColumn fx:id="searchStolenStatusColumn" text="Status" prefWidth="120"/>
                                    <TableColumn fx:id="searchReportedDateColumn" text="Reported Date" prefWidth="150"/>
                                </columns>
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                </columnResizePolicy>
                                <placeholder>
                                    <Label text="No stolen vehicles found" styleClass="status-text"/>
                                </placeholder>
                            </TableView>
                            <HBox spacing="10" alignment="CENTER_RIGHT">
                                <Label fx:id="stolenCountLabel" styleClass="status-text"/>
                                <Pagination fx:id="stolenPagination" pageCount="1" maxPageIndicatorCount="5"/>
                            </HBox>
                        </VBox>
                    </Tab>

                    <!-- WORKSHOPS TAB -->
                    <Tab text="Workshops" closable="false">
                        <VBox spacing="10">
                            <TableView fx:id="workshopsTable" VBox.vgrow="ALWAYS" prefHeight="400" minHeight="200">
                                <columns>
                                    <TableColumn fx:id="searchWorkshopNameColumn" text="Workshop Name" prefWidth="250"/>
                                    <TableColumn fx:id="searchWorkshopAddressColumn" text="Address" prefWidth="300"/>
                                    <TableColumn fx:id="searchWorkshopPhoneColumn" text="Phone" prefWidth="150"/>
                                    <TableColumn fx:id="searchWorkshopStatusColumn" text="Status" prefWidth="100"/>
                                </columns>
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                </columnResizePolicy>
                                <placeholder>
                                    <Label text="No workshops found" styleClass="status-text"/>
                                </placeholder>
                            </TableView>
                            <HBox spacing="10" alignment="CENTER_RIGHT">
                                <Label fx:id="workshopCountLabel" styleClass="status-text"/>
                                <Pagination fx:id="workshopsPagination" pageCount="1" maxPageIndicatorCount="5"/>
                            </HBox>
                        </VBox>
                    </Tab>

                    <!-- INSURANCE TAB -->
                    <Tab text="Insurance" closable="false">
                        <VBox spacing="10">
                            <TableView fx:id="insuranceTable" VBox.vgrow="ALWAYS" prefHeight="400" minHeight="200">
                                <columns>
                                    <TableColumn fx:id="searchPolicyColumn" text="Policy Number" prefWidth="200"/>
                                    <TableColumn fx:id="searchProviderColumn" text="Provider" prefWidth="220"/>
                                    <TableColumn fx:id="searchInsuranceStatusColumn" text="Status" prefWidth="120"/>
                                    <TableColumn fx:id="searchStartDateColumn" text="Start Date" prefWidth="120"/>
                                    <TableColumn fx:id="searchEndDateColumn" text="End Date" prefWidth="120"/>
                                </columns>
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                </columnResizePolicy>
                                <placeholder>
                                    <Label text="No insurance policies found" styleClass="status-text"/>
                                </placeholder>
                            </TableView>
                            <HBox spacing="10" alignment="CENTER_RIGHT">
                                <Label fx:id="insuranceCountLabel" styleClass="status-text"/>
                                <Pagination fx:id="insurancePagination" pageCount="1" maxPageIndicatorCount="5"/>
                            </HBox>
                        </VBox>
                    </Tab>

                    <!-- AUDIT LOGS TAB -->
                    <Tab text="Audit Logs" closable="false">
                        <VBox spacing="10">
                            <TableView fx:id="auditLogsTable" VBox.vgrow="ALWAYS" prefHeight="400" minHeight="200">
                                <columns>
                                    <TableColumn fx:id="logUserColumn" text="User" prefWidth="200"/>
                                    <TableColumn fx:id="logActionColumn" text="Action" prefWidth="350"/>
                                    <TableColumn fx:id="logTimestampColumn" text="Timestamp" prefWidth="200"/>
                                    <TableColumn fx:id="logIpColumn" text="IP Address" prefWidth="150"/>
                                </columns>
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                </columnResizePolicy>
                                <placeholder>
                                    <Label text="No audit logs found" styleClass="status-text"/>
                                </placeholder>
                            </TableView>
                            <HBox spacing="10" alignment="CENTER_RIGHT">
                                <Label fx:id="auditLogCountLabel" styleClass="status-text"/>
                                <Pagination fx:id="auditLogsPagination" pageCount="1" maxPageIndicatorCount="5"/>
                            </HBox>
                        </VBox>
                    </Tab>

                    <!-- NOTIFICATIONS TAB -->
                    <Tab text="Notifications" closable="false">
                        <VBox spacing="10">
                            <TableView fx:id="notificationsTable" VBox.vgrow="ALWAYS" prefHeight="400" minHeight="200">
                                <columns>
                                    <TableColumn fx:id="notifMessageColumn" text="Message" prefWidth="350"/>
                                    <TableColumn fx:id="notifTypeColumn" text="Type" prefWidth="150"/>
                                    <TableColumn fx:id="notifCreatedAtColumn" text="Date" prefWidth="180"/>
                                    <TableColumn fx:id="notifStatusColumn" text="Status" prefWidth="100"/>
                                </columns>
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                </columnResizePolicy>
                                <placeholder>
                                    <Label text="No notifications found" styleClass="status-text"/>
                                </placeholder>
                            </TableView>
                            <HBox spacing="10" alignment="CENTER_RIGHT">
                                <Label fx:id="notificationCountLabel" styleClass="status-text"/>
                                <Pagination fx:id="notificationsPagination" pageCount="1" maxPageIndicatorCount="5"/>
                            </HBox>
                        </VBox>
                    </Tab>

                </TabPane>

                <!-- Status Label -->
                <Label fx:id="statusLabel" styleClass="status-text" alignment="CENTER"/>

            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <VBox spacing="0">
            <HBox spacing="10" style="-fx-padding: 10;" alignment="CENTER_RIGHT">
                <Button fx:id="backButton" text="Back to Dashboard" styleClass="button-secondary" prefWidth="150"/>
            </HBox>
            <fx:include source="FooterComponent.fxml"/>
        </VBox>
    </bottom>
</BorderPane>