<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.SearchController"
            stylesheets="@../css/application.css" styleClass="border-pane">

    <top>
        <fx:include source="MenuBarComponent.fxml"/>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="false" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
            <VBox spacing="20" alignment="TOP_CENTER" styleClass="dashboard-container">
                <padding>
                    <Insets top="25" right="40" bottom="30" left="40"/>
                </padding>

                <Label text="Global Search" styleClass="label-title" alignment="CENTER" maxWidth="Infinity"/>
                <Label text="Search across all system records including activities, logs, and notifications" styleClass="label-subtitle" alignment="CENTER" maxWidth="Infinity"/>

                <Separator/>

                <ProgressIndicator fx:id="loadProgress" visible="false" maxWidth="40"/>

                <HBox alignment="CENTER">
                    <VBox maxWidth="1100" minWidth="700" styleClass="profile-edit-card" alignment="CENTER">
                        <Label text="Search Parameters" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>
                        <HBox spacing="15" alignment="CENTER">
                            <TextField fx:id="searchField" promptText="Enter search keyword..." HBox.hgrow="ALWAYS" prefWidth="400"/>
                            <ComboBox fx:id="searchTypeComboBox" prefWidth="200"/>
                            <Button fx:id="searchButton" text="Search" styleClass="button-primary" prefWidth="100"/>
                            <Button fx:id="clearButton" text="Clear" styleClass="button-secondary" prefWidth="100"/>
                            <Button fx:id="fadeButton" text="Animate" styleClass="button-warning" prefWidth="100"/>
                        </HBox>
                    </VBox>
                </HBox>

                <ProgressBar fx:id="operationProgress" prefWidth="Infinity" progress="0" visible="false"/>

                <TabPane fx:id="resultsTabPane" styleClass="centered-tab-pane" maxWidth="Infinity" tabClosingPolicy="UNAVAILABLE">

                    <Tab text="Vehicles" closable="false">
                        <VBox spacing="10" style="-fx-padding: 10;" alignment="CENTER">
                            <TableView fx:id="vehiclesTable" prefHeight="400" maxWidth="Infinity">
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                </columnResizePolicy>
                                <columns>
                                    <TableColumn fx:id="searchRegColumn" text="Registration" prefWidth="160"/>
                                    <TableColumn fx:id="searchMakeColumn" text="Make" prefWidth="130"/>
                                    <TableColumn fx:id="searchModelColumn" text="Model" prefWidth="130"/>
                                    <TableColumn fx:id="searchYearColumn" text="Year" prefWidth="90"/>
                                    <TableColumn fx:id="searchStatusColumn" text="Status" prefWidth="110"/>
                                </columns>
                                <placeholder>
                                    <Label text="No vehicles found" styleClass="status-text"/>
                                </placeholder>
                            </TableView>
                            <HBox spacing="10" alignment="CENTER">
                                <Label fx:id="vehicleCountLabel" styleClass="status-text"/>
                                <Pagination fx:id="vehiclesPagination" pageCount="1" maxPageIndicatorCount="5"/>
                            </HBox>
                        </VBox>
                    </Tab>

                    <Tab text="Customers" closable="false">
                        <VBox spacing="10" style="-fx-padding: 10;" alignment="CENTER">
                            <TableView fx:id="customersTable" prefHeight="400" maxWidth="Infinity">
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                </columnResizePolicy>
                                <columns>
                                    <TableColumn fx:id="searchNameColumn" text="Name" prefWidth="200"/>
                                    <TableColumn fx:id="searchEmailColumn" text="Email" prefWidth="250"/>
                                    <TableColumn fx:id="searchPhoneColumn" text="Phone" prefWidth="140"/>
                                </columns>
                                <placeholder>
                                    <Label text="No customers found" styleClass="status-text"/>
                                </placeholder>
                            </TableView>
                            <HBox spacing="10" alignment="CENTER">
                                <Label fx:id="customerCountLabel" styleClass="status-text"/>
                                <Pagination fx:id="customersPagination" pageCount="1" maxPageIndicatorCount="5"/>
                            </HBox>
                        </VBox>
                    </Tab>

                    <Tab text="Violations" closable="false">
                        <VBox spacing="10" style="-fx-padding: 10;" alignment="CENTER">
                            <TableView fx:id="violationsTable" prefHeight="400" maxWidth="Infinity">
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                </columnResizePolicy>
                                <columns>
                                    <TableColumn fx:id="searchViolationRegColumn" text="Vehicle" prefWidth="160"/>
                                    <TableColumn fx:id="searchViolationTypeColumn" text="Type" prefWidth="180"/>
                                    <TableColumn fx:id="searchFineColumn" text="Fine" prefWidth="110"/>
                                    <TableColumn fx:id="searchPaymentColumn" text="Payment" prefWidth="110"/>
                                    <TableColumn fx:id="searchViolationDateColumn" text="Date" prefWidth="130"/>
                                    <TableColumn fx:id="searchOfficerColumn" text="Officer" prefWidth="160"/>
                                </columns>
                                <placeholder>
                                    <Label text="No violations found" styleClass="status-text"/>
                                </placeholder>
                            </TableView>
                            <HBox spacing="10" alignment="CENTER">
                                <Label fx:id="violationCountLabel" styleClass="status-text"/>
                                <Pagination fx:id="violationsPagination" pageCount="1" maxPageIndicatorCount="5"/>
                            </HBox>
                        </VBox>
                    </Tab>

                    <Tab text="Stolen Vehicles" closable="false">
                        <VBox spacing="10" style="-fx-padding: 10;" alignment="CENTER">
                            <TableView fx:id="stolenTable" prefHeight="400" maxWidth="Infinity">
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                </columnResizePolicy>
                                <columns>
                                    <TableColumn fx:id="searchStolenRegColumn" text="Registration" prefWidth="160"/>
                                    <TableColumn fx:id="searchStolenMakeColumn" text="Make" prefWidth="130"/>
                                    <TableColumn fx:id="searchStolenModelColumn" text="Model" prefWidth="130"/>
                                    <TableColumn fx:id="searchCaseNumberColumn" text="Case Number" prefWidth="200"/>
                                    <TableColumn fx:id="searchStolenStatusColumn" text="Status" prefWidth="110"/>
                                    <TableColumn fx:id="searchReportedDateColumn" text="Reported Date" prefWidth="130"/>
                                </columns>
                                <placeholder>
                                    <Label text="No stolen vehicles found" styleClass="status-text"/>
                                </placeholder>
                            </TableView>
                            <HBox spacing="10" alignment="CENTER">
                                <Label fx:id="stolenCountLabel" styleClass="status-text"/>
                                <Pagination fx:id="stolenPagination" pageCount="1" maxPageIndicatorCount="5"/>
                            </HBox>
                        </VBox>
                    </Tab>

                    <Tab text="Workshops" closable="false">
                        <VBox spacing="10" style="-fx-padding: 10;" alignment="CENTER">
                            <TableView fx:id="workshopsTable" prefHeight="400" maxWidth="Infinity">
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                </columnResizePolicy>
                                <columns>
                                    <TableColumn fx:id="searchWorkshopNameColumn" text="Workshop Name" prefWidth="250"/>
                                    <TableColumn fx:id="searchWorkshopAddressColumn" text="Address" prefWidth="300"/>
                                    <TableColumn fx:id="searchWorkshopPhoneColumn" text="Phone" prefWidth="140"/>
                                    <TableColumn fx:id="searchWorkshopStatusColumn" text="Status" prefWidth="100"/>
                                </columns>
                                <placeholder>
                                    <Label text="No workshops found" styleClass="status-text"/>
                                </placeholder>
                            </TableView>
                            <HBox spacing="10" alignment="CENTER">
                                <Label fx:id="workshopCountLabel" styleClass="status-text"/>
                                <Pagination fx:id="workshopsPagination" pageCount="1" maxPageIndicatorCount="5"/>
                            </HBox>
                        </VBox>
                    </Tab>

                    <Tab text="Insurance" closable="false">
                        <VBox spacing="10" style="-fx-padding: 10;" alignment="CENTER">
                            <TableView fx:id="insuranceTable" prefHeight="400" maxWidth="Infinity">
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                </columnResizePolicy>
                                <columns>
                                    <TableColumn fx:id="searchPolicyColumn" text="Policy Number" prefWidth="180"/>
                                    <TableColumn fx:id="searchProviderColumn" text="Provider" prefWidth="200"/>
                                    <TableColumn fx:id="searchInsuranceStatusColumn" text="Status" prefWidth="110"/>
                                    <TableColumn fx:id="searchStartDateColumn" text="Start Date" prefWidth="110"/>
                                    <TableColumn fx:id="searchEndDateColumn" text="End Date" prefWidth="110"/>
                                </columns>
                                <placeholder>
                                    <Label text="No insurance policies found" styleClass="status-text"/>
                                </placeholder>
                            </TableView>
                            <HBox spacing="10" alignment="CENTER">
                                <Label fx:id="insuranceCountLabel" styleClass="status-text"/>
                                <Pagination fx:id="insurancePagination" pageCount="1" maxPageIndicatorCount="5"/>
                            </HBox>
                        </VBox>
                    </Tab>

                    <Tab text="Audit Logs" closable="false">
                        <VBox spacing="10" style="-fx-padding: 10;" alignment="CENTER">
                            <TableView fx:id="auditLogsTable" prefHeight="400" maxWidth="Infinity">
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                </columnResizePolicy>
                                <columns>
                                    <TableColumn fx:id="logUserColumn" text="User" prefWidth="180"/>
                                    <TableColumn fx:id="logActionColumn" text="Action" prefWidth="280"/>
                                    <TableColumn fx:id="logTimestampColumn" text="Timestamp" prefWidth="180"/>
                                    <TableColumn fx:id="logIpColumn" text="IP Address" prefWidth="140"/>
                                </columns>
                                <placeholder>
                                    <Label text="No audit logs found" styleClass="status-text"/>
                                </placeholder>
                            </TableView>
                            <HBox spacing="10" alignment="CENTER">
                                <Label fx:id="auditLogCountLabel" styleClass="status-text"/>
                                <Pagination fx:id="auditLogsPagination" pageCount="1" maxPageIndicatorCount="5"/>
                            </HBox>
                        </VBox>
                    </Tab>

                    <Tab text="Notifications" closable="false">
                        <VBox spacing="10" style="-fx-padding: 10;" alignment="CENTER">
                            <TableView fx:id="notificationsTable" prefHeight="400" maxWidth="Infinity">
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                </columnResizePolicy>
                                <columns>
                                    <TableColumn fx:id="notifMessageColumn" text="Message" prefWidth="300"/>
                                    <TableColumn fx:id="notifTypeColumn" text="Type" prefWidth="130"/>
                                    <TableColumn fx:id="notifCreatedAtColumn" text="Date" prefWidth="160"/>
                                    <TableColumn fx:id="notifStatusColumn" text="Status" prefWidth="100"/>
                                </columns>
                                <placeholder>
                                    <Label text="No notifications found" styleClass="status-text"/>
                                </placeholder>
                            </TableView>
                            <HBox spacing="10" alignment="CENTER">
                                <Label fx:id="notificationCountLabel" styleClass="status-text"/>
                                <Pagination fx:id="notificationsPagination" pageCount="1" maxPageIndicatorCount="5"/>
                            </HBox>
                        </VBox>
                    </Tab>

                </TabPane>

                <Label fx:id="statusLabel" styleClass="status-text" alignment="CENTER" maxWidth="Infinity"/>

                <HBox alignment="CENTER">
                    <Button fx:id="backButton" text="Back to Dashboard" styleClass="button-secondary" prefWidth="150"/>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <fx:include source="FooterComponent.fxml"/>
    </bottom>
</BorderPane>