<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.CustomerController"
            stylesheets="@../css/application.css" styleClass="border-pane">

    <top>
        <fx:include source="MenuBarComponent.fxml"/>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="false" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
            <VBox spacing="20" alignment="TOP_CENTER" styleClass="dashboard-container">
                <padding>
                    <Insets top="25" right="40" bottom="30" left="40"/>
                </padding>

                <Label fx:id="welcomeLabel" styleClass="label-title" alignment="CENTER" maxWidth="Infinity"/>
                <Label text="Customer Dashboard" styleClass="label-subtitle" alignment="CENTER" maxWidth="Infinity"/>

                <Separator/>

                <ProgressIndicator fx:id="loadProgress" visible="false" maxWidth="40"/>

                <!-- Stats Cards Row - Using FlowPane for wrapping -->
                <FlowPane hgap="15" vgap="15" alignment="CENTER">
                    <VBox styleClass="dashboard-card" alignment="CENTER" minWidth="160" prefWidth="180">
                        <Label text="My Vehicles" styleClass="card-title"/>
                        <Label fx:id="vehiclesCountLabel" text="0" styleClass="card-value"/>
                    </VBox>

                    <VBox styleClass="dashboard-card" alignment="CENTER" minWidth="160" prefWidth="180">
                        <Label text="Active Queries" styleClass="card-title"/>
                        <Label fx:id="activeQueriesLabel" text="0" styleClass="card-value"/>
                    </VBox>

                    <VBox styleClass="dashboard-card" alignment="CENTER" minWidth="160" prefWidth="180">
                        <Label text="Pending Complaints" styleClass="card-title"/>
                        <Label fx:id="pendingComplaintsLabel" text="0" styleClass="card-value"/>
                    </VBox>

                    <VBox styleClass="dashboard-card" alignment="CENTER" minWidth="160" prefWidth="180">
                        <Label text="Wallet Balance" styleClass="card-title"/>
                        <Label fx:id="walletBalanceLabel" text="M0.00" styleClass="card-value"/>
                    </VBox>

                    <VBox styleClass="dashboard-card" alignment="CENTER" minWidth="160" prefWidth="180">
                        <Label text="Unread Notifications" styleClass="card-title"/>
                        <Label fx:id="unreadNotificationsLabel" text="0" styleClass="card-value"/>
                    </VBox>

                    <VBox styleClass="dashboard-card" alignment="CENTER" minWidth="160" prefWidth="180">
                        <Label text="Reviews Written" styleClass="card-title"/>
                        <Label fx:id="reviewsCountLabel" text="0" styleClass="card-value"/>
                    </VBox>
                </FlowPane>

                <Separator/>

                <ProgressBar fx:id="operationProgress" prefWidth="Infinity" progress="0" visible="false"/>

                <!-- Recent Vehicles Table -->
                <TitledPane text="Recent Vehicles" expanded="true">
                    <VBox spacing="10" style="-fx-padding: 10;">
                        <TableView fx:id="recentVehiclesTable" prefHeight="200" maxWidth="Infinity">
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                            <columns>
                                <TableColumn text="Registration" prefWidth="120"/>
                                <TableColumn text="Make" prefWidth="90"/>
                                <TableColumn text="Model" prefWidth="90"/>
                                <TableColumn text="Year" prefWidth="70"/>
                                <TableColumn text="Status" prefWidth="100"/>
                            </columns>
                            <placeholder>
                                <Label text="No vehicles found" styleClass="status-text"/>
                            </placeholder>
                        </TableView>
                        <HBox alignment="CENTER">
                            <Pagination fx:id="vehiclesPagination" pageCount="1" maxPageIndicatorCount="5"/>
                        </HBox>
                    </VBox>
                </TitledPane>

                <!-- Recent Notifications Table -->
                <TitledPane text="Recent Notifications" expanded="true">
                    <VBox spacing="10" style="-fx-padding: 10;">
                        <TableView fx:id="recentNotificationsTable" prefHeight="200" maxWidth="Infinity">
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                            <columns>
                                <TableColumn text="Message" prefWidth="280"/>
                                <TableColumn text="Type" prefWidth="90"/>
                                <TableColumn text="Date" prefWidth="140"/>
                                <TableColumn text="Status" prefWidth="80"/>
                            </columns>
                            <placeholder>
                                <Label text="No notifications found" styleClass="status-text"/>
                            </placeholder>
                        </TableView>
                        <HBox alignment="CENTER">
                            <Pagination fx:id="notificationsPagination" pageCount="1" maxPageIndicatorCount="5"/>
                        </HBox>
                    </VBox>
                </TitledPane>

                <Label fx:id="statusLabel" styleClass="status-text" alignment="CENTER" maxWidth="Infinity"/>

            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <fx:include source="FooterComponent.fxml"/>
    </bottom>
</BorderPane>