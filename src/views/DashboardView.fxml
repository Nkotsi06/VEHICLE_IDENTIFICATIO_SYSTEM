<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.DashboardController"
            stylesheets="@../css/application.css" styleClass="border-pane">

    <top>
        <fx:include source="MenuBarComponent.fxml"/>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="false" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    style="-fx-background-color: #f0f2f5; -fx-background: #f0f2f5;">
            <VBox spacing="20" alignment="TOP_CENTER"
                  style="-fx-background-color: #f0f2f5; -fx-padding: 25 40 30 40;">

                <Label fx:id="welcomeLabel" styleClass="label-title" alignment="CENTER" maxWidth="Infinity"/>
                <Label fx:id="roleLabel" styleClass="label-subtitle" alignment="CENTER" maxWidth="Infinity"/>
                <Label fx:id="dateLabel" styleClass="status-text" alignment="CENTER" maxWidth="Infinity"/>

                <Separator/>

                <Label text="System Overview" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" alignment="CENTER" maxWidth="Infinity"/>

                <FlowPane fx:id="statsContainer" hgap="15" vgap="15" alignment="CENTER"/>

            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <fx:include source="FooterComponent.fxml"/>
    </bottom>

</BorderPane>