<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.IncidentReportController"
            stylesheets="@../css/application.css" styleClass="border-pane">

    <top>
        <fx:include source="MenuBarComponent.fxml"/>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="false" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
            <VBox spacing="20" alignment="TOP_CENTER" styleClass="dashboard-container">
                <padding>
                    <Insets top="25" right="40" bottom="30" left="40"/>
                </padding>

                <Label text="Incident Reports" styleClass="label-title" alignment="CENTER" maxWidth="Infinity"/>
                <Label text="Create and manage police incident reports" styleClass="label-subtitle" alignment="CENTER" maxWidth="Infinity"/>

                <Separator/>

                <HBox spacing="25" alignment="CENTER" fillHeight="true">
                    <!-- Left Panel - Incident Reports List -->
                    <VBox spacing="15" alignment="CENTER" HBox.hgrow="ALWAYS" prefWidth="600">
                        <VBox styleClass="profile-edit-card" alignment="CENTER" prefWidth="600">
                            <Label text="Incident Reports" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>

                            <ProgressIndicator fx:id="loadProgress" visible="false" maxWidth="30"/>

                            <TableView fx:id="reportsTable" prefHeight="450" maxWidth="Infinity">
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                </columnResizePolicy>
                                <columns>
                                    <TableColumn fx:id="caseNumberColumn" text="Case Number" prefWidth="140"/>
                                    <TableColumn fx:id="vehicleColumn" text="Vehicle" prefWidth="120"/>
                                    <TableColumn fx:id="reportTypeColumn" text="Type" prefWidth="100"/>
                                    <TableColumn fx:id="reportDateColumn" text="Date" prefWidth="100"/>
                                    <TableColumn fx:id="officerColumn" text="Officer" prefWidth="130"/>
                                    <TableColumn fx:id="incidentStatusColumn" text="Status" prefWidth="100"/>
                                </columns>
                                <placeholder>
                                    <Label text="No incident reports" styleClass="status-text"/>
                                </placeholder>
                            </TableView>

                            <HBox alignment="CENTER">
                                <Pagination fx:id="reportsPagination" pageCount="1" maxPageIndicatorCount="5"/>
                            </HBox>

                            <ProgressBar fx:id="operationProgress" prefWidth="Infinity" progress="0" visible="false"/>

                            <HBox alignment="CENTER" spacing="15">
                                <Button fx:id="refreshButton" text="Refresh" styleClass="button-info" prefWidth="100"/>
                                <Button fx:id="fadeButton" text="Animate" styleClass="button-warning" prefWidth="100"/>
                            </HBox>
                        </VBox>
                    </VBox>

                    <!-- Right Panel - Create/Edit Incident Report -->
                    <VBox spacing="15" alignment="CENTER" HBox.hgrow="ALWAYS" prefWidth="450">
                        <VBox styleClass="profile-edit-card" alignment="CENTER" prefWidth="450">
                            <Label text="Create Incident Report" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>

                            <GridPane hgap="15" vgap="12" alignment="CENTER">
                                <columnConstraints>
                                    <ColumnConstraints halignment="RIGHT" minWidth="100" prefWidth="100"/>
                                    <ColumnConstraints minWidth="250" hgrow="ALWAYS"/>
                                </columnConstraints>

                                <Label text="Vehicle:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <ComboBox fx:id="vehicleComboBox" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="280" promptText="Select vehicle"/>

                                <Label text="Report Type:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <ComboBox fx:id="reportTypeComboBox" GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="200" promptText="Select type"/>

                                <Label text="Case Number:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <TextField fx:id="caseNumberField" GridPane.rowIndex="2" GridPane.columnIndex="1" promptText="Enter case number"/>

                                <Label text="Report Date:" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <DatePicker fx:id="reportDatePicker" GridPane.rowIndex="3" GridPane.columnIndex="1" prefWidth="200"/>

                                <Label text="Location:" GridPane.rowIndex="4" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <TextField fx:id="locationField" GridPane.rowIndex="4" GridPane.columnIndex="1" promptText="Enter location"/>

                                <Label text="Status:" GridPane.rowIndex="5" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                <ComboBox fx:id="statusComboBox" GridPane.rowIndex="5" GridPane.columnIndex="1" prefWidth="200"/>
                            </GridPane>

                            <Label text="Description:" style="-fx-font-weight: bold;" alignment="CENTER" maxWidth="Infinity"/>
                            <TextArea fx:id="descriptionArea" prefHeight="100" promptText="Enter incident description..."/>

                            <Label text="Witnesses:" style="-fx-font-weight: bold;" alignment="CENTER" maxWidth="Infinity"/>
                            <TextArea fx:id="witnessesArea" prefHeight="60" promptText="Enter witness information..."/>

                            <HBox alignment="CENTER" spacing="15">
                                <Button fx:id="createButton" text="Create Report" styleClass="button-success" prefWidth="110"/>
                                <Button fx:id="updateButton" text="Update" styleClass="button-info" prefWidth="90"/>
                                <Button fx:id="deleteButton" text="Delete" styleClass="button-danger" prefWidth="90"/>
                                <Button fx:id="clearButton" text="Clear" styleClass="button-secondary" prefWidth="90"/>
                            </HBox>

                            <Label fx:id="statusLabel" styleClass="status-text" alignment="CENTER" maxWidth="Infinity"/>
                        </VBox>
                    </VBox>
                </HBox>

                <HBox alignment="CENTER">
                    <Button fx:id="backButton" text="Back to Dashboard" styleClass="button-secondary" prefWidth="150"/>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <fx:include source="FooterComponent.fxml"/>
    </bottom>
</BorderPane>