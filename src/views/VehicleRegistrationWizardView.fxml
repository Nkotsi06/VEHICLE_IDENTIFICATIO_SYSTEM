<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.VehicleRegistrationWizardController"
            stylesheets="@../css/application.css" styleClass="border-pane">

    <top>
        <fx:include source="MenuBarComponent.fxml"/>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="false" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
            <VBox spacing="20" alignment="TOP_CENTER" styleClass="dashboard-container">
                <padding>
                    <Insets top="25" right="40" bottom="30" left="40"/>
                </padding>

                <Label text="Vehicle Registration Wizard" styleClass="label-title" alignment="CENTER" maxWidth="Infinity"/>
                <Label text="Step-by-step vehicle registration process" styleClass="label-subtitle" alignment="CENTER" maxWidth="Infinity"/>

                <Separator/>

                <ProgressIndicator fx:id="loadProgress" visible="false" maxWidth="40"/>

                <!-- Step Progress Indicators -->
                <HBox alignment="CENTER">
                    <VBox maxWidth="1000" styleClass="profile-card" alignment="CENTER" spacing="15">
                        <HBox spacing="25" alignment="CENTER">
                            <HBox spacing="8" alignment="CENTER">
                                <Label text="Step 1:" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                                <Label fx:id="step1Status" text="Pending" style="-fx-text-fill: #7f8c8d;"/>
                            </HBox>
                            <Label text="→" style="-fx-font-size: 18px;"/>
                            <HBox spacing="8" alignment="CENTER">
                                <Label text="Step 2:" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                                <Label fx:id="step2Status" text="Pending" style="-fx-text-fill: #7f8c8d;"/>
                            </HBox>
                            <Label text="→" style="-fx-font-size: 18px;"/>
                            <HBox spacing="8" alignment="CENTER">
                                <Label text="Step 3:" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                                <Label fx:id="step3Status" text="Pending" style="-fx-text-fill: #7f8c8d;"/>
                            </HBox>
                            <Label text="→" style="-fx-font-size: 18px;"/>
                            <HBox spacing="8" alignment="CENTER">
                                <Label text="Step 4:" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                                <Label fx:id="step4Status" text="Pending" style="-fx-text-fill: #7f8c8d;"/>
                            </HBox>
                        </HBox>
                    </VBox>
                </HBox>

                <ProgressBar fx:id="stepProgress" prefWidth="Infinity" progress="0.25"/>

                <!-- Step 1: Vehicle Information -->
                <HBox alignment="CENTER">
                    <VBox fx:id="step1Box" spacing="15" styleClass="profile-edit-card" maxWidth="900" alignment="CENTER">
                        <Label text="Step 1: Vehicle Information" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>
                        <Separator/>
                        <GridPane hgap="15" vgap="12" alignment="CENTER">
                            <columnConstraints>
                                <ColumnConstraints halignment="RIGHT" minWidth="120" prefWidth="120"/>
                                <ColumnConstraints minWidth="250" hgrow="ALWAYS"/>
                            </columnConstraints>

                            <Label text="Registration Number:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <TextField fx:id="registrationNumberField" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="250"/>

                            <Label text="Make:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <TextField fx:id="makeField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                            <Label text="Model:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <TextField fx:id="modelField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                            <Label text="Year:" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <TextField fx:id="yearField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                            <Label text="Color:" GridPane.rowIndex="4" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <TextField fx:id="colorField" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                            <Label text="Engine Number:" GridPane.rowIndex="5" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <TextField fx:id="engineNumberField" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                            <Label text="Chassis Number:" GridPane.rowIndex="6" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <TextField fx:id="chassisNumberField" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

                            <Label text="Owner:" GridPane.rowIndex="7" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <ComboBox fx:id="ownerComboBox" GridPane.rowIndex="7" GridPane.columnIndex="1" prefWidth="250"/>
                        </GridPane>
                        <HBox alignment="CENTER_RIGHT">
                            <Button fx:id="next1Button" text="Next →" styleClass="button-primary" prefWidth="100"/>
                        </HBox>
                    </VBox>
                </HBox>

                <!-- Step 2: Additional Information -->
                <HBox alignment="CENTER">
                    <VBox fx:id="step2Box" spacing="15" styleClass="profile-edit-card" maxWidth="900" alignment="CENTER" visible="false">
                        <Label text="Step 2: Additional Information" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>
                        <Separator/>
                        <Label text="Optional: Add vehicle photos and additional details" styleClass="status-text" alignment="CENTER" maxWidth="Infinity"/>

                        <GridPane hgap="15" vgap="12" alignment="CENTER">
                            <columnConstraints>
                                <ColumnConstraints halignment="RIGHT" minWidth="120" prefWidth="120"/>
                                <ColumnConstraints minWidth="250" hgrow="ALWAYS"/>
                            </columnConstraints>

                            <Label text="Vehicle Condition:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <ComboBox fx:id="conditionComboBox" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="200"/>

                            <Label text="Purchase Date:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <DatePicker fx:id="purchaseDatePicker" GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="200"/>

                            <Label text="Additional Notes:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <TextArea fx:id="notesArea" GridPane.rowIndex="2" GridPane.columnIndex="1" prefHeight="80"/>
                        </GridPane>
                        <HBox alignment="CENTER">
                            <Button fx:id="back2Button" text="← Back" styleClass="button-secondary" prefWidth="90"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button fx:id="next2Button" text="Next →" styleClass="button-primary" prefWidth="90"/>
                        </HBox>
                    </VBox>
                </HBox>

                <!-- Step 3: Document Information -->
                <HBox alignment="CENTER">
                    <VBox fx:id="step3Box" spacing="15" styleClass="profile-edit-card" maxWidth="900" alignment="CENTER" visible="false">
                        <Label text="Step 3: Document Information" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>
                        <Separator/>

                        <GridPane hgap="15" vgap="12" alignment="CENTER">
                            <columnConstraints>
                                <ColumnConstraints halignment="RIGHT" minWidth="120" prefWidth="120"/>
                                <ColumnConstraints minWidth="250" hgrow="ALWAYS"/>
                            </columnConstraints>

                            <Label text="Document Type:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <ComboBox fx:id="documentTypeComboBox" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="200"/>

                            <Label text="Document Number:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <TextField fx:id="documentNumberField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                            <Label text="Issue Date:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <DatePicker fx:id="issueDatePicker" GridPane.rowIndex="2" GridPane.columnIndex="1" prefWidth="200"/>

                            <Label text="Expiry Date:" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                            <DatePicker fx:id="expiryDatePicker" GridPane.rowIndex="3" GridPane.columnIndex="1" prefWidth="200"/>
                        </GridPane>
                        <HBox alignment="CENTER">
                            <Button fx:id="back3Button" text="← Back" styleClass="button-secondary" prefWidth="90"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button fx:id="next3Button" text="Next →" styleClass="button-primary" prefWidth="90"/>
                        </HBox>
                    </VBox>
                </HBox>

                <!-- Step 4: Review and Submit -->
                <HBox alignment="CENTER">
                    <VBox fx:id="step4Box" spacing="15" styleClass="profile-edit-card" maxWidth="900" alignment="CENTER" visible="false">
                        <Label text="Step 4: Review and Submit" styleClass="section-title" alignment="CENTER" maxWidth="Infinity"/>
                        <Separator/>
                        <Label text="Please review all information before submitting." styleClass="status-text" alignment="CENTER" maxWidth="Infinity"/>

                        <TitledPane text="Vehicle Details" expanded="true">
                            <GridPane hgap="15" vgap="8" alignment="CENTER">
                                <columnConstraints>
                                    <ColumnConstraints halignment="RIGHT" minWidth="120" prefWidth="120"/>
                                    <ColumnConstraints minWidth="200" hgrow="ALWAYS"/>
                                    <ColumnConstraints halignment="RIGHT" minWidth="120" prefWidth="120"/>
                                    <ColumnConstraints minWidth="200" hgrow="ALWAYS"/>
                                </columnConstraints>

                                <Label text="Registration:" style="-fx-font-weight: bold;" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                <Label fx:id="reviewRegLabel" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                                <Label text="Make/Model:" style="-fx-font-weight: bold;" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                                <Label fx:id="reviewMakeModelLabel" GridPane.rowIndex="0" GridPane.columnIndex="3"/>
                                <Label text="Year/Color:" style="-fx-font-weight: bold;" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                <Label fx:id="reviewYearColorLabel" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                                <Label text="Engine/Chassis:" style="-fx-font-weight: bold;" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                                <Label fx:id="reviewEngineChassisLabel" GridPane.rowIndex="1" GridPane.columnIndex="3"/>
                            </GridPane>
                        </TitledPane>

                        <ProgressBar fx:id="operationProgress" prefWidth="Infinity" progress="0" visible="false"/>

                        <HBox alignment="CENTER" spacing="15">
                            <Button fx:id="back4Button" text="← Back" styleClass="button-secondary" prefWidth="90"/>
                            <Button fx:id="submitButton" text="Submit Registration" styleClass="button-success" prefWidth="180"/>
                            <Button fx:id="cancelButton" text="Cancel" styleClass="button-secondary" prefWidth="90"/>
                        </HBox>
                    </VBox>
                </HBox>

                <Label fx:id="statusLabel" styleClass="status-text" alignment="CENTER" maxWidth="Infinity"/>

            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <fx:include source="FooterComponent.fxml"/>
    </bottom>
</BorderPane>