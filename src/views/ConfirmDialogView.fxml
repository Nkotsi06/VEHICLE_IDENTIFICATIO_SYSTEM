<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ConfirmDialogController"
      spacing="15" alignment="CENTER"
      style="-fx-background-color: #2d2d2d; -fx-border-color: #4a4a4a; -fx-border-radius: 8; -fx-background-radius: 8;">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label fx:id="titleLabel" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;" alignment="CENTER" maxWidth="Infinity"/>
    <Separator/>
    <Label fx:id="messageLabel" style="-fx-text-fill: #cccccc; -fx-wrap-text: true;" alignment="CENTER" maxWidth="Infinity"/>

    <HBox spacing="10" alignment="CENTER">
        <Button fx:id="confirmButton" text="Confirm" styleClass="button-success"/>
        <Button fx:id="cancelButton" text="Cancel" styleClass="button-secondary"/>
    </HBox>
</VBox>